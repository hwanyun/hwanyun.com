---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"

const sounds = (await getCollection("sounds", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
)
/* 섹션 셋으로 나눠 놨더니 4 / 1 / 12가 되었다. 회원이 하나뿐인 분류와
   전체의 70%를 담은 분류는 둘 다 분류가 아니다. 목록은 하나로 펴고
   성격은 필터로 고르게 한다 — Works 페이지의 재료 필터와 같은 어휘다. */
const FILTERS = [
  { id: "works", en: "Work soundtracks", ko: "작품 사운드" },
  { id: "scores", en: "Commissions", ko: "커미션" },
  { id: "archive", en: "Independent recordings", ko: "독립 녹음" },
]

// 같은 project를 가진 트랙들을 한 릴리스로 묶는다 (DOM 순서 = sounds 정렬 순서)
const key = (s: (typeof sounds)[number]) => s.data.project || s.data.title
const releases = Array.from(new Map(sounds.map((s) => [key(s), s])).values()).map((lead) => {
  const tracks = sounds.filter((s) => key(s) === key(lead))
  const secs = tracks.map((t) => t.data.duration).filter((d) => d > 0)
  return {
    title: key(lead),
    section: lead.data.section,
    tracks,
    // 버전이 여러 개면 합계가 아니라 범위를 보여 준다. 셋 중 하나만 듣는 것이라
    // 합계는 없는 시간을 요구하는 것처럼 읽힌다.
    min: secs.length ? Math.min(...secs) : 0,
    max: secs.length ? Math.max(...secs) : 0,
  }
})

const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`
const span = (r: { min: number; max: number }) =>
  !r.max ? "" : r.min === r.max ? clock(r.max) : `${clock(r.min)} – ${clock(r.max)}`

const counts = FILTERS.map((f) => ({ ...f, n: releases.filter((r) => r.section === f.id).length })).filter((f) => f.n > 0)
---

<Base title="HWANYUN — Sound" current="sound">
  <video id="listening-backdrop" muted loop playsinline aria-hidden="true"></video>
  <div id="backdrop-title" aria-live="polite"></div>
  <main id="sound-archive">
    <header class="archive-head">
      <p class="eyebrow">LISTENING ARCHIVE</p>
      <h1>Sound</h1>
      <div class="intro-copy">
        <p class="intro" data-language-content="en" lang="en">A selection of sound works, scores, and recordings. Each entry remains connected to the circumstance in which it was made.</p>
        <p class="intro" data-language-content="ko" lang="ko">사운드 작업, 스코어, 그리고 기록을 모은 아카이브. 각각의 기록은 작업이 만들어진 장소와 시간, 관계의 맥락을 함께 간직한다.</p>
      </div>
    </header>

    <nav class="sound-filter" aria-label="Filter recordings">
      <a href="/sound/" data-kind="">
        <span data-language-content="en">All</span><span data-language-content="ko">전체</span>
        <span class="sf-n">{releases.length}</span>
      </a>
      {counts.map((f) => (
        <a href={`/sound/?kind=${f.id}`} data-kind={f.id}>
          <span data-language-content="en">{f.en}</span><span data-language-content="ko">{f.ko}</span>
          <span class="sf-n">{f.n}</span>
        </a>
      ))}
    </nav>

    <div class="list-head" aria-hidden="true">
      <span data-language-content="en">RECORDING</span><span data-language-content="ko">녹음</span>
      <span class="lh-len">
        <span data-language-content="en">LENGTH</span><span data-language-content="ko">길이</span>
      </span>
    </div>

    <ol class="release-list" id="release-list">
      {releases.map((release) => (
        <li class="release" data-kind={release.section}>
          <details>
            <summary>
              <strong>{release.title}</strong>
              {/* 배지가 있는 행과 없는 행에서 길이 열이 어긋나지 않게 한 칸에 묶는다.
                  영상 여부는 표시하지 않는다 — 19개 중 2개를 위해 모든 행이 열을
                  하나 유지할 이유가 없고, 재생하면 화면이 바뀌어 스스로 드러난다. */}
              <span class="rel-tags">
                {release.tracks.length > 1 && (
                  <span class="release-count">{release.tracks.length} versions</span>
                )}
              </span>
              {/* 16초와 20분이 같은 줄로 보이면 무엇을 여는 건지 알 수 없다 */}
              <span class="release-len">{span(release)}</span>
              <span class="expand" aria-hidden="true">+</span>
            </summary>
            <ol class="tracklist">
              {release.tracks.map((sound) => (
                <li id={`sound-${sound.slug}`} class="track" data-title={sound.data.title}>
                  <span>{sound.data.title}</span>
                  <span class="track-meta">
                    {sound.data.duration > 0 && <span class="track-len">{clock(sound.data.duration)}</span>}
                  </span>
                  {sound.data.audio && <button class="track-control" type="button" data-audio={sound.data.audio} data-backdrop={sound.data.backdrop} data-backdrop-sm={sound.data.backdropMobile} aria-label={`${sound.data.title} 재생`}><span aria-hidden="true"></span></button>}
                </li>
              ))}
            </ol>
          </details>
        </li>
      ))}
    </ol>
    <p class="sf-empty" id="sf-empty" hidden>No recordings of this kind.</p>
  </main>

  <script is:inline>
    /* 정적 사이트라 쿼리 파라미터는 브라우저에서 해석한다.
       Works 아카이브의 재료 필터와 같은 동작 — 이동 없이 상태만 바꾼다. */
    ;(function () {
      var list = document.getElementById("release-list")
      var nav = document.querySelector(".sound-filter")
      var empty = document.getElementById("sf-empty")
      if (!list || !nav) return
      var items = Array.prototype.slice.call(list.querySelectorAll(".release"))
      var links = Array.prototype.slice.call(nav.querySelectorAll("a"))

      function apply(kind) {
        var shown = 0
        items.forEach(function (li) {
          var hit = !kind || li.getAttribute("data-kind") === kind
          li.hidden = !hit
          if (hit) shown++
          // 걸러진 항목이 펼쳐진 채로 숨으면 다시 보일 때 열려 있다
          if (!hit) { var d = li.querySelector("details"); if (d) d.open = false }
        })
        links.forEach(function (a) {
          a.setAttribute("aria-current", (a.getAttribute("data-kind") || "") === kind ? "true" : "false")
        })
        if (empty) empty.hidden = shown !== 0
      }

      function fromURL() {
        return new URLSearchParams(window.location.search).get("kind") || ""
      }
      apply(fromURL())

      links.forEach(function (a) {
        a.addEventListener("click", function (e) {
          e.preventDefault()
          var k = a.getAttribute("data-kind") || ""
          history.pushState({ kind: k }, "", k ? "/sound/?kind=" + k : "/sound/")
          apply(k)
        })
      })
      window.addEventListener("popstate", function () { apply(fromURL()) })
    })()
  </script>

  <audio id="archive-player" preload="metadata"></audio>
  <div id="player-bar" hidden>
    <div class="player-track"><span class="now-playing"></span><span class="player-time">0:00 / 0:00</span></div>
    <div class="player-actions">
      <button type="button" class="pause" aria-label="일시정지"><span aria-hidden="true"></span></button>
      <button type="button" class="stop" aria-label="정지"><span aria-hidden="true"></span></button>
    </div>
    <div class="progress" role="progressbar" aria-label="재생 진행" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
  </div>

  <script is:inline>
    const player = document.getElementById("archive-player")
    const bar = document.getElementById("player-bar")
    const now = bar.querySelector(".now-playing")
    const time = bar.querySelector(".player-time")
    const progress = bar.querySelector(".progress")
    const progressFill = progress.querySelector("span")
    const pause = bar.querySelector(".pause")
    const stop = bar.querySelector(".stop")
    const backdrop = document.getElementById("listening-backdrop")
    const backdropTitle = document.getElementById("backdrop-title")
    let activeButton = null
    const formatTime = (value) => {
      if (!Number.isFinite(value)) return "0:00"
      return Math.floor(value / 60) + ":" + String(Math.floor(value % 60)).padStart(2, "0")
    }
    const setButton = (button, state) => {
      if (!button) return
      const row = button.closest(".track")
      row.classList.toggle("is-playing", state === "playing")
      row.classList.toggle("is-paused", state === "paused")
      button.setAttribute("aria-label", row.dataset.title + (state === "playing" ? " 일시정지" : " 재생"))
    }
    const resetActive = () => { setButton(activeButton, "stopped"); activeButton = null }
    const clearBackdrop = () => { backdrop.pause(); backdrop.removeAttribute("src"); backdropTitle.textContent = ""; document.body.classList.remove("has-backdrop") }
    /* 무제의 두 화면(바닥 원형·벽면 파노라마)은 사운드와 같은 3분을 지난다.
       영상을 제 클럭으로 흘려보내면 몇 초 만에 어긋나므로 오디오를 기준 시계로 삼는다. */
    const followAudio = () => {
      if (!backdrop.src || backdrop.readyState < 1) return
      if (Math.abs(backdrop.currentTime - player.currentTime) > 0.25) backdrop.currentTime = player.currentTime
    }
    /* 백드롭은 언제나 화면을 가득 채운다(CSS의 object-fit: cover).
       한때 파노라마(4.8:1)만 contain으로 온전히 보여 줬는데 — 확대율이
       커 뭉개지는 것을 피하려 한 것이었다 — 띠 하나가 떠 있는 모양이라
       '듣는 화면'이 되지 못했다. 전부 보여 주는 것보다 화면이 차는 편이
       낫다. 어차피 brightness(.42)로 눌린 배경이라 확대는 잘 드러나지 않는다. */
    document.querySelectorAll(".track-control[data-audio]").forEach((button) => button.addEventListener("click", () => {
      if (activeButton === button) {
        if (player.paused) player.play(); else player.pause()
        return
      }
      resetActive()
      activeButton = button
      player.src = button.dataset.audio
      clearBackdrop()
      if (button.dataset.backdrop) {
        /* 백드롭은 전체화면이라 폰에서 가장 무겁다. 좁은 화면에는 경량본이
           있으면 그쪽을 쓴다 — 표시 폭이 작아 해상도 차이는 보이지 않는다. */
        var narrow = window.matchMedia("(max-width: 700px)").matches
        backdrop.src = (narrow && button.dataset.backdropSm) || button.dataset.backdrop
        backdrop.currentTime = 0
        backdrop.play().catch(() => {})
        backdropTitle.textContent = button.closest(".track").dataset.title
        document.body.classList.add("has-backdrop")
      }
      player.play()
      now.textContent = button.closest(".track").dataset.title
      bar.hidden = false
    }))
    pause.addEventListener("click", () => player.paused ? player.play() : player.pause())
    stop.addEventListener("click", () => { player.pause(); player.currentTime = 0; resetActive(); clearBackdrop(); bar.hidden = true })
    player.addEventListener("loadedmetadata", () => time.textContent = formatTime(player.currentTime) + " / " + formatTime(player.duration))
    player.addEventListener("timeupdate", () => {
      const ratio = player.duration ? player.currentTime / player.duration : 0
      progressFill.style.width = (ratio * 100) + "%"
      progress.setAttribute("aria-valuenow", String(Math.round(ratio * 100)))
      time.textContent = formatTime(player.currentTime) + " / " + formatTime(player.duration)
      followAudio()
    })
    player.addEventListener("play", () => { setButton(activeButton, "playing"); pause.classList.add("is-playing"); pause.setAttribute("aria-label", "일시정지"); if (backdrop.src) backdrop.play().catch(() => {}) })
    player.addEventListener("pause", () => { if (player.currentTime) setButton(activeButton, "paused"); pause.classList.remove("is-playing"); pause.setAttribute("aria-label", "재생"); backdrop.pause() })
    player.addEventListener("seeked", followAudio)
    player.addEventListener("ended", () => { resetActive(); clearBackdrop(); pause.classList.remove("is-playing"); progressFill.style.width = "0%" })
    if (location.hash) {
      const target = document.querySelector(location.hash)
      if (target) {
        const release = target.closest("details")
        if (release) release.open = true
        target.scrollIntoView({ block: "center" })
      }
    }
  </script>

  <script is:inline>
    </script>

  <style>
    #listening-backdrop { position: fixed; z-index: 0; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; pointer-events: none; filter: brightness(.42) saturate(.75); transition: opacity var(--dur-slow) ease; }
    :global(body.has-backdrop) #listening-backdrop { opacity: 1; }
    #backdrop-title { position: fixed; z-index: 2; left: 50%; top: 50%; width: min(88vw, 780px); transform: translate(-50%, -50%); color: var(--surface); font-size: clamp(24px, 4vw, 52px); font-weight: 300; line-height: 1.12; text-align: center; text-shadow: 0 2px 20px rgba(0,0,0,.45); opacity: 0; pointer-events: none; transition: opacity var(--dur-slow) ease; }
    :global(body.has-backdrop) #backdrop-title { opacity: 1; }
    #sound-archive { position: relative; z-index: 1; max-width: var(--content-w); margin: var(--desktop-header-clearance) 40px 100px var(--desktop-content-x); transition: color var(--dur-slow) ease; }
    /* Works archive의 소개 블록과 같은 데스크톱 읽기 규격 */
    .archive-head { max-width: 650px; margin-bottom: 84px; }
    .eyebrow, .release-count { font-size: var(--fs-2xs); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
    h1 { margin: 8px 0 16px; font-weight: 300; font-size: var(--fs-display); line-height: 1.15; }
    /* 한 번에 한 언어만 보이므로 단을 나누지 않는다 */
    .intro-copy { display: block; }
    .intro { margin: 0; padding-top: 12px; border-top: 1px solid var(--text); font-size: var(--fs-body); line-height: 1.8; color: var(--text-2); }
    .intro[lang="ko"] { line-height: 1.85; }
    /* 필터 알약 — Works 아카이브와 같은 규칙. 사이트 안에서 "고르는 일"은
       어디서나 같은 모양이어야 한다. */
    .sound-filter { display: flex; flex-wrap: wrap; gap: 6px 8px; margin: 0 0 22px; }
    .sound-filter a {
      /* 칩은 도구 — 콘텐츠보다 조용하게, works 필터와 같은 13 */
      font-size: var(--fs-xs); line-height: 1; padding: 6px 11px;
      border: 1px solid var(--line-2); border-radius: 999px; color: var(--text-2);
      transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease, background var(--dur-fast) ease;
    }
    .sound-filter a:hover { border-color: var(--hover); color: var(--hover); }
    .sound-filter a[aria-current="true"] { border-color: var(--text); background: var(--text); color: var(--surface); }
    .sf-n { color: var(--text-4); margin-left: 3px; }
    .sound-filter a[aria-current="true"] .sf-n { color: var(--line-2); }
    .sf-empty { font-size: var(--fs-sm); color: var(--text-4); padding: 24px 2px; }

    /* 목록 머리 — 오른쪽 숫자가 무엇인지 한 번은 말해 줘야 한다 */
    .list-head {
      display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 12px;
      border-top: 1px solid var(--text); border-bottom: 1px solid var(--text);
      padding: 5px 0 4px; font-size: var(--fs-2xs); letter-spacing: .08em; color: var(--text-3);
    }
    .list-head .lh-len { text-align: right; padding-right: 36px; }

    .release-list, .tracklist { list-style: none; padding: 0; margin: 0; }
    .release { border-bottom: 1px solid var(--line); }
    .release[hidden] { display: none; }
    /* 길이 칸은 고정 폭이어야 한다. auto로 두면 "3:01"과 "2:10 – 4:56"이
       각자 다른 자리에 서서 숫자 열이 흔들리고, 머리글과도 어긋난다. */
    summary { display: grid; grid-template-columns: minmax(0,1fr) auto 104px 24px; gap: 12px; align-items: baseline; padding: 16px 0; cursor: pointer; list-style: none; }
    .rel-tags { display: flex; align-items: baseline; justify-content: flex-end; gap: 14px; }
    .release-len { text-align: right; font-size: var(--fs-sm); color: var(--text-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .track-len { font-size: var(--fs-xs); color: var(--text-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
    summary::-webkit-details-marker { display: none; }
    summary strong { font-weight: 400; }
    .expand { text-align: right; font-size: var(--fs-lead); font-weight: 300; line-height: .7; }
    details[open] .expand { transform: rotate(45deg); }
    .tracklist { padding: 0 36px 14px 64px; }
    .track { display: grid; grid-template-columns: minmax(0,1fr) minmax(130px, 220px) 26px; gap: 14px; align-items: center; padding: 7px 0; font-size: var(--fs-sm); color: var(--text-3); }
    .track-meta { display: flex; justify-content: flex-end; align-items: center; gap: 12px; min-width: 0; }
    .track.is-playing { color: var(--text); }
    .track-control, .player-actions button { display: grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; background: transparent; color: currentColor; cursor: pointer; }
    .track-control { width: 22px; height: 22px; padding: 0; }
    .track-control span, .pause span { display: block; width: 0; height: 0; border-top: 5px solid transparent; border-bottom: 5px solid transparent; border-left: 7px solid currentColor; margin-left: 2px; }
    .track.is-playing .track-control span, .pause.is-playing span { width: 7px; height: 9px; border: 0; border-left: 2px solid currentColor; border-right: 2px solid currentColor; margin-left: 0; }
    .track-control:hover { color: var(--hover); }
    /* display를 지정한 요소에는 [hidden]이 먹지 않는다. 이걸 빠뜨려서
       재생 전에도 검은 바가 화면 하단을 가로질러 "0:00 / 0:00"을 띄우고 있었다 —
       조용한 흰 페이지에서 가장 큰 요소가 아무 말도 하지 않는 상태였다. */
    #player-bar[hidden] { display: none; }
    #player-bar { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: minmax(180px, 1fr) auto; gap: 12px 24px; padding: 13px 18px 10px; background: var(--text); color: var(--surface); font-size: var(--fs-sm); }
    .player-track { display: flex; gap: 14px; min-width: 0; }
    .now-playing { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .player-time { color: var(--text-4); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .player-actions { display: flex; gap: 8px; }
    .player-actions button { width: 28px; height: 28px; color: var(--surface); padding: 0; }
    .stop span { width: 8px; height: 8px; background: currentColor; }
    .progress { grid-column: 1 / -1; height: 2px; background: var(--text-2); }
    .progress span { display: block; width: 0; height: 100%; background: var(--surface); transition: width var(--dur-fast) linear; }
    :global(body.has-backdrop) #sound-archive { color: var(--surface); text-shadow: 0 1px 12px rgba(0,0,0,.35); }
    :global(body.has-backdrop) #sound-archive, :global(body.has-backdrop) .menu, :global(body.has-backdrop) footer { opacity: 0; pointer-events: none; }
    :global(body.has-backdrop) .release { border-color: rgba(255,255,255,.48); }
    :global(body.has-backdrop) .release-count, :global(body.has-backdrop) .number, :global(body.has-backdrop) .track, :global(body.has-backdrop) .track-meta { color: rgba(255,255,255,.78); }
    :global(body.has-backdrop) .track.is-playing, :global(body.has-backdrop) summary strong { color: var(--surface); }
    @media (max-width: 700px) {
      #sound-archive { width: auto; margin: 24px 16px 80px; }
      .archive-head { margin-bottom: 54px; }
      h1 { font-size: clamp(25px, 7vw, 32px); line-height: 1.22; }
      .intro-copy { display: block; }
      .intro { font-size: var(--fs-sm); line-height: 1.78; }
      .intro[lang="ko"] { line-height: 1.85; }
      summary { grid-template-columns: minmax(0,1fr) auto 68px 18px; gap: 8px; padding: 13px 0; }
      summary strong { font-size: var(--fs-body); line-height: 1.25; }
      .release-len { font-size: var(--fs-xs); }
      /* 9px는 타입 스케일에 없는 값이고 최소 토큰(11px)보다도 작았다 */
      .list-head { font-size: var(--fs-2xs); }
      .list-head .lh-len { padding-right: 26px; }
      /* 칩은 /works와 같은 규칙으로 — 알약 34px에 글자 15px, 눌리는 영역만
         위아래 5px씩 넓혀 44px. 보이는 크기와 눌리는 크기는 같을 필요가 없다. */
      /* 줄바꿈으로 두면 넓힌 탭 영역이 아래윗줄끼리 겹쳐 경계에서 엉뚱한 칩이
         눌린다(실측 44 목표에 39). /works와 같이 한 줄로 두고 옆으로 민다. */
      .sound-filter {
        margin-bottom: 18px;
        flex-wrap: nowrap;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        margin-inline: -16px;
        padding: 7px 16px;
        scrollbar-width: none;
      }
      .sound-filter::-webkit-scrollbar { display: none; }
      .sound-filter a {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        white-space: nowrap;
        position: relative;
        min-height: 30px;
        padding-block: 0;
      }
      .sound-filter a::after { content: ""; position: absolute; inset: -7px 0; }
      .release-count { display: none; }
      /* 태그가 'MOVING IMAGE'였을 때는 제목 열을 100px 넘게 잠식해 모바일에서
         아이콘만 남겼다. A/V로 줄이면서(사운드아트 쪽 표준 표기 — Ikeda의
         [A/V], 페스티벌의 A/V set) 글자가 자리를 거의 안 먹게 되어 그대로
         보여 준다. */
      /* 재생 버튼이 21×21이라 손가락으로 겨누기 어려웠다. 원 자체를 키우면
         목록이 무거워지므로 눌리는 영역만 넓힌다 — 다만 넓힌 영역이 이웃 행을
         침범하면 위아래 경계에서 엉뚱한 트랙이 눌린다. 행 여백을 11px로 올려
         행 높이(43px) 안에 44px에 가까운 타깃이 들어오게 맞춘다. */
      .track { grid-template-columns: minmax(0,1fr) auto 24px; gap: 10px; padding: 11px 0; font-size: var(--fs-xs); line-height: 1.45; }
      /* z-index 없이 두면 넓힌 영역이 DOM에서 뒤에 오는 행에 덮여 무효가 된다
         (실측 21→21). 행 높이(43px)와 영역이 정확히 맞물리므로 위로 올려도
         이웃 트랙을 빼앗지 않는다. */
      .track-control { position: relative; z-index: 1; }
      .track-control::after { content: ""; position: absolute; inset: -11px; }
      .track-meta { gap: 8px; }
      .tracklist { padding: 0 0 12px 30px; }
      .track-control { width: 21px; height: 21px; }
      #player-bar { gap: 9px 14px; padding: 11px 14px 9px; font-size: var(--fs-xs); }
    }
