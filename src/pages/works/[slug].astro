      cursor: zoom-in;
      opacity: 0;
      transition: opacity var(--dur-base) ease;
    }
    .block:hover :global(.focus-open) { opacity: 1; }

    /* 영상 포스터: 첫 프레임 위의 중앙 Play → 클릭 후 몰입형 재생 모드 */
    .video-preview { overflow: hidden; }
    .video-preview::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.32));
    }
    .video-preview video,
    .video-preview iframe { pointer-events: none; }
    .video-play {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      display: grid;
      width: 58px;
      height: 58px;
      padding: 0;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: 50%;
      background: rgba(8, 8, 10, 0.32);
      color: var(--surface);
      cursor: pointer;
      transform: translate(-50%, -50%);
      transition: background var(--dur-base) ease, transform var(--dur-base) ease;
    }
    .video-play span {
      width: 0;
      height: 0;
      margin-left: 3px;
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-left: 12px solid currentColor;
    }
    .video-preview:hover .video-play {
      background: var(--surface);
      color: var(--text);
      transform: translate(-50%, -50%) scale(1.08);
    }

    /* 포커스 모드 — 사진은 밝게, 영상은 어둡게 */
    .focus {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 4vh 4vw;
      background: rgba(246, 246, 246, 0.5);
      -webkit-backdrop-filter: blur(9px);
      backdrop-filter: blur(9px);
      opacity: 0;
      transition: opacity var(--dur-base) ease;
    }
    .focus.open { opacity: 1; }
    .focus[hidden] { display: none; }
    .focus-stage {
      display: flex;
      align-items: center;
      justify-content: center;
      max-width: 92vw;
    }
    .focus-stage img {
      max-width: 92vw;
      max-height: 82vh;
      width: auto;
      height: auto;
      display: block;
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.16);
    }
    .focus-stage .video {
      height: 82vh;
      width: auto;
      max-width: 92vw;
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.16);
    }
    .focus-cap { font-size: var(--fs-sm); color: var(--text-2); text-align: center; }
    .focus-close {
      position: fixed;
      top: 14px;
      right: 16px;
      z-index: 3;               /* 영상/스테이지 위로 → 항상 클릭 가능 (버그 수정) */
      display: flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      font-size: var(--fs-title);
      line-height: 1;
      background: rgba(255, 255, 255, 0.78);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      border: 0;
      border-radius: 50%;
      color: var(--text);
      cursor: pointer;
    }
    .focus-close:hover { color: var(--hover); }
    .focus-nav {
      position: fixed;
      top: 50%;
      z-index: 2;
      display: none;
      width: 54px;
      height: 54px;
      padding: 0;
      border: 1px solid currentColor;
      border-radius: 50%;
      background: rgba(255,255,255,.66);
      color: var(--text);
      font-size: var(--fs-title);
      font-weight: 300;
      line-height: 1;
      cursor: pointer;
      transform: translateY(-50%);
