  <script is:inline>
    /* 2장 행: 실제 비율로 열 폭을 배분해 두 장의 높이·캡션 기선을 정확히 맞춘다.
       크롭 없이 저스티파이 — 도록 조판의 핵심. */
    ;(function () {
      var rows = document.querySelectorAll(".media-row.count-2:not(.is-portrait-row)")
      Array.prototype.forEach.call(rows, function (row) {
        var blocks = row.querySelectorAll(".block")
        if (blocks.length !== 2) return
        function ratioOf(block, done) {
          var v = block.querySelector(".video")
          if (v) {
            var parts = (v.style.aspectRatio || "16 / 9").split("/")
            done(parseFloat(parts[0]) / (parseFloat(parts[1]) || 1))
            return
          }
          var img = block.querySelector("img")
          if (!img) { done(1); return }
          if (img.complete && img.naturalWidth) {
            done(img.naturalWidth / img.naturalHeight)
            return
          }
          img.addEventListener("load", function () { done(img.naturalWidth / img.naturalHeight || 1) }, { once: true })
          img.addEventListener("error", function () { done(1) }, { once: true })
        }
        var ratios = [0, 0]
        var got = 0
        Array.prototype.forEach.call(blocks, function (block, i) {
          ratioOf(block, function (r) {
            ratios[i] = r
            got++
            if (got === 2) row.style.gridTemplateColumns = ratios[0].toFixed(4) + "fr " + ratios[1].toFixed(4) + "fr"
          })
        })
      })
    })()
  </script>




