    .process-note p { margin: 0; font-size: var(--fs-sm); line-height: 1.75; }

    /* 미디어 — 홈 그리드처럼 220/380/540 크기가 여백 있게 흐름 */
    .media {
      clear: both;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 30px 12px;
      align-items: start;
    }
    .media--lead { margin: 0 0 42px; }

    /* 층 구분 라벨 — 스폰서 라벨 형식(회색 소문자) + 가로선 */
    .layer-label {
      clear: both;
      margin: 48px 0 18px;
      padding-top: 11px;
      border-top: 1px solid var(--line-2);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-4);
    }

    /* 영상·사진 모두 하나의 수평 아카이브로 읽는다.
       트랙패드, 가로 스크롤, 마우스 드래그를 지원하고 전체 화면은 선택할 때만 연다. */
    .media-videos,
    .media-stills {
      clear: both;
      display: flex;
      flex-wrap: nowrap;
      gap: 14px;
      margin: 0;
      padding: 0 0 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      cursor: grab;
    }
    .media-videos::-webkit-scrollbar,
    .media-stills::-webkit-scrollbar { display: none; }
    .media-videos.is-dragging,
    .media-stills.is-dragging { cursor: grabbing; }
    .media-videos .block {
      flex: 0 0 clamp(320px, 42vw, 480px) !important;
      min-width: 0;
      margin: 0;
      scroll-snap-align: start;
      scroll-snap-stop: normal;
    }
    .media-videos .block[data-ratio="9:16"] { flex-basis: clamp(190px, 21vw, 250px) !important; }

    /* 작품 상세 공통: 텍스트 다음의 미디어가 스크롤에 맞춰 한 번만 드러남 */
    .media-reveal {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(7px);
      transition: opacity 0.72s ease, transform 0.72s cubic-bezier(0.22, 0.61, 0.36, 1), filter 0.72s ease;
    }
    .media-reveal.is-visible { opacity: 1; transform: none; filter: none; }

    /* 사진 카드 — 원본 비율을 유지한 미리보기. */
    .media-stills .block {
      position: relative;
      flex: 0 0 clamp(300px, 31vw, 380px);
      min-width: 0;
      margin: 0;
      scroll-snap-align: start;
      scroll-snap-stop: normal;
      cursor: zoom-in;
    }
    .media-stills .block.is-portrait { flex-basis: clamp(190px, 21vw, 250px); }
    .media-stills .block img { display: block; width: 100%; height: auto; }
    .media-stills figcaption { margin-top: 8px; font-size: var(--fs-xs); color: var(--text-3); }

    /* 데스크톱: justified 타일 그리드 — 각 타일이 사진 비율 그대로라 resting에서 잘림 없음.
       hover 시 그 타일이 살짝 떠오름(전체 그대로). */
    @media (min-width: 701px) {
      .media-stills {
        position: relative;
        margin-top: 0;
        width: 100%;
      }
      .media-stills .block {
        position: absolute;
        margin: 0;
        overflow: hidden;
        background: var(--surface-2);
        opacity: 0;
        transition:
          opacity 0.4s ease,
          transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
          box-shadow 0.35s ease;
        cursor: zoom-in;
      }
      .media-stills.ready .block { opacity: 1; }
      /* 타일 비율 = 사진 비율 → cover여도 잘리지 않음 */
      .media-stills .block img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* hover: 그 타일이 위로 떠오르며 확대 (이미지는 이미 전체가 보임) */
      .media-stills .block:hover {
        transform: scale(1.06);
        z-index: 5;
        box-shadow: 0 14px 44px rgba(0, 0, 0, 0.22);
      }
      .media-stills figcaption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        margin: 0;
        padding: 22px 12px 9px;
        color: var(--surface);
        font-size: var(--fs-xs);
        background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }
      .media-stills .block:hover figcaption { opacity: 1; }
    }

    /* 기존 justified 갤러리를 수평 트랙으로 대체한다. */
    @media (min-width: 701px) {
      .media-stills {
        position: relative;
        width: auto;
        height: auto !important;
        overflow-x: auto;
      }
      .media-stills .block,
      .media-stills.ready .block {
        position: relative;
        flex: 0 0 clamp(300px, 31vw, 380px);
        height: auto !important;
        margin: 0;
        overflow: visible;
        background: transparent;
        opacity: 1;
        transform: none;
        box-shadow: none;
      }
      .media-stills .block.is-portrait { flex-basis: clamp(190px, 21vw, 250px); }
      .media-stills .block img {
        position: relative;
        inset: auto;
        width: 100%;
        height: auto;
        object-fit: contain;
      }
      .media-stills .block:hover { transform: none; box-shadow: none; }
      .media-stills figcaption {
        position: static;
        margin-top: 8px;
        padding: 0;
        color: var(--text-3);
        background: none;
        opacity: 1;
      }
    }

    .post-gallery-divider {
      clear: both;
      margin: 72px 0 0;
      border-top: 1px solid var(--line);
    }

    /* 12열 그리드: 자료의 역할과 여백을 함께 조절한다. */
    .block { position: relative; grid-column: span 5; }
    /* 이미지 확대 힌트: 별도 버튼 없이 그림 전체 클릭. hover 시 이미지만 살짝 어두워지고 중앙에 ⤢ */
    .block:not(.is-video) { cursor: zoom-in; align-self: start; }
    .block:not(.is-video) img { transition: filter 0.2s ease; }
    .block:not(.is-video):hover img { filter: brightness(0.9); }
    .block:not(.is-video)::before {
      content: "\2922"; position: absolute; left: 50%; top: 50%; z-index: 2; pointer-events: none;
      display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
      background: rgba(255,255,255,0.92); color: var(--text); font-size: var(--fs-lead);
      transform: translate(-50%, -50%) scale(0.9); opacity: 0;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .block:not(.is-video):hover::before { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    .block.hero { grid-column: 1 / span 9; }
    .block.wide { grid-column: span 7; }
    .block.standard { grid-column: span 5; }
    .block.detail,
    .block.portrait { grid-column: span 4; }
    .block.hero.align-left { grid-column: 1 / span 9; }
    .block.hero.align-right { grid-column: 4 / span 9; }
    .block.wide.align-left { grid-column: 1 / span 7; }
    .block.wide.align-right { grid-column: 6 / span 7; }
    .block.standard.align-left { grid-column: 1 / span 5; }
    .block.standard.align-right { grid-column: 8 / span 5; }
    .block.detail.align-left,
    .block.portrait.align-left { grid-column: 1 / span 4; }
    .block.detail.align-right,
    .block.portrait.align-right { grid-column: 9 / span 4; }
    .block img { display: block; width: 100%; }
    .block .ph { background: var(--line); height: 0; }
    figure { margin: 0; }
    figcaption { font-size: var(--fs-xs); color: var(--text-2); margin-top: 4px; }
    .media-note {
      margin-top: 18px;
      padding-top: 12px;
