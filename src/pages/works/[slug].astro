    }
    .related-materials-list { list-style: none; margin: 0; padding: 0; }
    .related-materials-list li { border-top: 1px solid var(--line); }
    .related-materials-list li:last-child { border-bottom: 1px solid var(--line); }
    .related-materials-list a {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 18px;
      padding: 12px 2px;
      color: var(--text);
    }
    .related-materials-list a:hover { color: var(--hover); }
    .rm-title { font-size: var(--fs-sm); }
    .rm-shared { font-size: var(--fs-xs); color: var(--text-3); text-align: right; }
    .related-materials-list a:hover .rm-shared { color: var(--hover); }
    .series-link {
      display: inline-flex;
      flex-direction: column;
      gap: 2px;
      margin: 0 0 30px;
      font-size: var(--fs-sm);
