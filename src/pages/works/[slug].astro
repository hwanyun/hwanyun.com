      cursor: pointer;
    }
    .focus-close:hover { color: var(--hover); }
    .focus-nav {
      position: fixed;
      top: 50%;
      z-index: 2;
      display: none;
      width: 54px;
      height: 54px;
      padding: 0;
      border: 1px solid currentColor;
      border-radius: 50%;
      background: rgba(255,255,255,.66);
      color: var(--text);
      font-size: var(--fs-title);
      font-weight: 300;
