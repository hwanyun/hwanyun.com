    .textcols .col p:last-child { margin-bottom: 0; }

    .desc { font-size: var(--fs-body); font-weight: 400; line-height: 1.8; max-width: 640px; margin: 0 0 30px; }
    .desc :global(p) { margin: 0 0 1em; }
    .process-note {
