      position: relative;
    }
    /* 전시 캡션(월 라벨) 순서를 그대로 따른다 — 제목 / 성향 / 재료.
       세 줄이 각각 한 층으로 보이면 안 되고 하나의 캡션 덩어리로 읽혀야 하므로,
       안쪽 행간은 좁히고 대신 아래 재료 태그 앞에서 크게 띄운다.
       그 간격이 "여기까지가 캡션, 여기부터는 통로"를 가른다. */
    .entry_title {
      font-size: var(--fs-display);
      font-weight: 300;
      line-height: 1.25;
      margin-bottom: 12px;
    }
    .meta { font-size: var(--fs-body); font-weight: 400; line-height: 1.45; color: var(--text-2); margin: 0 0 30px; }
    .meta .medium-type { display: block; color: var(--text); }
    .meta .medium-materials { display: block; margin-top: 3px; color: var(--text-3); }

    /* 재료 태그 — 같은 재료를 쓴 작품으로 가는 통로.
       회로의 접점을 연상시키되 사이트의 흑백 톤은 유지한다. */
    .materials {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 8px;
      margin: 0 0 26px;
    }
    .material-tag {
      font-size: var(--fs-xs);
      line-height: 1;
      padding: 6px 11px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      color: var(--text-2);
      transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
    }
    .material-tag::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 4px;
      margin-right: 7px;
      vertical-align: 1px;
      border-radius: 50%;
      background: var(--line-2);
      transition: background var(--dur-fast) ease;
    }
    .material-tag:hover { border-color: var(--hover); color: var(--hover); }
    .material-tag:hover::before { background: var(--hover); }

    /* 같은 재료의 작품 — 작품 페이지의 막다른 골목을 없앤다 */
    /* 본문 뒤 크레딧 블록들(재료·전시·읽을거리·후원)은 하나의 리듬을 공유한다 —
       블록 사이 48px, 라벨과 내용 사이 12px. 4:1이라 어디서 끊기는지 눈이 안다. */
    .related-materials { margin: var(--space-4) 0 0; }
    .related-materials-label {
      font-size: var(--fs-2xs);
