    /* 층 구분 라벨 — 스폰서 라벨 형식(회색 소문자) + 가로선 */
    /* ── 미디어 흐름: 도록의 조판 ──────────────────────────────
       행 패턴은 셋뿐 — 전체폭 / 2장 나란히(같은 높이) / 단독 부분폭.
       2장 행은 아래 스크립트가 실제 비율로 열 폭을 보정해
       두 장의 높이와 캡션 기선이 정확히 맞는다. 크롭은 어디에도 없다. */
    /* ── 판형: 신호 파형 ──
       기록의 흐름이 하나의 신호다. 가느다란 세로선(신호선)이 지면을 관통하고,
       도판들은 파형의 진폭처럼 좌우로 번갈아 걸린다. 페어는 선을 사이에 두고
       양쪽에 선다. 스크롤 위치가 재생헤드다 — 지나온 구간의 선이 채워지고,
       도판 앞 접점이 켜진다. 사운드 페이지의 재생 바, Works 목록의 회로
       트레이스와 같은 문법이다.
       도판은 선 위에 놓이므로 선은 도판 사이 여백에서만 보인다 —
       회로가 부품 아래를 지나는 것과 같다. */
    .media-flow {
      clear: both;
      display: flex;
      flex-direction: column;
      gap: 104px;
      margin-top: 72px;
    }
    /* 시범: 파형 판형이 켜진 페이지 */
    #entry[data-waveform] .media-flow { position: relative; margin-top: 88px; }
    /* 도판이 하나뿐이면 신호가 없다 — 축선과 접점을 그리지 않는다.
       한 점 위아래로 뻗은 선은 파형이 아니라 고아다. */
    #entry[data-waveform] .media-flow.single::before,
    #entry[data-waveform] .media-flow.single::after,
    #entry[data-waveform] .media-flow.single .media-row::before { display: none; }
    #entry[data-waveform] .media-flow::before {
      content: "";
      position: absolute;
      left: 50%;
      top: -44px;
      bottom: 0;
      width: 1px;
      background: var(--line-2);
    }
    /* 재생된 구간 — 스크롤 스크립트가 --played를 채운다 */
    #entry[data-waveform] .media-flow::after {
      content: "";
      position: absolute;
      left: 50%;
      top: -44px;
      width: 1px;
      height: var(--played, 0%);
      max-height: calc(100% + 44px);
      background: var(--text-2);
    }
    /* 접점 — 각 도판 위 여백 한가운데. 재생헤드가 지나면 채워진다.
       시아노타입의 '노출된' 접점(Works 목록 is-seen)과 같은 어휘. */
    #entry[data-waveform] .media-row { position: relative; }
    #entry[data-waveform] .media-row::before {
      content: "";
      position: absolute;
      left: 50%;
      top: -56px;
      transform: translateX(-50%);
      width: 7px;
      height: 7px;
      border-radius: 50%;
      border: 1px solid var(--line-2);
      background: var(--surface);
      z-index: 1;
      transition: background var(--dur-base) ease, border-color var(--dur-base) ease;
    }
    #entry[data-waveform] .media-row.is-fired::before { background: var(--text-2); border-color: var(--text-2); }
    /* 도판이 선을 덮도록 위 레이어에 둔다 */
    #entry[data-waveform] .media-row .block { position: relative; z-index: 1; }
    /* 파형의 진폭 — 단독 도판은 좌/우로 번갈아 선다. 페어와 세로 행,
       명시적 align이 있는 부분폭 행은 제 규칙을 지킨다. */
    #entry[data-waveform] .media-row.wave-l .block { margin-left: 0; margin-right: auto; }
    #entry[data-waveform] .media-row.wave-r .block { margin-left: auto; margin-right: 0; }
    #entry[data-waveform] .media-row.wave-l:not(.solo-half):not(.solo-third) .block:not(.is-video),
    #entry[data-waveform] .media-row.wave-r:not(.solo-half):not(.solo-third) .block:not(.is-video) { max-width: 84%; }
    #entry[data-waveform] .media-row.wave-l .block.is-video,
    #entry[data-waveform] .media-row.wave-r .block.is-video { width: 84%; }
    .media-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      align-items: start;
    }
    .media-row.count-2 { grid-template-columns: 1fr 1fr; }
    .media-row .block { grid-column: auto; margin: 0; min-width: 0; }
    .media-row .block img { display: block; width: 100%; height: auto; }
    /* 단독 도판 — 화면을 넘지 않는 높이(78vh)로 서고, figure가 이미지 폭에
       맞춰 줄어들어 중앙에 선다. 번호와 캡션이 컨테이너가 아니라 도판의
       왼끝에 정렬되는 것이 핵심이다 — 좁아진 세로 사진 옆 허공에 번호가
       떠 있으면 조판이 아니라 사고다. */
    .media-row.count-1 .block:not(.is-video) {
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
    }
    .media-row.count-1 .block img {
      width: auto;
      max-width: 100%;
      max-height: 78vh;
    }
    /* 도판 번호 — eyebrow와 같은 어휘. 번호가 사진을 도판으로 만든다. */
    .plate-n {
      display: block;
      margin-bottom: 7px;
      font-size: var(--fs-2xs);
      letter-spacing: .14em;
      color: var(--text-4);
      font-variant-numeric: tabular-nums;
    }
    .media-row figcaption { margin-top: 10px; font-size: var(--fs-xs); color: var(--text-3); letter-spacing: .01em; max-width: 62ch; }

    /* 세로 미디어 행 — 화면을 다 먹지 않게 폭을 묶고 중앙 정렬 */
    .media-row.is-portrait-row { display: flex; justify-content: center; gap: 14px; }
    .media-row.is-portrait-row .block { width: min(340px, 38vw); }

    /* 단독 부분폭 — half는 2/3, third는 2/5. align을 따른다.
       count-1의 fit-content 규칙과 특정도가 같으므로 순서로 이긴다 —
       이 블록이 뒤에 있어야 작은 도판이 전폭으로 부풀지 않는다.
       파형에서는 이 작은 도판들이 좌우로 비켜 서며 진폭의 일부가 된다. */
    .media-row.solo-half .block,
    .media-row.count-1.solo-half .block:not(.is-video) { width: 66%; max-width: 66%; margin-inline: 0; }
    .media-row.solo-third .block,
    .media-row.count-1.solo-third .block:not(.is-video) { width: 40%; max-width: 40%; margin-inline: 0; }
    .media-row.align-right .block,
    .media-row.count-1.align-right .block:not(.is-video) { margin-left: auto; margin-right: 0; }
    .media-row.align-center .block,
    .media-row.count-1.align-center .block:not(.is-video) { margin-inline: auto; }

    /* 스크롤 리빌 — 있는 듯 없는 듯.
       블러·큰 이동은 작품보다 연출이 먼저 보이게 하므로 쓰지 않는다. */
    .media-reveal {
      opacity: 0.45;
      transform: translateY(6px);
      transition: opacity var(--dur-base) ease, transform var(--dur-base) ease;
    }
    .media-reveal.is-visible { opacity: 1; transform: none; }

    @media (max-width: 700px) {
      .media-flow { gap: 56px; margin-top: 48px; }
      .media-row { gap: 8px; }
      .media-row.solo-half .block,
      .media-row.solo-third .block { width: 100%; }
      .media-row.is-portrait-row .block { width: min(78vw, 340px); }
    }

    /* 도록의 부록 — 본문에서 걷어낸 기록 사진들. 접혀 있고, 펼치면
       위계 없는 균일 그리드. 본문의 어휘(얇은 선, 색 하나 반응)를 따른다. */
    .media-archive { clear: both; margin: 56px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .media-archive summary {
      display: flex; align-items: baseline; justify-content: space-between;
      padding: 14px 2px; cursor: pointer; list-style: none;
      transition: color var(--dur-fast) var(--ease);
    }
    .media-archive summary::-webkit-details-marker { display: none; }
    .media-archive summary:hover { color: var(--hover); }
    .ma-label { font-size: var(--fs-xs); letter-spacing: .08em; text-transform: uppercase; }
    .ma-n { color: var(--text-4); margin-left: 6px; font-variant-numeric: tabular-nums; }
    .ma-expand { font-size: var(--fs-lead); font-weight: 300; line-height: .7; }
    .media-archive[open] .ma-expand { transform: rotate(45deg); }
    .ma-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
      gap: 6px; padding: 2px 0 18px;
    }
    .ma-grid figure { margin: 0; }
    .ma-grid img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }

    .post-gallery-divider {
      clear: both;
      margin: 72px 0 0;
      border-top: 1px solid var(--line);
    }
    /* 부록이 있으면 경계선이 겹으로 생긴다 — 부록의 아래선이 그 역할을 대신한다 */
    .media-archive + .post-gallery-divider { border-top: 0; margin-top: 56px; }

    /* 12열 그리드: 자료의 역할과 여백을 함께 조절한다. */
    .block { position: relative; grid-column: span 5; }
    /* 이미지 확대 힌트: 별도 버튼 없이 그림 전체 클릭. hover 시 이미지만 살짝 어두워지고 중앙에 ⤢ */
    .block:not(.is-video) { cursor: zoom-in; align-self: start; }
    .block:not(.is-video) img { transition: filter var(--dur-base) ease; }
    .block:not(.is-video):hover img { filter: brightness(0.9); }
    .block:not(.is-video)::before {
      content: "\2922"; position: absolute; left: 50%; top: 50%; z-index: 2; pointer-events: none;
      display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
      background: rgba(255,255,255,0.92); color: var(--text); font-size: var(--fs-lead);
      transform: translate(-50%, -50%) scale(0.9); opacity: 0;
      transition: opacity var(--dur-base) ease, transform var(--dur-base) ease;
    }
    .block:not(.is-video):hover::before { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    .block.hero { grid-column: 1 / span 9; }
    .block.wide { grid-column: span 7; }
    .block.standard { grid-column: span 5; }
    .block.detail,
    .block.portrait { grid-column: span 4; }
    .block.hero.align-left { grid-column: 1 / span 9; }
    .block.hero.align-right { grid-column: 4 / span 9; }
    .block.wide.align-left { grid-column: 1 / span 7; }
    .block.wide.align-right { grid-column: 6 / span 7; }
    .block.standard.align-left { grid-column: 1 / span 5; }
    .block.standard.align-right { grid-column: 8 / span 5; }
    .block.detail.align-left,
    .block.portrait.align-left { grid-column: 1 / span 4; }
    .block.detail.align-right,
    .block.portrait.align-right { grid-column: 9 / span 4; }
    .block img { display: block; width: 100%; }
    .block .ph { background: var(--line); height: 0; }
    figure { margin: 0; }
    figcaption { font-size: var(--fs-xs); color: var(--text-2); margin-top: 4px; }
    .media-note {
      margin-top: 18px;
      padding-top: 12px;
      border-top: 1px solid var(--line);
      color: var(--text-2);
    }
    .media-note-label {
      margin-bottom: 10px;
      font-size: var(--fs-2xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-4);
    }
    .media-note-cols { display: block; }
    .media-note p { margin: 0; font-size: var(--fs-sm); line-height: 1.7; }

    /* 미디어 확대 버튼 (hover 시 노출) — JS 생성 요소라 :global 필요 */
    .block :global(.focus-open) {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 2;
      width: 34px;
      height: 34px;
      border: 0;
      border-radius: 0;
      background: rgba(255, 255, 255, 0.86);
      color: var(--text);
      font-size: var(--fs-sm);
      line-height: 1;
      cursor: zoom-in;
      opacity: 0;
      transition: opacity var(--dur-base) ease;
    }
    .block:hover :global(.focus-open) { opacity: 1; }

    /* 영상 포스터: 첫 프레임 위의 중앙 Play → 클릭 후 몰입형 재생 모드 */
    .video-preview { overflow: hidden; }
    .video-preview::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.32));
    }
    .video-preview video,
    .video-preview iframe { pointer-events: none; }
    .video-play {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      display: grid;
      width: 58px;
      height: 58px;
      padding: 0;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: 50%;
      background: rgba(8, 8, 10, 0.32);
      color: var(--surface);
      cursor: pointer;
      transform: translate(-50%, -50%);
      transition: background var(--dur-base) ease, transform var(--dur-base) ease;
    }
    .video-play span {
      width: 0;
      height: 0;
      margin-left: 3px;
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-left: 12px solid currentColor;
    }
    .video-preview:hover .video-play {
      background: var(--surface);
      color: var(--text);
      transform: translate(-50%, -50%) scale(1.08);
    }

    /* 포커스 모드 — 사진은 밝게, 영상은 어둡게 */
    .focus {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 4vh 4vw;
      background: rgba(246, 246, 246, 0.5);
      -webkit-backdrop-filter: blur(9px);
      backdrop-filter: blur(9px);
      opacity: 0;
      transition: opacity var(--dur-base) ease;
    }
    .focus.open { opacity: 1; }
    .focus[hidden] { display: none; }
    .focus-stage {
      display: flex;
      align-items: center;
      justify-content: center;
      max-width: 92vw;
    }
    .focus-stage img {
      max-width: 92vw;
      max-height: 82vh;
      width: auto;
      height: auto;
      display: block;
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.16);
    }
    .focus-stage .video {
      height: 82vh;
      width: auto;
      max-width: 92vw;
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.16);
    }
    .focus-cap { font-size: var(--fs-sm); color: var(--text-2); text-align: center; }
    .focus-close {
      position: fixed;
      top: 14px;
      right: 16px;
      z-index: 3;               /* 영상/스테이지 위로 → 항상 클릭 가능 (버그 수정) */
      display: flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 46px;
      font-size: var(--fs-title);
      line-height: 1;
      background: rgba(255, 255, 255, 0.78);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      border: 0;
      border-radius: 50%;
      color: var(--text);
      cursor: pointer;
    }
    .focus-close:hover { color: var(--hover); }
    .focus-nav {
      position: fixed;
      top: 50%;
      z-index: 2;
      display: none;
      width: 54px;
      height: 54px;
      padding: 0;
      border: 1px solid currentColor;
      border-radius: 50%;
      background: rgba(255,255,255,.66);
      color: var(--text);
      font-size: var(--fs-title);
      font-weight: 300;
      line-height: 1;
      cursor: pointer;
      transform: translateY(-50%);
      transition: color var(--dur-base) ease, transform var(--dur-base) ease;
    }
    .focus.has-gallery-nav .focus-nav { display: block; }
    .focus-prev { left: 18px; }
    .focus-next { right: 18px; }
    .focus-nav:hover { color: var(--hover); }
    .focus-prev:hover { transform: translate(-4px, -50%); }
    .focus-next:hover { transform: translate(4px, -50%); }
    .focus.video-focus { background: rgba(7, 8, 10, 0.5); }
    .focus.video-focus .focus-close,
    .focus.video-focus .focus-cap,
    .focus.video-focus .focus-nav { color: var(--surface-2); }
    .focus.video-focus .focus-nav { background: rgba(7,8,10,.48); }
    .focus.video-focus .focus-close { background: rgba(7,8,10,.55); color: var(--surface); }
    .focus.video-focus .focus-stage .video { box-shadow: none; }

    /* 영상: 비율에 맞춰 자동 크기 */
    .video { position: relative; width: 100%; background: var(--text); }
    .video iframe,
    .video video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    /* 전시 맥락과 후원 크레딧은 작품 갤러리와 분리해 표기 */
    .exhibition-credit {
      clear: both;
      position: relative;
      z-index: 1;
      margin: var(--space-4) 0 0;
      padding-top: 0;
    }
    /* 청하지 않은 소리를 켜는 쪽이므로, 끄는 길이 늘 화면에 보여야 한다.
       스크롤-투-톱 FAB이 오른쪽에 있으니 왼쪽 아래에 둔다. */
    .ambient { position: fixed; left: 18px; bottom: 18px; z-index: 60; }
    .ambient[hidden] { display: none; }
    .ambient-toggle {
      display: inline-flex; align-items: center; gap: 9px;
      max-width: min(70vw, 340px);
      padding: 8px 15px 8px 12px;
      border: 1px solid var(--line-2); border-radius: 999px;
      background: var(--surface); color: var(--text-2);
      font: 400 var(--fs-xs)/1.2 var(--sans); text-align: left;
      cursor: pointer;
      transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
    }
    .ambient-toggle:hover { border-color: var(--hover); color: var(--hover); }
    .ambient-icon {
      flex: none; width: 9px; height: 9px; border-radius: 50%;
      background: currentColor; opacity: .35;
      transition: opacity var(--dur-fast) ease;
    }
    .ambient.is-playing .ambient-icon { opacity: 1; animation: ambient-pulse 2.6s ease-in-out infinite; }
    @keyframes ambient-pulse { 0%, 100% { opacity: 1 } 50% { opacity: .3 } }
    .ambient-text { display: flex; gap: 7px; min-width: 0; }
    .ambient-state { flex: none; }
    .ambient-title {
      color: var(--text-4); min-width: 0;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    @media (prefers-reduced-motion: reduce) { .ambient.is-playing .ambient-icon { animation: none } }
    @media (max-width: 700px) {
      .ambient { left: 12px; bottom: 12px; }
      .ambient-title { display: none; }
    }

    .related-sounds {
      clear: both;
      position: relative;
      z-index: 1;
      margin: var(--space-4) 0 0;
      padding-top: 0;
    }
    .related-sounds-label {
      margin-bottom: var(--space-2);
      font-size: var(--fs-2xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-4);
    }
    .related-sounds-list { display: flex; flex-wrap: wrap; gap: 9px 24px; }
    .related-sounds-list a { display: inline-flex; gap: 8px; align-items: baseline; color: var(--text-2); font-size: var(--fs-sm); }
    .related-sounds-list a span:last-child { font-size: var(--fs-xs); color: var(--text-4); }
    .related-sounds-list a:hover, .related-sounds-list a:hover span:last-child { color: var(--hover); }
    .external-links {
      clear: both;
      position: relative;
      z-index: 1;
      margin: var(--space-4) 0 0;
      padding-top: 0;
    }
    .external-links-label {
      margin-bottom: var(--space-2);
      font-size: var(--fs-2xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-4);
    }
    .external-links-list { display: flex; flex-wrap: wrap; gap: 9px 24px; }
    .external-links-list a { display: inline-flex; gap: 8px; align-items: baseline; color: var(--text-3); font-size: var(--fs-sm); }
    .external-links-list a span:last-child { font-size: var(--fs-xs); color: var(--text-4); }
    .external-links-list a:hover, .external-links-list a:hover span:last-child { color: var(--hover); }
    .exhibition-label,
    .sponsors-label {
      font-size: var(--fs-2xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-4);
      margin-bottom: var(--space-2);
    }
    .exhibition-title { font-size: var(--fs-body); color: var(--text-2); }
    /* 장소·연도는 전시명과 같은 줄에 "·"로 잇지 않는다. 둘 다 길면 줄이 접히면서
       구분자가 줄머리로 떨어지고, 무엇이 전시명이고 무엇이 장소인지도 흐려진다.
       한 층 아래 작은 글자로 내리면 접혀도 모양이 무너지지 않고 위계도 분명해진다. */
    .exhibition-meta {
      display: block;
      margin-top: 4px;
      font-size: var(--fs-xs);
      color: var(--text-4);
    }
    .sponsors {
      clear: both;
      position: relative;
      z-index: 1;
      margin: var(--space-4) 0 var(--space-4);
    }
    .sponsors-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 32px;
    }
    .sponsor { display: inline-flex; align-items: center; }
    .sponsor-name { font-size: var(--fs-body); color: var(--text-2); }
    /* 기관 로고는 남의 아이덴티티다 — 무채색 규칙의 예외로 원색을 그대로 둔다. */
    /* 실제 크기는 빌드 때 면적을 맞춰 계산한 인라인 값이 정한다(logoSize.ts).
       여기 상한은 그 계산이 실패했을 때(파일을 못 읽는 등)만 받는 안전장치이므로,
       계산값을 다시 자르지 않도록 헬퍼의 상한과 같은 값으로 둔다. */
    .sponsor img {
      max-height: 48px;
      max-width: 150px;
      display: block;
    }

    @media (max-width: 700px) {
      #entry {
        width: calc(100% - 32px);
        margin: 24px 16px 0;
      }
      /* 모바일 제목 반응 곡선은 사이트 공통 clamp 한 벌(25px, 7vw, 32px)을 쓴다 —
         이 페이지만 28/8vw/34로 달랐다. 페이지 제목보다 위계가 낮아진 것은
         데스크톱(38→30)과 같은 방향이다. */
      .entry_title {
        font-size: clamp(25px, 7vw, 32px);
        line-height: 1.2;
        margin-bottom: 11px;
      }
      .meta {
        margin-bottom: 24px;
        font-size: var(--fs-sm);
        line-height: 1.5;
      }
      /* 형태와 재료는 한 캡션이다 — 데스크톱처럼 크기는 같게 두고 색으로만
         가른다. 모바일에서만 13px로 줄였더니 캡션이 두 층으로 갈라지고,
         아래 재료 태그(13px)와 같은 크기가 되어 통로와도 구분이 사라졌다. */
      .meta .medium-materials { margin-top: 2px; line-height: 1.5; }
      /* 간격이 전부 24px 안팎이라 열 개 구역이 한 뭉텅이로 읽혔다.
         붙을 것과 떨어질 것을 세 단으로 가른다:
           같은 묶음 안 10px · 묶음과 묶음 사이 34px · 큰 마디 56px
         재료 태그와 연작은 둘 다 '다른 작품으로 가는 통로'라 한 묶음이다. */
      /* 재료·형태 태그도 /works 칩과 같은 규칙 — 27px이던 타깃을 44px로.
         알약은 그대로 두고 눌리는 영역만 넓힌다. */
      .materials { margin-bottom: 10px; padding-block: 5px; }
      .materials a { position: relative; }
      .materials a::after { content: ""; position: absolute; inset: -8px 0; }
      .series-link { margin: 0 0 34px; font-size: var(--fs-xs); }
      .textcols .col {
        width: 100%;
        margin: 0 0 26px;
        padding-top: 10px;
        float: none;
        font-size: var(--fs-sm);
        line-height: 1.78;
      }
      .textcols .col.kr { line-height: 1.85; }
      .desc { margin-bottom: 26px; font-size: var(--fs-sm); line-height: 1.78; }
      .process-note { margin: -2px 0 32px; }
      .process-note-cols { grid-template-columns: 1fr; gap: 10px; }
      .process-note p { font-size: var(--fs-xs); line-height: 1.7; }
      .media--lead { margin-bottom: 32px; }
      /* 리드 미디어(비몰입 모드)는 모바일에서 전체폭 */
      .block,
      .block.hero,
      .block.wide,
      .block.standard,
      .block.detail,
      .block.portrait { grid-column: 1 / -1; }
      .media { gap: 16px; }
      figcaption { margin-top: 6px; font-size: var(--fs-2xs); line-height: 1.45; }
      .media-note { margin-top: 13px; padding-top: 9px; }
      .media-note-cols { grid-template-columns: 1fr; gap: 8px; }
      .media-note p { font-size: var(--fs-xs); line-height: 1.65; }
      .block :global(.focus-open) { opacity: 0.9; }
      .focus-stage .video { height: auto; width: 92vw; max-height: 82vh; }
      .video-play { width: 52px; height: 52px; }
      .focus-nav { width: 42px; height: 42px; font-size: var(--fs-title); }
      .focus-prev { left: 4px; }
      .focus-next { right: 4px; }
      .post-gallery-divider { margin-top: 48px; }
      /* 모바일도 같은 4:1 — 블록 24px, 라벨 6px */
      /* 하단 구역들 — 관련 작품 / 관련 사운드 / 읽을거리 / 전시 크레딧은
         서로 성격이 다르다. 24px로 이어 붙이면 목록 하나로 보인다. */
      .related-materials, .related-sounds, .external-links, .exhibition-credit { margin-top: 40px; }
      .related-materials-label, .related-sounds-label, .external-links-label, .exhibition-label, .sponsors-label { margin-bottom: var(--space-1); font-size: var(--fs-2xs); }
      .related-sounds-list, .external-links-list { display: grid; gap: 9px; }
      .related-sounds-list a, .external-links-list a { justify-content: space-between; font-size: var(--fs-xs); }
      .exhibition-title { font-size: var(--fs-sm); line-height: 1.6; }
      .exhibition-title span + span::before { content: none; }
      .exhibition-meta { width: 100%; color: var(--text-3); }
      /* 후원은 남의 아이덴티티다 — 앞 구역과 더 떼어 크레딧임을 분명히 한다 */
      .sponsors { margin-top: 48px; }
      .sponsors-row { gap: 20px; }
      .sponsor-name { font-size: var(--fs-sm); }
    }

    @media (prefers-reduced-motion: reduce) {
      .media-reveal { transition: none; transform: none; filter: none; }
    }
  </style>

  <SeenTracker slug={work.slug} />

  {/* 좁은 화면에는 경량본을 준다. 폰의 표시 폭은 400px 남짓이라 데스크톱
      해상도가 보이지도 않는데 파일은 그대로 다 받느라 재생이 끊긴다.
      preload가 시작되기 전에 갈아 끼워야 하므로 문서 파싱 중에 실행한다. */}
  <script is:inline>
    ;(function () {
      if (!window.matchMedia("(max-width: 700px)").matches) return
      var swap = function () {
        document.querySelectorAll("video[data-src-sm]").forEach(function (v) {
          var sm = v.getAttribute("data-src-sm")
          if (!sm || v.currentSrc === sm) return
          var t = v.currentTime, playing = !v.paused
          v.src = sm
          if (t) v.currentTime = t
          if (playing) v.play().catch(function () {})
        })
      }
      swap()
      document.addEventListener("DOMContentLoaded", swap)
    })()
  </script>

  <script is:inline>
    ;(function () {
      var box = document.querySelector(".ambient")
      if (!box) return
      var btn = box.querySelector(".ambient-toggle")
      var key = box.dataset.key
      var audio = new Audio(box.dataset.src)
      audio.loop = true
      audio.preload = "auto"
      audio.volume = 0.72

      /* 한 번 끈 방문자에게 페이지를 옮길 때마다 다시 소리를 들이밀지 않는다 */
      var muted = false
      try { muted = sessionStorage.getItem(key) === "off" } catch (e) {}

      var setState = function (on) {
        box.classList.toggle("is-playing", on)
        btn.setAttribute("aria-pressed", on ? "true" : "false")
        btn.querySelectorAll(".ambient-state").forEach(function (el) {
          var ko = el.dataset.languageContent === "ko"
          el.textContent = on ? (ko ? "사운드 켜짐" : "Sound on") : (ko ? "사운드 재생" : "Play sound")
        })
      }
      var start = function () {
        return audio.play().then(function () { setState(true); return true },
                                 function () { setState(false); return false })
      }
      var stop = function () { audio.pause(); setState(false) }

      box.hidden = false
      setState(false)

      btn.addEventListener("click", function () {
        if (audio.paused) {
          try { sessionStorage.removeItem(key) } catch (e) {}
          start()
        } else {
          try { sessionStorage.setItem(key, "off") } catch (e) {}
          stop()
        }
      })

      if (muted) return

      /* 자동재생을 시도하되 뚫지는 않는다. 기본 설정의 Chrome·Safari는
         제스처 없는 오디오를 막으므로, 막히면 방문자의 첫 동작에 한 번만
         편승하고 그마저 실패하면 버튼으로 남는다. */
      start().then(function (ok) {
        if (ok) return
        var armed = ["pointerdown", "keydown", "touchstart", "wheel"]
        var onFirst = function () {
          armed.forEach(function (t) { document.removeEventListener(t, onFirst) })
          try { if (sessionStorage.getItem(key) === "off") return } catch (e) {}
          start()
        }
        armed.forEach(function (t) { document.addEventListener(t, onFirst, { once: false, passive: true }) })
      })

      window.addEventListener("pagehide", stop)
    })()
  </script>
</Base>
