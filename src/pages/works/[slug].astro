    .textcols .col.kr { line-height: 1.85; }
    .textcols .col p { margin: 0 0 1em; }
    .textcols .col p:last-child { margin-bottom: 0; }

    .desc { font-size: var(--fs-body); font-weight: 400; line-height: 1.8; max-width: 640px; margin: 0 0 30px; }
    .desc :global(p) { margin: 0 0 1em; }
    .process-note {
      clear: both;
      margin: -4px 0 42px;
      color: var(--text-4);
    }
    /* 한 번에 한 언어만 보이므로 단을 나누지 않는다 */
    .process-note-cols { display: block; }
    /* 단락은 실제 <p>로 나눈다. pre-line으로 줄바꿈을 흉내 내면 YAML이 80자에
       맞춰 접은 줄까지 화면에 찍혀, 폭이 좁은 모바일에서 문장이 토막 난다. */
