---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import { MATERIALS } from "../../data/materials"
import { AXES } from "../../data/axes"
import SeenTracker from "../../components/SeenTracker.astro"

const works = await getCollection("works", ({ data }) => !data.draft)
works.sort((a, b) => {
  const sortYear = (year: string) => Math.max(...(year.match(/\d{4}/g) ?? ["0"]).map(Number))
  const byYear = sortYear(b.data.year) - sortYear(a.data.year)
  return byYear || (a.data.order ?? 0) - (b.data.order ?? 0)
})

// 세 축(울림·접촉·흔적) — 신호가 지나는 단계. 홈의 축 카드와 같은 어휘.
const axisCounts = AXES.map((a) => ({
  ...a,
  count: works.filter((w) => w.data.axes.includes(a.id)).length,
})).filter((a) => a.count > 0)

// 재료별 작품 수 — 0개인 재료는 필터 바에 띄우지 않는다
const materialCounts = MATERIALS.map((m) => ({
  ...m,
  count: works.filter((w) => w.data.materials.includes(m.id)).length,
})).filter((m) => m.count > 0)

// 전시 형태 — 재료와 다른 축이므로 필터 바에서도 줄을 나눈다
const SHOWS = [
  { id: "solo", en: "Solo exhibition", ko: "개인전" },
  { id: "group", en: "Group exhibition", ko: "단체전" },
]
const showCounts = SHOWS.map((x) => ({
  ...x,
  count: works.filter((w) => w.data.showType === x.id).length,
})).filter((x) => x.count > 0)
---

<Base title="Works — HWANYUN" current="works">
  <main class="works-archive">
    <header class="archive-intro">
      <p class="eyebrow">WORK ARCHIVE</p>
      <h1>Works</h1>
      <div class="intro-copy">
        <p lang="en" data-language-content="en">
          An archive of installations, moving-image works, and interactive systems.
          Each project examines how sound, material, technology, and site are brought
          into relation through embodied experience.
        </p>
        <p lang="ko" data-language-content="ko">
          설치, 영상, 그리고 인터랙티브 시스템으로 구성된 작업 아카이브. 각 프로젝트는
          신체적 경험을 매개로 소리, 물질, 기술, 장소가 맺는 관계를 탐구한다.
        </p>
      </div>
    </header>

    {/* 재료 필터 — 같은 재료를 쓴 작품끼리 회로처럼 이어 보여 준다 */}
    {/* 두 축을 한 줄에 섞으면 "구리 4"와 "개인전 5"가 같은 종류로 보인다.
        재료(무엇으로 만들었는가)와 전시 형태(어떻게 보였는가)는 줄을 나눈다. */}
    {/* 모바일에서는 이 wrapper가 두 축을 한 줄짜리 스크롤 바로 합친다.
        같은 모양 알약이 위는 스크롤·아래는 두 개짜리 짧은 줄로 갈리면
        의도한 두 축이 아니라 깨진 격자로 읽힌다 (아래 filter-bar 참조). */}
    <div class="filter-bar">
      {/* 축은 재료보다 앞에 온다 — 무엇으로 만들었는가보다 신호가 어느 단계에 있는가가 먼저다 */}
      {axisCounts.length > 0 && (
        <nav class="material-filter axis-filter" aria-label="Filter by stage">
          {axisCounts.map((a) => (
            <a href={`/works/?axis=${a.id}`} data-axis={a.id}>
              <span data-language-content="en">{a.en}</span><span data-language-content="ko" lang="ko">{a.ko}</span>
              <span class="mf-n">{a.count}</span>
            </a>
          ))}
        </nav>
      )}
      <nav class="material-filter" aria-label="Filter by material">
        <a href="/works/" class="mf-all" data-material="">All works <span class="mf-n">{works.length}</span></a>
        {
          materialCounts.map((m) => (
            <a href={`/works/?material=${m.id}`} data-material={m.id}>
              {m.en} <span class="mf-n">{m.count}</span>
            </a>
          ))
        }
      </nav>
      {showCounts.length > 0 && (
        <nav class="material-filter show-filter" aria-label="Filter by exhibition format">
          {showCounts.map((x) => (
            <a href={`/works/?show=${x.id}`} data-show={x.id}>
              {x.en} <span class="mf-n">{x.count}</span>
            </a>
          ))}
        </nav>
      )}
    </div>

    <section class="archive-list" aria-label="Works by year">
      <div class="archive-head" aria-hidden="true"><span>WORKS</span><span>YEAR</span></div>
      <ol id="work-list">
        {works.map((work) => (
          <li data-materials={work.data.materials.join(" ")} data-axes={work.data.axes.join(" ")} data-show={work.data.showType || ""} data-slug={work.slug}>
            <a href={`/works/${work.slug}`}>
              <time>{work.data.year}</time><span>{work.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mf-empty" id="mf-empty" hidden>No works with this material.</p>
    </section>
  </main>

  <SeenTracker />
</Base>

<script is:inline>

  /* 재료 필터 — 정적 사이트라 쿼리 파라미터를 브라우저에서 해석한다.
     페이지 이동 없이 상태만 바꾸므로 뒤로 가기도 동작해야 한다. */
  ;(function () {
    var list = document.getElementById("work-list")
    var nav = document.querySelector(".material-filter")
    var empty = document.getElementById("mf-empty")
    if (!list || !nav) return
    var items = Array.prototype.slice.call(list.querySelectorAll("li"))
    /* 두 축(재료 / 전시 형태)의 알약을 모두 모은다. 한 번에 하나만 걸리게
       해 "구리이면서 개인전" 같은 교집합을 만들지 않는다 — 열두 점짜리
       아카이브에서 교집합은 대개 0이나 1이라 길이 막힌다. */
    var navs = Array.prototype.slice.call(document.querySelectorAll(".material-filter"))
    var links = []
    navs.forEach(function (n) {
      links = links.concat(Array.prototype.slice.call(n.querySelectorAll("a")))
    })

    function apply(kind, value) {
      var shown = 0
      items.forEach(function (li) {
        var hit
        if (!value) hit = true
        else if (kind === "show") hit = li.getAttribute("data-show") === value
        else if (kind === "axis") hit = (li.getAttribute("data-axes") || "").split(" ").indexOf(value) !== -1
        else hit = (li.getAttribute("data-materials") || "").split(" ").indexOf(value) !== -1
        li.hidden = !hit
        if (hit) shown++
      })
      // 필터가 걸린 동안에만 트레이스를 그린다
      list.classList.toggle("is-tracing", !!value)
      links.forEach(function (a) {
        var av = a.getAttribute("data-show") !== null
          ? { k: "show", v: a.getAttribute("data-show") }
          : a.getAttribute("data-axis") !== null
            ? { k: "axis", v: a.getAttribute("data-axis") }
            : { k: "material", v: a.getAttribute("data-material") || "" }
        var on = value ? (av.k === kind && av.v === value) : av.v === ""
        a.setAttribute("aria-current", on ? "true" : "false")
      })
      if (empty) empty.hidden = shown !== 0
    }

    function fromURL() {
      var q = new URLSearchParams(window.location.search)
      var sh = q.get("show")
      if (sh) return ["show", sh]
      var ax = q.get("axis")
      if (ax) return ["axis", ax]
      return ["material", q.get("material") || ""]
    }
    apply.apply(null, fromURL())

    links.forEach(function (a) {
      a.addEventListener("click", function (e) {
        // 같은 페이지 안에서의 상태 변경 — 전체 리로드를 피한다
        e.preventDefault()
        var isShow = a.getAttribute("data-show") !== null
        var isAxis = a.getAttribute("data-axis") !== null
        var kind = isShow ? "show" : isAxis ? "axis" : "material"
        var v = (isShow ? a.getAttribute("data-show") : isAxis ? a.getAttribute("data-axis") : a.getAttribute("data-material")) || ""
        history.pushState({ kind: kind, value: v }, "", v ? "/works/?" + kind + "=" + v : "/works/")
        apply(kind, v)
      })
    })
    window.addEventListener("popstate", function () { apply.apply(null, fromURL()) })
    window.__hyApplyMaterial = function (m) { apply("material", m) }
  })()

</script>

<style>
  .works-archive { margin: var(--desktop-header-clearance) 40px 100px var(--desktop-content-x); max-width: var(--content-w); }
  .archive-intro { max-width: 650px; margin: 0 0 84px; }
  .eyebrow { margin: 0; font-size: var(--fs-2xs); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  h1 { margin: 8px 0 16px; font-size: var(--fs-display); font-weight: 300; line-height: 1.15; }
  /* 한 번에 한 언어만 보이므로 단을 나누지 않는다 — 본문이 제 폭을 되찾는다 */
  .intro-copy { display: block; }
  .intro-copy p { margin: 0; padding-top: 12px; border-top: 1px solid var(--text); font-size: var(--fs-body); line-height: 1.8; color: var(--text-2); }
  .intro-copy p[lang="ko"] { line-height: 1.85; }
    /* display를 지정한 요소는 [hidden]이 무시되므로 명시적으로 되돌린다 */
  [hidden] { display: none !important; }


  /* 재료 필터 바 */
  .material-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin: 0 0 10px;
  }
  /* 다른 축이므로 줄을 나누고, 마지막 줄이 목록과 거리를 갖는다 */
  .show-filter { margin-bottom: 26px; }
  .material-filter a {
    /* 칩은 도구다 — 자기가 거르는 콘텐츠(작품 제목 18)보다 조용해야 한다.
       15로 올려 봤더니 모바일에서 필터가 목록만큼 소리쳤다. 13으로, 대신
       모바일과 데스크톱을 같은 13으로 묶어 breakpoint 사이 흔들림은 없앤다. */
    font-size: var(--fs-xs);
    line-height: 1;
    padding: 6px 11px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text-2);
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  /* 전시 형태는 재료가 아니다 — 파선으로 축을 가른다. 이 규칙은 반드시
     .material-filter a의 border 단축 속성보다 뒤에 와야 한다: 특이도가 같아
     앞에 두면 단축 속성이 border-style을 solid로 되돌린다(그래서 그동안
     파선이 한 번도 그려지지 않았다). 한 줄로 합친 모바일에서는 이 파선이
     두 축을 가르는 유일한 표시다. */
  .show-filter a { border-style: dashed; }
  .material-filter a:hover { border-color: var(--hover); color: var(--hover); }
  .material-filter a[aria-current="true"] {
    border-color: var(--text);
    background: var(--text);
    color: var(--surface);
  }
  .mf-n { color: var(--text-4); margin-left: 3px; }
  .material-filter a[aria-current="true"] .mf-n { color: var(--line-2); }
  .mf-empty { font-size: var(--fs-sm); color: var(--text-4); padding: 24px 2px; }

  ol { margin: 0; padding: 0; list-style: none; }

  /* 트레이스 — 필터가 걸린 동안 남은 항목들을 한 회로로 잇는다.
     구리선을 흑백 톤 안에서 표현: 얇은 수직선 + 각 항목의 접점. */
  #work-list.is-tracing { position: relative; padding-left: 22px; }
  #work-list.is-tracing li { position: relative; }
  #work-list.is-tracing li::before {
    content: "";
    position: absolute;
    left: -14px;
    top: -1px;
    bottom: -1px;
    width: 1px;
    background: var(--line-2);
  }
  /* 첫 항목은 위쪽, 마지막 항목은 아래쪽 선을 잘라 회로의 끝을 만든다 */
  #work-list.is-tracing li:not([hidden]):first-of-type::before { top: 50%; }
  #work-list.is-tracing li::after {
    content: "";
    position: absolute;
    left: -17px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  #work-list.is-tracing li:hover::before,
  #work-list.is-tracing li:hover::after { border-color: var(--hover); background: var(--hover); }
  #work-list.is-tracing li:hover::before { background: var(--hover); }

  /* 방문의 흔적 — 시아노타입(감광지) 인용. 본 작품은 접점이 "노출되어" 채워진다.
     세션 한정이라 탭을 닫으면 사라진다. */
  #work-list.is-tracing li.is-seen::after { background: var(--text-3); border-color: var(--text-3); }
  /* 필터가 없을 때는 연도 앞에 작은 흔적만 남긴다 — 목록의 조용함을 해치지 않는다.
     필터 중에는 접점이 그 역할을 하므로 이중 표시를 피한다. */
  #work-list.is-tracing li.is-seen time::before { display: none; }
  li.is-seen time::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 6px;
    vertical-align: 2px;
    border-radius: 50%;
    background: var(--text-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .material-filter a { transition: none; }
  }
  .archive-head, li a { display: grid; grid-template-columns: minmax(0, 1fr) 66px; gap: 16px; }
  /* 표 머리글은 라벨이다 — 내용(작품 제목 18)보다 조용해야 한다. 18px 볼드로
     두면 머리글이 행보다 크게 소리치고, 같은 역할인 Sound의 머리글(11px 라벨)과도
     어긋난다. 사이트 라벨 문법(11 + 자간 + 회색)을 그대로 따른다. */
  .archive-head { border-top: 1px solid var(--text); border-bottom: 1px solid var(--text); padding: 5px 0 4px; font-size: var(--fs-2xs); letter-spacing: .08em; color: var(--text-3); }
  .archive-head span:last-child { text-align: right; }
  li { border-bottom: 1px solid var(--text-3); }
  li a { align-items: baseline; padding: 5px 0 6px; }
  /* 숫자 열은 고정폭 숫자로 — 비례폭이면 연도마다 폭이 달라 오른쪽 열이 떨린다.
     CV의 연도 열이 이미 쓰는 규칙이다. */
  time { grid-column: 2; grid-row: 1; text-align: right; font-size: var(--fs-sm); font-weight: 300; letter-spacing: 0.025em; font-variant-numeric: tabular-nums; }
  li span { grid-column: 1; grid-row: 1; font-size: var(--fs-body); font-weight: 300; line-height: 1.16; letter-spacing: 0.012em; }
  li a:hover { color: var(--hover); }
  @media (max-width: 700px) {
    .works-archive { margin: 24px 16px 80px; }
    .archive-intro { margin-bottom: 54px; }
    h1 { font-size: clamp(25px, 7vw, 32px); line-height: 1.22; }
    .intro-copy { grid-template-columns: 1fr; gap: 0; }
    .intro-copy p { margin: 0 0 26px; padding-top: 10px; font-size: var(--fs-sm); line-height: 1.78; }
    .intro-copy p[lang="ko"] { line-height: 1.85; }
    /* 칩 13개가 5줄로 쌓이면 159px, 첫 화면의 절반 가까이를 필터가 먹고 작품은
       두 개쯤 보이고 끝난다. 모바일에서 정적인 칩 벽은 쓰지 않는 형태다 —
       한 줄로 두고 옆으로 밀게 한다. 높이가 한 줄로 고정되고, 필터가 있다는
       사실도 계속 보인다(버튼 뒤로 숨기면 한 번 더 눌러야 알 수 있다).
       화면 끝까지 흘려 보내 "더 있다"가 잘린 칩으로 드러나게 한다. */
    /* 두 nav를 한 줄짜리 스크롤 바 하나로 합친다. display: contents로 nav의
       상자를 없애 모든 알약이 filter-bar의 직접 항목이 되게 한다 — 두 축은
       테두리(실선 / 파선)로 이미 갈려 있으므로 줄을 나눌 필요가 없다.
       한 줄이 되면 잘린 알약이 "옆에 더 있다"는 신호로 제 역할을 하고,
       두 개짜리 짧은 줄과 그 오른쪽 빈 공간도 사라진다. */
    .filter-bar {
      display: flex;
      flex-wrap: nowrap;
      gap: 8px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      margin-inline: -16px;
      /* 칩 바깥으로 넓힌 탭 영역(::after)이 잘리지 않게 위아래를 비워 둔다 —
         overflow-x를 auto로 두면 세로도 함께 잘린다. */
      padding: 7px 16px;
      /* 필터 묶음과 목록 사이 (패딩 7을 뺀 값 = 눈에 보이는 26px) */
      margin-bottom: 19px;
      /* 가로 스크롤 막대는 자리만 차지하고 손가락에게는 쓸모가 없다 */
      scrollbar-width: none;
    }
    .filter-bar::-webkit-scrollbar { display: none; }
    .filter-bar > nav { display: contents; }
    .show-filter { margin-bottom: 0; }
    /* 알약 30px에 글자 13 — 필터는 도구라 콘텐츠(제목 18)보다 작게 앉는다.
       손가락이 닿는 영역은 가상 요소로 위아래 7px씩 넓혀 44px를 유지한다.
       보이는 크기와 눌리는 크기의 분리는 Material이 32dp 칩에 쓰는 방법. */
    .material-filter a {
      flex: 0 0 auto;      /* 좁은 화면에서 글자가 접히지 않게 */
      /* grid로 두면 라벨과 개수가 세로로 쌓인다 — 둘은 한 줄이어야 한다 */
      display: flex;
      align-items: center;
      white-space: nowrap;
      position: relative;
      min-height: 30px;
      padding-block: 0;
    }
    .material-filter a::after {
      content: "";
      position: absolute;
      inset: -7px 0;
    }
    .archive-head, li a { grid-template-columns: minmax(0, 1fr) 48px; gap: 8px; }
    /* 아카이브에서 가장 중요한 링크인데 32px로 이 페이지에서 가장 작았다.
       구분선이 있는 목록 행이라 44px가 늘어져 보이지도 않는다.
       높이는 패딩으로 채운다 — center 정렬로 채우면 제목(18px)과 연도(13px)의
       베이스라인이 2.3px 어긋난다. 크기가 다른 글자가 한 줄에 서는 곳은
       베이스라인 정렬이 조판의 기본이고, 데스크톱도 그렇게 서 있다. */
    li a { align-items: baseline; padding: 10px 0; }
    /* 머리글은 라벨(11) — 모바일에서 키울 이유가 없다. 기본 규칙을 그대로 쓴다 */
    time { font-size: var(--fs-xs); }
    li span { font-size: var(--fs-body); }
  }
</style>
