---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import { MATERIALS } from "../../data/materials"
import SeenTracker from "../../components/SeenTracker.astro"

const works = await getCollection("works", ({ data }) => !data.draft)
works.sort((a, b) => {
  const sortYear = (year: string) => Math.max(...(year.match(/\d{4}/g) ?? ["0"]).map(Number))
  const byYear = sortYear(b.data.year) - sortYear(a.data.year)
  return byYear || (a.data.order ?? 0) - (b.data.order ?? 0)
})

// 재료별 작품 수 — 0개인 재료는 필터 바에 띄우지 않는다
const materialCounts = MATERIALS.map((m) => ({
  ...m,
  count: works.filter((w) => w.data.materials.includes(m.id)).length,
})).filter((m) => m.count > 0)
---

<Base title="Works — HWANYUN" current="works">
  <main class="works-archive" data-language="en">
    <header class="archive-intro">
      <p class="eyebrow">WORK ARCHIVE</p>
      <h1>Works</h1>
      <div class="archive-language-switch" role="group" aria-label="Archive introduction language">
        <button type="button" data-language-choice="en" aria-pressed="true">EN</button>
        <button type="button" data-language-choice="ko" aria-pressed="false">KO</button>
      </div>
      <div class="intro-copy">
        <p lang="en" data-language-content="en">
          An archive of installations, moving-image works, and interactive systems.
          Each project examines how sound, material, technology, and site are brought
          into relation through embodied experience.
        </p>
        <p lang="ko" data-language-content="ko">
          설치, 영상, 그리고 인터랙티브 시스템으로 구성된 작업 아카이브. 각 프로젝트는
          신체적 경험을 매개로 소리, 물질, 기술, 장소가 맺는 관계를 탐구한다.
        </p>
      </div>
    </header>

    {/* 뷰 전환 — 정연한 목록 ↔ 작품이 입자로 흩어지는 필드.
        홈 히어로의 입자 시스템과 같은 언어의 확장이고,
        Atypical Circuit의 "질서 ↔ 붕괴"라는 주제 자체이기도 하다. */}
    <div class="view-toggle" role="group" aria-label="View mode">
      <button type="button" data-view="list" aria-pressed="true">List</button>
      <button type="button" data-view="field" aria-pressed="false">Field</button>
    </div>

    {/* 재료 필터 — 같은 재료를 쓴 작품끼리 회로처럼 이어 보여 준다 */}
    <nav class="material-filter" aria-label="Filter by material">
      <a href="/works/" class="mf-all" data-material="">All works <span class="mf-n">{works.length}</span></a>
      {
        materialCounts.map((m) => (
          <a href={`/works/?material=${m.id}`} data-material={m.id}>
            {m.en} <span class="mf-n">{m.count}</span>
          </a>
        ))
      }
    </nav>

    <section class="archive-list" aria-label="Works by year">
      <div class="archive-head" aria-hidden="true"><span>WORKS</span><span>YEAR</span></div>
      <ol id="work-list">
        {works.map((work) => (
          <li data-materials={work.data.materials.join(" ")} data-slug={work.slug}>
            <a href={`/works/${work.slug}`}>
              <time>{work.data.year}</time><span>{work.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mf-empty" id="mf-empty" hidden>이 재료를 쓴 작품이 없습니다.</p>
      {/* 필드 뷰 — 같은 li 데이터를 캔버스로 다시 그린다.
          목록 DOM은 그대로 두므로 접근성·검색·필터 로직이 하나로 유지된다. */}
      <div class="field-view" id="field-view" hidden>
        <canvas id="field-canvas"></canvas>
        <a class="field-label" id="field-label" href="#" hidden></a>
      </div>
    </section>
  </main>

  <SeenTracker />
</Base>

<script is:inline>
  ;(function () {
    var archive = document.querySelector(".works-archive")
    if (!archive) return
    var buttons = Array.prototype.slice.call(archive.querySelectorAll("[data-language-choice]"))
    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        var language = button.getAttribute("data-language-choice")
        if (!language) return
        archive.setAttribute("data-language", language)
        buttons.forEach(function (item) { item.setAttribute("aria-pressed", String(item === button)) })
      })
    })
  })()

  /* 재료 필터 — 정적 사이트라 쿼리 파라미터를 브라우저에서 해석한다.
     페이지 이동 없이 상태만 바꾸므로 뒤로 가기도 동작해야 한다. */
  ;(function () {
    var list = document.getElementById("work-list")
    var nav = document.querySelector(".material-filter")
    var empty = document.getElementById("mf-empty")
    if (!list || !nav) return
    var items = Array.prototype.slice.call(list.querySelectorAll("li"))
    var links = Array.prototype.slice.call(nav.querySelectorAll("a"))

    function apply(material) {
      var shown = 0
      items.forEach(function (li) {
        var mats = (li.getAttribute("data-materials") || "").split(" ")
        var hit = !material || mats.indexOf(material) !== -1
        li.hidden = !hit
        if (hit) shown++
      })
      // 필터가 걸린 동안에만 트레이스를 그린다
      list.classList.toggle("is-tracing", !!material)
      links.forEach(function (a) {
        a.setAttribute("aria-current", a.getAttribute("data-material") === material ? "true" : "false")
      })
      if (empty) empty.hidden = shown !== 0
    }

    function fromURL() {
      return new URLSearchParams(window.location.search).get("material") || ""
    }
    apply(fromURL())

    links.forEach(function (a) {
      a.addEventListener("click", function (e) {
        // 같은 페이지 안에서의 상태 변경 — 전체 리로드를 피한다
        e.preventDefault()
        var m = a.getAttribute("data-material") || ""
        history.pushState({ material: m }, "", m ? "/works/?material=" + m : "/works/")
        apply(m)
      })
    })
    window.addEventListener("popstate", function () { apply(fromURL()) })
    window.__hyApplyMaterial = apply
  })()

  /* 필드 뷰 — 작품이 입자 군집으로 흩어져 연도 축에 재정렬된다.
     홈 히어로의 입자 시스템과 같은 언어. 목록 DOM을 원본으로 삼아 다시 그리므로
     검색·필터·접근성 로직은 목록 쪽 하나만 유지하면 된다. */
  ;(function () {
    var wrap = document.getElementById("field-view")
    var canvas = document.getElementById("field-canvas")
    var label = document.getElementById("field-label")
    var list = document.getElementById("work-list")
    var toggle = document.querySelector(".view-toggle")
    if (!wrap || !canvas || !list || !toggle) return
    var ctx = canvas.getContext("2d")
    if (!ctx) return

    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    var items = Array.prototype.slice.call(list.querySelectorAll("li"))
    var W = 0, H = 0, dpr = 1, raf = 0, active = false
    var hoverIdx = -1
    var mx = -9999, my = -9999

    // 작품 하나 = 입자 군집 하나. 연도가 x축, 재료 수가 군집 크기를 정한다.
    var nodes = items.map(function (li) {
      var year = parseInt((li.querySelector("time") || {}).textContent, 10) || 2000
      var mats = (li.getAttribute("data-materials") || "").split(" ").filter(Boolean)
      return {
        li: li,
        slug: li.getAttribute("data-slug"),
        title: (li.querySelector("span") || {}).textContent || "",
        year: year,
        mats: mats,
        seen: li.classList.contains("is-seen"),
        n: 26 + mats.length * 14, // 재료가 많을수록 촘촘하다
        x: 0, y: 0, r: 0,
        pts: [],
      }
    })
    var years = nodes.map(function (n) { return n.year })
    var minY = Math.min.apply(null, years), maxY = Math.max.apply(null, years)

    function layout() {
      var rect = wrap.getBoundingClientRect()
      W = Math.max(320, Math.round(rect.width))
      H = Math.round(Math.min(620, Math.max(380, window.innerHeight * 0.62)))
      dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = W * dpr
      canvas.height = H * dpr
      canvas.style.width = W + "px"
      canvas.style.height = H + "px"
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)

      var visible = nodes.filter(function (n) { return !n.li.hidden })
      var padX = 54, padY = 46
      var span = Math.max(1, maxY - minY)
      // 같은 연도가 겹치지 않게 세로로 분산한다
      var byYear = {}
      visible.forEach(function (n) { (byYear[n.year] = byYear[n.year] || []).push(n) })
      visible.forEach(function (n) {
        var group = byYear[n.year]
        var idx = group.indexOf(n)
        var t = (n.year - minY) / span
        n.x = padX + t * (W - padX * 2)
        n.y = padY + ((idx + 0.5) / group.length) * (H - padY * 2)
        n.r = 16 + n.mats.length * 4
        n.pts = []
        for (var i = 0; i < n.n; i++) {
          // 황금각 배치 — 히어로 구체와 같은 분포 방식
          var a = i * 2.399963229728653
          var rr = n.r * Math.sqrt((i + 0.5) / n.n)
          n.pts.push({ dx: Math.cos(a) * rr, dy: Math.sin(a) * rr, ph: i * 0.7 })
        }
      })
    }

    function draw(time) {
      raf = 0
      ctx.clearRect(0, 0, W, H)
      var visible = nodes.filter(function (n) { return !n.li.hidden })
      var t = reduce ? 0 : time * 0.0006
      var newHover = -1

      visible.forEach(function (n) {
        var d = Math.hypot(mx - n.x, my - n.y)
        var near = d < n.r + 22
        if (near) newHover = nodes.indexOf(n)
        // 가까울수록 군집이 조여들고, 멀면 느슨하게 떠 있다 — 근접 반응과 같은 문법
        var tighten = near ? 0.55 : 1
        n.pts.forEach(function (p) {
          var wob = reduce ? 0 : Math.sin(t + p.ph) * 1.6
          var x = n.x + p.dx * tighten + wob
          var y = n.y + p.dy * tighten + wob * 0.6
          ctx.beginPath()
          ctx.arc(x, y, near ? 1.5 : 1.1, 0, Math.PI * 2)
          ctx.fillStyle = near ? "rgba(0,0,0,.85)" : n.seen ? "rgba(0,0,0,.5)" : "rgba(0,0,0,.28)"
          ctx.fill()
        })
      })

      if (newHover !== hoverIdx) {
        hoverIdx = newHover
        if (hoverIdx === -1) {
          label.hidden = true
          canvas.style.cursor = ""
        } else {
          var n = nodes[hoverIdx]
          label.hidden = false
          label.textContent = n.title + " (" + n.year + ")"
          label.setAttribute("href", "/works/" + n.slug)
          label.style.left = Math.round(n.x) + "px"
          label.style.top = Math.round(n.y - n.r - 14) + "px"
          canvas.style.cursor = "pointer"
        }
      }
      if (active && !reduce) raf = requestAnimationFrame(draw)
    }

    function tick() { if (!raf && active) raf = requestAnimationFrame(draw) }

    canvas.addEventListener("pointermove", function (e) {
      var r = canvas.getBoundingClientRect()
      mx = e.clientX - r.left
      my = e.clientY - r.top
      tick()
    })
    canvas.addEventListener("pointerleave", function () { mx = my = -9999; tick() })
    canvas.addEventListener("click", function () {
      if (hoverIdx !== -1) window.location.href = "/works/" + nodes[hoverIdx].slug
    })

    function setView(mode) {
      active = mode === "field"
      wrap.hidden = !active
      list.hidden = active
      document.querySelector(".archive-head").hidden = active
      Array.prototype.forEach.call(toggle.querySelectorAll("button"), function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-view") === mode))
      })
      if (active) { layout(); tick(); if (reduce) requestAnimationFrame(draw) }
      else if (raf) { cancelAnimationFrame(raf); raf = 0 }
    }

    Array.prototype.forEach.call(toggle.querySelectorAll("button"), function (b) {
      b.addEventListener("click", function () { setView(b.getAttribute("data-view")) })
    })
    window.addEventListener("resize", function () { if (active) { layout(); tick() } })

    // 재료 필터가 바뀌면 필드도 다시 배치한다
    var origApply = window.__hyApplyMaterial
    if (origApply) {
      window.__hyApplyMaterial = function (m) {
        origApply(m)
        nodes.forEach(function (n) { n.seen = n.li.classList.contains("is-seen") })
        if (active) { layout(); tick() }
      }
      document.querySelectorAll(".material-filter a").forEach(function (a) {
        a.addEventListener("click", function () {
          setTimeout(function () { if (active) { layout(); tick() } }, 0)
        })
      })
    }
  })()
</script>

<style>
  .works-archive { margin: var(--desktop-header-clearance) 40px 100px var(--desktop-content-x); max-width: var(--content-w); }
  .archive-intro { max-width: 650px; margin: 0 0 84px; }
  .eyebrow { margin: 0; font-size: var(--fs-2xs); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  h1 { margin: 8px 0 16px; font-size: var(--fs-display); font-weight: 300; line-height: 1.15; }
  .intro-copy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3%; }
  .intro-copy p { margin: 0; padding-top: 12px; border-top: 1px solid var(--text); font-size: var(--fs-body); line-height: 1.8; color: var(--text-2); }
  .intro-copy p[lang="ko"] { line-height: 1.85; }
  .archive-language-switch { display: none; }
  /* display를 지정한 요소는 [hidden]이 무시되므로 명시적으로 되돌린다 */
  [hidden] { display: none !important; }

  /* 뷰 전환 */
  .view-toggle { display: inline-flex; gap: 4px; margin: 0 0 14px; border: 1px solid var(--line-2); }
  .view-toggle button {
    padding: 6px 14px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-3);
    font: 400 var(--fs-xs)/1 var(--sans);
    letter-spacing: 0.04em;
  }
  .view-toggle button[aria-pressed="true"] { background: var(--text); color: var(--surface); }

  /* 필드 뷰 — 작품이 입자 군집으로 흩어져 연도 축에 재정렬된다 */
  .field-view { position: relative; margin-top: 6px; }
  #field-canvas { display: block; width: 100%; }
  .field-label {
    position: absolute;
    transform: translate(-50%, -100%);
    padding: 4px 9px;
    background: var(--text);
    color: var(--surface);
    font-size: var(--fs-xs);
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }

  /* 재료 필터 바 */
  .material-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin: 0 0 26px;
  }
  .material-filter a {
    font-size: var(--fs-xs);
    line-height: 1;
    padding: 6px 11px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text-2);
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }
  .material-filter a:hover { border-color: var(--hover); color: var(--hover); }
  .material-filter a[aria-current="true"] {
    border-color: var(--text);
    background: var(--text);
    color: var(--surface);
  }
  .mf-n { color: var(--text-4); margin-left: 3px; }
  .material-filter a[aria-current="true"] .mf-n { color: var(--line-2); }
  .mf-empty { font-size: var(--fs-sm); color: var(--text-4); padding: 24px 2px; }

  ol { margin: 0; padding: 0; list-style: none; }

  /* 트레이스 — 필터가 걸린 동안 남은 항목들을 한 회로로 잇는다.
     구리선을 흑백 톤 안에서 표현: 얇은 수직선 + 각 항목의 접점. */
  #work-list.is-tracing { position: relative; padding-left: 22px; }
  #work-list.is-tracing li { position: relative; }
  #work-list.is-tracing li::before {
    content: "";
    position: absolute;
    left: -14px;
    top: -1px;
    bottom: -1px;
    width: 1px;
    background: var(--line-2);
  }
  /* 첫 항목은 위쪽, 마지막 항목은 아래쪽 선을 잘라 회로의 끝을 만든다 */
  #work-list.is-tracing li:not([hidden]):first-of-type::before { top: 50%; }
  #work-list.is-tracing li::after {
    content: "";
    position: absolute;
    left: -17px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  #work-list.is-tracing li:hover::before,
  #work-list.is-tracing li:hover::after { border-color: var(--hover); background: var(--hover); }
  #work-list.is-tracing li:hover::before { background: var(--hover); }

  /* 방문의 흔적 — 시아노타입(감광지) 인용. 본 작품은 접점이 "노출되어" 채워진다.
     세션 한정이라 탭을 닫으면 사라진다. */
  #work-list.is-tracing li.is-seen::after { background: var(--text-3); border-color: var(--text-3); }
  /* 필터가 없을 때는 연도 앞에 작은 흔적만 남긴다 — 목록의 조용함을 해치지 않는다.
     필터 중에는 접점이 그 역할을 하므로 이중 표시를 피한다. */
  #work-list.is-tracing li.is-seen time::before { display: none; }
  li.is-seen time::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 6px;
    vertical-align: 2px;
    border-radius: 50%;
    background: var(--text-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .material-filter a { transition: none; }
  }
  .archive-head, li a { display: grid; grid-template-columns: minmax(0, 1fr) 66px; gap: 16px; }
  .archive-head { border-top: 1px solid var(--text); border-bottom: 1px solid var(--text); padding: 5px 0 4px; font-size: var(--fs-body); font-weight: 500; letter-spacing: 0.025em; }
  .archive-head span:last-child { text-align: right; }
  li { border-bottom: 1px solid var(--text-3); }
  li a { align-items: baseline; padding: 5px 0 6px; }
  time { grid-column: 2; grid-row: 1; text-align: right; font-size: var(--fs-sm); font-weight: 300; letter-spacing: 0.025em; }
  li span { grid-column: 1; grid-row: 1; font-size: var(--fs-body); font-weight: 300; line-height: 1.16; letter-spacing: 0.012em; }
  li a:hover { color: var(--hover); }
  @media (max-width: 700px) {
    .works-archive { margin: 24px 16px 80px; }
    .archive-intro { margin-bottom: 54px; }
    h1 { font-size: clamp(25px, 7vw, 32px); line-height: 1.22; }
    .archive-language-switch { display: inline-flex; align-items: stretch; gap: 4px; margin: 0 0 12px; border: 1px solid var(--line-2); }
    .archive-language-switch button { display: block; flex: 0 0 38px; min-width: 38px; min-height: 28px; padding: 6px 8px; border: 0; border-radius: 0; color: var(--text-3); background: transparent; font: 500 11px/1 var(--sans); letter-spacing: .08em; }
    .archive-language-switch button[aria-pressed="true"] { color: var(--surface); background: var(--text); }
    .intro-copy { grid-template-columns: 1fr; gap: 0; }
    .intro-copy p { margin: 0 0 26px; padding-top: 10px; font-size: var(--fs-sm); line-height: 1.78; }
    .intro-copy p[lang="ko"] { line-height: 1.85; }
    .works-archive[data-language="en"] [data-language-content="ko"],
    .works-archive[data-language="ko"] [data-language-content="en"] { display: none; }
    .archive-head, li a { grid-template-columns: minmax(0, 1fr) 48px; gap: 8px; }
    .archive-head { font-size: var(--fs-sm); }
    time { font-size: var(--fs-xs); }
    li span { font-size: var(--fs-body); }
  }
</style>
