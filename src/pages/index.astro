---
import Base from "../layouts/Base.astro"
import SiteMenu from "../components/SiteMenu.astro"
import WorkGrid from "../components/WorkGrid.astro"
import { getCollection } from "astro:content"

// 홈 하이라이트용 이벤트 데이터 (가장 가까운 미래 일정은 클라이언트에서 오늘 기준으로 선택)
const upEvents = (await getCollection("events", ({ data }) => !data.draft))
  .map((e) => ({ slug: e.slug, title: e.data.title, start: e.data.dateStart, end: e.data.dateEnd || e.data.dateStart, venue: e.data.venue, city: e.data.city }))
  .sort((a, b) => a.start.localeCompare(b.start))
---

<Base title="HWANYUN" chrome="dark">
  <SiteMenu slot="menu" variant="hero" />

  <section class="hero" aria-labelledby="hero-title">
    <canvas id="particle-canvas" class="hero__field" aria-hidden="true"></canvas>
    <h1 id="hero-title" class="sr-only">HWANYUN</h1>
    <a id="upcoming-ticker" class="upcoming-ticker" href="/events/" hidden aria-label="Upcoming events"><span class="ut-list" id="ut-track"></span></a>
  </section>
  <script type="application/json" id="ev-data" is:inline set:html={JSON.stringify(upEvents)}></script>
  <script is:inline>
    ;(function () {
      var el = document.getElementById("upcoming-ticker")
      var track = document.getElementById("ut-track")
      var d = document.getElementById("ev-data")
      if (!el || !track || !d) return
      var evs
      try { evs = JSON.parse(d.textContent || "[]") } catch (e) { return }
      function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") }
      var today = new Date(); today.setHours(0, 0, 0, 0)
      var M = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
      var nowItems = []   // 진행 중 (시작함 · 아직 안 끝남)
      var soonItems = []  // 예정 (아직 시작 전)
      for (var i = 0; i < evs.length; i++) {
        var end = new Date(evs[i].end + "T23:59:59")
        if (isNaN(end) || end < today) continue
        var start = new Date(evs[i].start + "T00:00:00")
        var s = evs[i].start.split("-").map(Number)
        var date = s[2] + " " + M[s[1] - 1]
        var where = [evs[i].venue, evs[i].city].filter(Boolean).join(", ")
        var item = esc(evs[i].title) + '<span class="ut-dim"> · ' + date + (where ? " · " + esc(where) : "") + "</span>"
        if (!isNaN(start) && start <= today) nowItems.push(item)
        else soonItems.push(item)
      }
      if (!nowItems.length && !soonItems.length) return
      // 흐르는 티커는 글자를 쫓게 만든다. 좌측 하단에 고정해 한눈에 읽히게 둔다.
      var html = ""
      if (nowItems.length) {
        html += '<span class="ut-tag ut-tag-now">NOW ON</span>'
        html += nowItems.map(function (s) { return '<span class="ut-row">' + s + "</span>" }).join("")
      }
      if (soonItems.length) {
        html += '<span class="ut-tag">UPCOMING</span>'
        html += soonItems.map(function (s) { return '<span class="ut-row">' + s + "</span>" }).join("")
      }
      track.innerHTML = html
      el.hidden = false
    })()
  </script>

  <script is:inline>
    /* 히어로 메뉴는 검은 히어로 위에 고정된다. 스크롤해 작품 그리드로 넘어가면
       흰 배경 위에 밝은 글자가 남아 읽히지 않고 작품도 가린다 — 그때는 숨긴다.
       (그리드 자체 메뉴는 데스크톱 전용이고, 모바일에서는 상단으로 되돌아가면 다시 나온다) */
    ;(function () {
      var menu = document.getElementById("home-hero-menu")
      var hero = document.querySelector(".hero")
      if (!menu || !hero || !("IntersectionObserver" in window)) return
      if (!window.matchMedia("(max-width: 700px)").matches) return
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            menu.classList.toggle("is-past-hero", e.intersectionRatio < 0.12)
          })
        },
        { threshold: [0, 0.12, 1] }
      )
      io.observe(hero)
    })()
  </script>

  <section id="works" class="work-archive" aria-label="Selected works">
    <WorkGrid current="home" />
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>(".hero")
    const canvas = document.querySelector<HTMLCanvasElement>("#particle-canvas")
    const context = canvas?.getContext("2d")

    if (hero && canvas && context) {
      type Particle = {
        x: number; y: number; vx: number; vy: number
        sphereX: number; sphereY: number; sphereZ: number
        targetX: number; targetY: number
      }
      let particles: Particle[] = []
      let isInside = false
      let mobileTapStart: { x: number; y: number } | null = null
      let width = 0
      let height = 0
      let pixelRatio = 1
      // 이름으로 모인 뒤의 커서 반응 — 그리드 타일과 같은 "거리=입력" 문법을 히어로까지
      let pointerX = 0
      let pointerY = 0
      let hasPointer = false
      let nameBounds = { minX: 0, minY: 0, maxX: 0, maxY: 0 }
      // 반경·세기는 워드마크 크기에 비례한다 — 고정값을 쓰면 글자가 작은 모바일에서
      // 이름 전체가 날아간다. 기준은 데스크톱(글자 높이 ≈ 93px, 반경 128 / 세기 2.6).
      const REPEL_RADIUS_RATIO = 1.38
      const REPEL_FORCE_RATIO = .028
      let repelRadius = 128
      // 접촉점에서의 최대 밀림 = FORCE / 스프링계수(.025). 감쇠 안에서 더하므로
      // 값이 커져도 발산하지 않고 밀림 폭만 늘어난다.
      let repelForce = 2.6
      const isMobile = window.matchMedia("(max-width: 700px)").matches
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      hero.dataset.particleMode = "sphere"

      const createTargets = () => {
        // 폭·높이가 0인 순간(숨겨진 상태, 첫 레이아웃 전)에 부르면 getImageData가 던진다
        if (width < 1 || height < 1) return []
        const sample = document.createElement("canvas")
        const sampleContext = sample.getContext("2d")!
        sample.width = width
        sample.height = height
        const fontSize = Math.min(width * .145, 180)
        // 사이트에서 가장 큰 타이포그래피가 시스템 폰트여선 안 된다 — 본문과 같은 폰트로
        sampleContext.font = `600 ${fontSize}px "Pretendard Variable", Pretendard, sans-serif`
        sampleContext.textAlign = "center"
        sampleContext.textBaseline = "middle"
        sampleContext.fillStyle = "#fff"
        sampleContext.fillText("HWANYUN", width / 2, height / 2)
        const pixels = sampleContext.getImageData(0, 0, width, height).data
        const targets: Array<[number, number]> = []
        const step = Math.max(3, Math.round(width / 460))
        for (let y = 0; y < height; y += step) {
          for (let x = 0; x < width; x += step) {
            if (pixels[(y * width + x) * 4 + 3] > 0) targets.push([x, y])
          }
        }
        return targets
      }

      const resize = () => {
        const rect = hero.getBoundingClientRect()
        const nextWidth = Math.round(rect.width)
        const nextHeight = Math.round(rect.height)
        // 크기가 그대로면 아무것도 다시 만들지 않는다 — 재구축은 입자를 중앙으로
        // 되돌리므로, 반복 호출되면 이름이 영영 모이지 못한다.
        if (nextWidth === width && nextHeight === height && particles.length) return
        pixelRatio = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2)
        width = nextWidth
        height = nextHeight
        canvas.width = width * pixelRatio
        canvas.height = height * pixelRatio
        canvas.style.width = `${width}px`
        canvas.style.height = `${height}px`
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0)
        const targets = createTargets()
        // 워드마크가 실제로 차지하는 사각형 — 모인 뒤의 판정 영역이 된다
        nameBounds = targets.reduce((box, [x, y]) => ({
          minX: Math.min(box.minX, x), minY: Math.min(box.minY, y),
          maxX: Math.max(box.maxX, x), maxY: Math.max(box.maxY, y),
        }), { minX: width, minY: height, maxX: 0, maxY: 0 })
        const nameHeight = Math.max(1, nameBounds.maxY - nameBounds.minY)
        repelRadius = nameHeight * REPEL_RADIUS_RATIO
        repelForce = nameHeight * REPEL_FORCE_RATIO
        // 모바일에서는 터치 반응성과 안정성을 위해 렌더링 밀도를 낮춘다.
        const count = isMobile
          ? Math.min(1400, Math.max(900, targets.length))
          : Math.min(3200, Math.max(2400, targets.length * 2))
        const previous = particles
        particles = Array.from({ length: count }, (_, index) => {
          const targetIndex = Math.floor(index / count * targets.length)
          const [targetX, targetY] = targets[targetIndex] || [width / 2, height / 2]
          const sphereY = 1 - (index / (count - 1)) * 2
          const sphereRadius = Math.sqrt(1 - sphereY * sphereY)
          const sphereAngle = index * 2.399963229728653
          const sphereX = Math.cos(sphereAngle) * sphereRadius
          const sphereZ = Math.sin(sphereAngle) * sphereRadius
          // 실제로 크기가 바뀐 경우엔 있던 자리에서 이어가게 둔다(창 크기 조절 시 튀지 않게)
          const carried = previous[index]
          return {
            x: carried ? carried.x : width / 2,
            y: carried ? carried.y : height / 2,
            vx: 0, vy: 0,
            sphereX,
            sphereY,
            sphereZ,
            targetX, targetY,
          }
        })
      }

      const draw = (time: number) => {
        context.clearRect(0, 0, width, height)
        const centerX = width / 2
        const centerY = height / 2
        const size = Math.min(width, height)
        const haze = context.createRadialGradient(centerX, centerY, 0, centerX, centerY, size * .5)
        haze.addColorStop(0, "rgba(255, 255, 255, .025)")
        haze.addColorStop(1, "rgba(7, 8, 10, 0)")
        context.fillStyle = haze
        context.fillRect(0, 0, width, height)

        const rotation = time * .00028
        const tilt = -.22
        const cosRotation = Math.cos(rotation)
        const sinRotation = Math.sin(rotation)
        const cosTilt = Math.cos(tilt)
        const sinTilt = Math.sin(tilt)
        const globeRadius = size * .38
        // 데스크톱은 커서가 얹혀 있는 동안, 모바일은 손가락이 닿아 있는 동안
        const repelling = isInside && hasPointer && !reduceMotion

        for (const particle of particles) {
          const rotatedX = particle.sphereX * cosRotation - particle.sphereZ * sinRotation
          const rotatedZ = particle.sphereX * sinRotation + particle.sphereZ * cosRotation
          const rotatedY = particle.sphereY * cosTilt - rotatedZ * sinTilt
          const depth = particle.sphereY * sinTilt + rotatedZ * cosTilt
          const perspective = 2.8 / (3.3 - depth)
          const driftX = centerX + rotatedX * globeRadius * perspective
          const driftY = centerY + rotatedY * globeRadius * perspective
          const destinationX = isInside ? particle.targetX : driftX
          const destinationY = isInside ? particle.targetY : driftY
          // 이름이 모인 뒤에는 커서가 글자를 밀어낸다. 반발은 감쇠 안에서 더해야 한다 —
          // 밖에서 더하면 매 프레임 누적돼 속도가 발산하고 글자가 흩어져 버린다.
          // 스프링은 그대로 살아 있으므로 손을 치우면 글자는 스스로 제 자리로 돌아온다.
          let pushX = 0
          let pushY = 0
          if (repelling) {
            const deltaX = particle.x - pointerX
            const deltaY = particle.y - pointerY
            const distanceSquared = deltaX * deltaX + deltaY * deltaY
            if (distanceSquared < repelRadius * repelRadius) {
              const distance = Math.sqrt(distanceSquared) || .001
              const falloff = 1 - distance / repelRadius
              const push = falloff * falloff * repelForce
              pushX = (deltaX / distance) * push
              pushY = (deltaY / distance) * push
            }
          }
          particle.vx = (particle.vx + (destinationX - particle.x) * (isInside ? .025 : .024) + pushX) * .8
          particle.vy = (particle.vy + (destinationY - particle.y) * (isInside ? .025 : .024) + pushY) * .8
          particle.x += particle.vx
          particle.y += particle.vy
          context.beginPath()
          const pointSize = isInside ? 1.1 : .52 + (depth + 1) * .48
          const brightness = isInside ? .96 : .26 + (depth + 1) * .34
          context.arc(particle.x, particle.y, pointSize, 0, Math.PI * 2)
          context.fillStyle = `rgba(255, 255, 255, ${brightness})`
          context.fill()
        }
        requestAnimationFrame(draw)
      }

      const isWithinGlobe = (event: PointerEvent) => {
        const rect = hero.getBoundingClientRect()
        const x = event.clientX - rect.left - width / 2
        const y = event.clientY - rect.top - height / 2
        return Math.hypot(x, y) < Math.min(width, height) * .48
      }
      // 워드마크는 구체보다 넓다. 구체 안으로 들어가면 모이고, 흩어지는 기준은
      // 이름의 사각형이다 — 그렇지 않으면 글자를 만지려는 순간 구체로 되돌아간다.
      const isWithinName = (x: number, y: number) => {
        const pad = repelRadius
        return x > nameBounds.minX - pad && x < nameBounds.maxX + pad
          && y > nameBounds.minY - pad && y < nameBounds.maxY + pad
      }
      const updateInteraction = (event: PointerEvent) => {
        const rect = hero.getBoundingClientRect()
        pointerX = event.clientX - rect.left
        pointerY = event.clientY - rect.top
        hasPointer = true
        isInside = isInside ? isWithinName(pointerX, pointerY) : isWithinGlobe(event)
      }

      if (isMobile) {
        // 터치에서는 hover 상태를 흉내 내지 않는다. 짧은 탭 한 번은 이름,
        // 다시 탭하면 원형으로 돌아가는 명확한 두 상태만 제공한다.
        // 대신 **손가락을 대고 끄는 동안**은 커서와 같은 입력이 된다 — 글자를 밀 수 있다.
        // 제스처가 갈리므로 서로 방해하지 않는다: 탭 = 상태 전환, 드래그 = 밀기.
        const trackTouch = (event: PointerEvent) => {
          const rect = hero.getBoundingClientRect()
          pointerX = event.clientX - rect.left
          pointerY = event.clientY - rect.top
        }
        canvas.addEventListener("pointerdown", (event) => {
          mobileTapStart = { x: event.clientX, y: event.clientY }
          trackTouch(event)
          hasPointer = true
        })
        canvas.addEventListener("pointermove", (event) => {
          if (!mobileTapStart) return
          trackTouch(event)
        })
        canvas.addEventListener("pointerup", (event) => {
          if (!mobileTapStart) return
          const moved = Math.hypot(event.clientX - mobileTapStart.x, event.clientY - mobileTapStart.y)
          if (moved < 12 && isWithinGlobe(event)) {
            isInside = !isInside
            hero.dataset.particleMode = isInside ? "name" : "sphere"
          }
          mobileTapStart = null
          // 손을 떼면 밀림이 풀리고 스프링이 글자를 되모은다
          hasPointer = false
        })
        canvas.addEventListener("pointercancel", () => { mobileTapStart = null; hasPointer = false })
      } else {
        hero.addEventListener("pointermove", updateInteraction)
        hero.addEventListener("pointerdown", updateInteraction)
        hero.addEventListener("pointerleave", () => { isInside = false; hasPointer = false })
        hero.addEventListener("pointercancel", () => { isInside = false; hasPointer = false })
      }
      window.addEventListener("resize", resize)
      // window resize만으로는 부족하다 — 히어로가 처음 측정 가능해지는 시점(폭 0에서 벗어나는
      // 순간)과 뷰포트 변화 없이 박스만 바뀌는 경우를 놓쳐 워드마크가 낡은 폭으로 남는다.
      if ("ResizeObserver" in window) new ResizeObserver(resize).observe(hero)
      resize()
      requestAnimationFrame(draw)
      // 폰트가 늦게 도착하면 워드마크 샘플이 폴백 글꼴로 찍힌다 — 로드 후 한 번 재생성
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => resize())
    }
  </script>

  <style>
    :global(body) { background: var(--surface); }
    /* 한 화면 = 한 페이지. 구체와 그리드가 한 페이지에 쌓인 느낌이 아니라,
       스크롤하면 다음 페이지가 나타나는 느낌이 되도록 화면 단위로 스냅한다.
       이 규칙은 홈에서만 적용된다 (페이지 스코프 전역 스타일). */
    :global(html) {
      scroll-snap-type: y mandatory;
    }
    /* 모바일은 그리드 아래 푸터가 있어 mandatory면 마지막 영역에 닿지 못한다.
       proximity로 완화 — 전환감은 유지하되 끝까지 스크롤이 된다. */
    @media (max-width: 700px) {
      :global(html) { scroll-snap-type: y proximity; }
    }
    .hero {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      position: relative;
      display: grid;
      min-height: 100svh;
      overflow: hidden;
      place-items: center;
      color: var(--surface-2);
      background: var(--void);
      isolation: isolate;
    }
    .hero__field { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
    /* 홈 하이라이트: 다가오는 일정.
       흐르는 티커는 글자를 눈으로 쫓게 만든다. 좌측 하단에 고정해 한눈에 읽히게 둔다. */
    .upcoming-ticker {
      position: absolute; left: 22px; bottom: 26px; z-index: 2;
      display: block; max-width: min(48ch, 64vw);
      color: var(--void-text); text-decoration: none;
    }
    .ut-list { display: block; }
    .upcoming-ticker :global(.ut-row) {
      display: block; font-size: var(--fs-xs); line-height: 1.5; letter-spacing: .01em;
    }
    .upcoming-ticker :global(.ut-tag) {
      display: block; margin: 10px 0 3px;
      color: var(--void-label); letter-spacing: .16em; font-size: var(--fs-2xs);
    }
    .upcoming-ticker :global(.ut-tag:first-child) { margin-top: 0; }
    .upcoming-ticker :global(.ut-tag-now) { color: var(--surface); }
    .upcoming-ticker :global(.ut-dim) { color: var(--void-text-2); }
    .upcoming-ticker:hover :global(.ut-row) { color: var(--surface); }
    @media (max-width: 700px) {
      .upcoming-ticker { left: 16px; bottom: 18px; max-width: calc(100vw - 32px); }
    }
    .work-archive {
      scroll-margin-top: 0;
      scroll-snap-align: start;
      /* 두 번째 '페이지'로 성립하려면 자체가 한 화면을 차지해야 한다 */
      min-height: 100svh;
    }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  </style>
</Base>
