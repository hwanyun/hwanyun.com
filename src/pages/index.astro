---
import Base from "../layouts/Base.astro"
import SiteMenu from "../components/SiteMenu.astro"
import WorkGrid from "../components/WorkGrid.astro"
import { getCollection } from "astro:content"

// 홈 하이라이트용 이벤트 데이터 (가장 가까운 미래 일정은 클라이언트에서 오늘 기준으로 선택)
const upEvents = (await getCollection("events", ({ data }) => !data.draft))
  .map((e) => ({ slug: e.slug, title: e.data.title, start: e.data.dateStart, end: e.data.dateEnd || e.data.dateStart, venue: e.data.venue, city: e.data.city }))
  .sort((a, b) => a.start.localeCompare(b.start))
---

<Base title="HWANYUN">
  <SiteMenu slot="menu" variant="hero" />

  <section class="hero" aria-labelledby="hero-title">
    <canvas id="particle-canvas" class="hero__field" aria-hidden="true"></canvas>
    <h1 id="hero-title" class="sr-only">HWANYUN</h1>
    <a id="upcoming-ticker" class="upcoming-ticker" href="/events/" hidden aria-label="Upcoming events"><span class="ut-track" id="ut-track"></span></a>
  </section>
  <script type="application/json" id="ev-data" is:inline set:html={JSON.stringify(upEvents)}></script>
  <script is:inline>
    ;(function () {
      var el = document.getElementById("upcoming-ticker")
      var track = document.getElementById("ut-track")
      var d = document.getElementById("ev-data")
      if (!el || !track || !d) return
      var evs
      try { evs = JSON.parse(d.textContent || "[]") } catch (e) { return }
      function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") }
      var today = new Date(); today.setHours(0, 0, 0, 0)
      var M = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
      var nowItems = []   // 진행 중 (시작함 · 아직 안 끝남)
      var soonItems = []  // 예정 (아직 시작 전)
      for (var i = 0; i < evs.length; i++) {
        var end = new Date(evs[i].end + "T23:59:59")
        if (isNaN(end) || end < today) continue
        var start = new Date(evs[i].start + "T00:00:00")
        var s = evs[i].start.split("-").map(Number)
        var date = s[2] + " " + M[s[1] - 1]
        var where = [evs[i].venue, evs[i].city].filter(Boolean).join(", ")
        var item = esc(evs[i].title) + '<span class="ut-dim"> · ' + date + (where ? " · " + esc(where) : "") + "</span>"
        if (!isNaN(start) && start <= today) nowItems.push(item)
        else soonItems.push(item)
      }
      var items = nowItems.concat(soonItems)
      if (!items.length) return
      var sep = '<span class="ut-sep">✳</span>'
      var content = ""
      if (nowItems.length) content += '<span class="ut-tag ut-tag-now">NOW ON</span>' + sep + nowItems.join(sep) + sep
      if (soonItems.length) content += '<span class="ut-tag">UPCOMING</span>' + sep + soonItems.join(sep) + sep
      var seg = '<span class="ut-seg">' + content + "</span>"
      track.innerHTML = seg + seg // 이음새 없는 반복
      el.hidden = false

      // 구체 표면의 체감 속도에 맞춘다.
      // 적도 정면 지점의 화면상 수평 속도 = ω · globeRadius · perspective
      //   ω = 0.00028 rad/ms = 0.28 rad/s, globeRadius = size × 0.49,
      //   perspective(front) = 2.8 / (3.3 − cos(tilt)) = 1.2048  (tilt = −0.22)
      // → size × 0.16529 px/s. 트랙 폭이 아니라 픽셀 속도를 고정하므로
      //   이벤트 개수가 늘어도 흐르는 속도는 그대로다.
      var SPHERE_PX_PER_SEC = 0.28 * 0.49 * (2.8 / (3.3 - Math.cos(-0.22)))
      // 1 = 구체 표면과 정확히 같은 속도. 글자를 더 천천히 읽히게 하려면 낮춘다.
      var SPEED_FACTOR = 1
      function syncSpeed() {
        var hero = el.parentElement
        if (!hero) return
        var size = Math.min(hero.clientWidth, hero.clientHeight)
        var segWidth = track.scrollWidth / 2 // 세그먼트 2개를 이어붙였다
        var speed = size * SPHERE_PX_PER_SEC * SPEED_FACTOR
        if (!segWidth || !speed) return
        track.style.animationDuration = segWidth / speed + "s"
      }
      syncSpeed()
      window.addEventListener("resize", syncSpeed)
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncSpeed)
    })()
  </script>

  <section id="works" class="work-archive" aria-label="Selected works">
    <WorkGrid current="home" />
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>(".hero")
    const canvas = document.querySelector<HTMLCanvasElement>("#particle-canvas")
    const context = canvas?.getContext("2d")

    if (hero && canvas && context) {
      type Particle = {
        x: number; y: number; vx: number; vy: number
        sphereX: number; sphereY: number; sphereZ: number
        targetX: number; targetY: number
      }
      let particles: Particle[] = []
      let isInside = false
      let mobileTapStart: { x: number; y: number } | null = null
      let width = 0
      let height = 0
      let pixelRatio = 1
      const isMobile = window.matchMedia("(max-width: 700px)").matches
      hero.dataset.particleMode = "sphere"

      const createTargets = () => {
        const sample = document.createElement("canvas")
        const sampleContext = sample.getContext("2d")!
        sample.width = width
        sample.height = height
        const fontSize = Math.min(width * .145, 180)
        sampleContext.font = `600 ${fontSize}px Arial, sans-serif`
        sampleContext.textAlign = "center"
        sampleContext.textBaseline = "middle"
        sampleContext.fillStyle = "#fff"
        sampleContext.fillText("HWANYUN", width / 2, height / 2)
        const pixels = sampleContext.getImageData(0, 0, width, height).data
        const targets: Array<[number, number]> = []
        const step = Math.max(3, Math.round(width / 460))
        for (let y = 0; y < height; y += step) {
          for (let x = 0; x < width; x += step) {
            if (pixels[(y * width + x) * 4 + 3] > 0) targets.push([x, y])
          }
        }
        return targets
      }

      const resize = () => {
        const rect = hero.getBoundingClientRect()
        pixelRatio = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2)
        width = Math.round(rect.width)
        height = Math.round(rect.height)
        canvas.width = width * pixelRatio
        canvas.height = height * pixelRatio
        canvas.style.width = `${width}px`
        canvas.style.height = `${height}px`
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0)
        const targets = createTargets()
        // 모바일에서는 터치 반응성과 안정성을 위해 렌더링 밀도를 낮춘다.
        const count = isMobile
          ? Math.min(1400, Math.max(900, targets.length))
          : Math.min(3200, Math.max(2400, targets.length * 2))
        particles = Array.from({ length: count }, (_, index) => {
          const targetIndex = Math.floor(index / count * targets.length)
          const [targetX, targetY] = targets[targetIndex] || [width / 2, height / 2]
          const sphereY = 1 - (index / (count - 1)) * 2
          const sphereRadius = Math.sqrt(1 - sphereY * sphereY)
          const sphereAngle = index * 2.399963229728653
          const sphereX = Math.cos(sphereAngle) * sphereRadius
          const sphereZ = Math.sin(sphereAngle) * sphereRadius
          return {
            x: width / 2,
            y: height / 2,
            vx: 0, vy: 0,
            sphereX,
            sphereY,
            sphereZ,
            targetX, targetY,
          }
        })
      }

      const draw = (time: number) => {
        context.clearRect(0, 0, width, height)
        const centerX = width / 2
        const centerY = height / 2
        const size = Math.min(width, height)
        const haze = context.createRadialGradient(centerX, centerY, 0, centerX, centerY, size * .5)
        haze.addColorStop(0, "rgba(255, 255, 255, .025)")
        haze.addColorStop(1, "rgba(7, 8, 10, 0)")
        context.fillStyle = haze
        context.fillRect(0, 0, width, height)

        const rotation = time * .00028
        const tilt = -.22
        const cosRotation = Math.cos(rotation)
        const sinRotation = Math.sin(rotation)
        const cosTilt = Math.cos(tilt)
        const sinTilt = Math.sin(tilt)
        const globeRadius = size * .49

        for (const particle of particles) {
          const rotatedX = particle.sphereX * cosRotation - particle.sphereZ * sinRotation
          const rotatedZ = particle.sphereX * sinRotation + particle.sphereZ * cosRotation
          const rotatedY = particle.sphereY * cosTilt - rotatedZ * sinTilt
          const depth = particle.sphereY * sinTilt + rotatedZ * cosTilt
          const perspective = 2.8 / (3.3 - depth)
          const driftX = centerX + rotatedX * globeRadius * perspective
          const driftY = centerY + rotatedY * globeRadius * perspective
          const destinationX = isInside ? particle.targetX : driftX
          const destinationY = isInside ? particle.targetY : driftY
          particle.vx = (particle.vx + (destinationX - particle.x) * (isInside ? .025 : .024)) * .8
          particle.vy = (particle.vy + (destinationY - particle.y) * (isInside ? .025 : .024)) * .8
          particle.x += particle.vx
          particle.y += particle.vy
          context.beginPath()
          const pointSize = isInside ? 1.1 : .52 + (depth + 1) * .48
          const brightness = isInside ? .96 : .26 + (depth + 1) * .34
          context.arc(particle.x, particle.y, pointSize, 0, Math.PI * 2)
          context.fillStyle = `rgba(255, 255, 255, ${brightness})`
          context.fill()
        }
        requestAnimationFrame(draw)
      }

      const isWithinGlobe = (event: PointerEvent) => {
        const rect = hero.getBoundingClientRect()
        const x = event.clientX - rect.left - width / 2
        const y = event.clientY - rect.top - height / 2
        return Math.hypot(x, y) < Math.min(width, height) * .48
      }
      const updateInteraction = (event: PointerEvent) => { isInside = isWithinGlobe(event) }

      if (isMobile) {
        // 터치에서는 hover 상태를 흉내 내지 않는다. 짧은 탭 한 번은 이름,
        // 다시 탭하면 원형으로 돌아가는 명확한 두 상태만 제공한다.
        canvas.addEventListener("pointerdown", (event) => {
          mobileTapStart = { x: event.clientX, y: event.clientY }
        })
        canvas.addEventListener("pointerup", (event) => {
          if (!mobileTapStart) return
          const moved = Math.hypot(event.clientX - mobileTapStart.x, event.clientY - mobileTapStart.y)
          if (moved < 12 && isWithinGlobe(event)) {
            isInside = !isInside
            hero.dataset.particleMode = isInside ? "name" : "sphere"
          }
          mobileTapStart = null
        })
        canvas.addEventListener("pointercancel", () => { mobileTapStart = null })
      } else {
        hero.addEventListener("pointermove", updateInteraction)
        hero.addEventListener("pointerdown", updateInteraction)
        hero.addEventListener("pointerleave", () => { isInside = false })
        hero.addEventListener("pointercancel", () => { isInside = false })
      }
      window.addEventListener("resize", resize)
      resize()
      requestAnimationFrame(draw)
    }
  </script>

  <style>
    :global(body) { background: var(--surface); }
    .hero {
      position: relative;
      display: grid;
      min-height: 100svh;
      overflow: hidden;
      place-items: center;
      color: var(--surface-2);
      background: var(--void);
      isolation: isolate;
    }
    .hero__field { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
    /* 홈 하이라이트: 다가오는 이벤트 티커 (박스 없이, 우→좌로 흐름, 가장자리 페이드) */
    .upcoming-ticker {
      position: absolute; left: 0; right: 0; bottom: 26px; z-index: 2;
      display: block; overflow: hidden; color: var(--void-text); text-decoration: none;
      -webkit-mask-image: linear-gradient(90deg, transparent, var(--text) 9%, var(--text) 91%, transparent);
      mask-image: linear-gradient(90deg, transparent, var(--text) 9%, var(--text) 91%, transparent);
    }
    .ut-track {
      display: inline-flex; white-space: nowrap; will-change: transform;
      /* duration은 구체 표면 속도에 맞춰 스크립트가 설정한다 (아래 값은 폴백) */
      animation: ut-move 34s linear infinite; /* 우 → 좌 */
    }
    @keyframes ut-move { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .upcoming-ticker:hover .ut-track { animation-play-state: paused; }
    .ut-seg { display: inline-flex; align-items: center; font-size: var(--fs-xs); letter-spacing: .01em; }
    .upcoming-ticker :global(.ut-tag) { color: var(--void-label); letter-spacing: .16em; font-size: var(--fs-2xs); }
    .upcoming-ticker :global(.ut-tag-now) { color: var(--surface); }
    .upcoming-ticker :global(.ut-dim) { color: var(--void-text-2); }
    .upcoming-ticker :global(.ut-sep) { margin: 0 24px; color: var(--void-line); }
    @media (prefers-reduced-motion: reduce) { .ut-track { animation: none; } }
    @media (max-width: 700px) {
      .upcoming-ticker { bottom: 18px; }
      .ut-seg { font-size: var(--fs-xs); }
      .upcoming-ticker :global(.ut-sep) { margin: 0 16px; }
    }
    .work-archive { scroll-margin-top: 0; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  </style>
</Base>
