---
/**
 * /prototypes — 완성작 이전의 것들. 세션 하나가 카드 하나.
 * 필터는 도구(Ableton, TouchDesigner …)와 축(울림·접촉·흔적) 두 줄 — Works의 재료/전시 형태와 같은 어휘.
 */
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import PrototypeCard from "../../components/PrototypeCard.astro"
import PrototypePlayer from "../../components/PrototypePlayer.astro"
import { AXES } from "../../data/axes"

const entries = (await getCollection("prototypes", ({ data }) => !data.draft))
  .sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)))

const toolCounts = Array.from(
  entries.flatMap((e) => e.data.tools).reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map<string, number>())
).sort((a, b) => b[1] - a[1])
const axisCounts = AXES.map((a) => ({ ...a, n: entries.filter((e) => e.data.axes.includes(a.id)).length })).filter((a) => a.n > 0)
---

<Base title="Prototypes — HWANYUN" current="prototypes" description="Sessions and tests before the work: Ableton sessions, sensor tests, light and heat experiments by HWANYUN.">
  <main class="protos-archive">
    <header class="archive-intro">
      <p class="eyebrow">PROTOTYPES</p>
      <h1>Prototypes</h1>
      <div class="intro-copy">
        <p lang="en" data-language-content="en">
          Sessions and tests that come before the work. One session, one card — including the ones that failed.
          Dates are by month; how recent a test is, is the information.
        </p>
        <p lang="ko" data-language-content="ko">
          작품 이전의 세션과 테스트. 세션 하나가 카드 하나이고, 실패한 것도 올린다.
          날짜는 월 단위 — 얼마나 최근인지가 정보다.
        </p>
      </div>
    </header>

    {entries.length > 0 && (
      <div class="filter-bar">
        <nav class="pf" aria-label="Filter by tool">
          <a href="/prototypes/" data-tool="" aria-current="true">All <span class="pf-n">{entries.length}</span></a>
          {toolCounts.map(([t, n]) => <a href={`/prototypes/?tool=${encodeURIComponent(t)}`} data-tool={t}>{t} <span class="pf-n">{n}</span></a>)}
        </nav>
        {axisCounts.length > 0 && (
          <nav class="pf pf-axis" aria-label="Filter by stage">
            {axisCounts.map((a) => (
              <a href={`/prototypes/?axis=${a.id}`} data-axis={a.id}>
                <span data-language-content="en">{a.en}</span><span data-language-content="ko" lang="ko">{a.ko}</span>
                <span class="pf-n">{a.n}</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    )}

    {entries.length > 0 ? (
      <div class="proto-grid" id="proto-grid">
        {entries.map((e) => <PrototypeCard entry={e} />)}
      </div>
    ) : (
      <p class="pf-empty">
        <span data-language-content="en">No sessions published yet.</span>
        <span data-language-content="ko" lang="ko">아직 게시된 세션이 없습니다.</span>
      </p>
    )}
    <p class="pf-empty" id="pf-empty" hidden>
      <span data-language-content="en">Nothing with this filter.</span>
      <span data-language-content="ko" lang="ko">이 조건의 세션이 없습니다.</span>
    </p>
  </main>
  <PrototypePlayer />
</Base>

<script is:inline>
  /* 정적 사이트 — 쿼리 파라미터를 브라우저에서 해석한다. Works/Sound 필터와 같은 동작. */
  ;(function () {
    var grid = document.getElementById("proto-grid")
    var empty = document.getElementById("pf-empty")
    if (!grid) return
    var cards = Array.prototype.slice.call(grid.querySelectorAll(".proto"))
    var links = Array.prototype.slice.call(document.querySelectorAll(".pf a"))
    function apply(kind, value) {
      var shown = 0
      cards.forEach(function (c) {
        var hit = !value
          || (kind === "axis" && (c.getAttribute("data-axes") || "").split(" ").indexOf(value) !== -1)
          || (kind === "tool" && (c.getAttribute("data-tools") || "").split("|").indexOf(value) !== -1)
        c.hidden = !hit
        if (hit) shown++
      })
      links.forEach(function (a) {
        var k = a.hasAttribute("data-axis") ? "axis" : "tool"
        var v = a.getAttribute(k === "axis" ? "data-axis" : "data-tool") || ""
        a.setAttribute("aria-current", value ? String(k === kind && v === value) : String(v === ""))
      })
      if (empty) empty.hidden = shown !== 0
    }
    function fromURL() {
      var q = new URLSearchParams(window.location.search)
      if (q.get("axis")) return ["axis", q.get("axis")]
      return ["tool", q.get("tool") || ""]
    }
    links.forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault()
        history.pushState(null, "", a.getAttribute("href"))
        apply.apply(null, fromURL())
      })
    })
    window.addEventListener("popstate", function () { apply.apply(null, fromURL()) })
    apply.apply(null, fromURL())
  })()
</script>

<script is:inline>
  /* 라이브 데모 타일 — data-demo="sphere": 홈 히어로 구체의 축약판(입자 격자 + 커서 반응).
     타일 밖과 공유하는 상태가 없다. 보일 때만 그린다. */
  ;(function () {
    var canvases = Array.prototype.slice.call(document.querySelectorAll('canvas.proto-demo[data-demo="sphere"]'))
    if (!canvases.length) return
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    canvases.forEach(function (canvas) {
      var ctx = canvas.getContext("2d")
      if (!ctx) return
      var W = 0, H = 0, DPR = 1, pts = []
      var N = 900, R = 0
      var mx = 0, my = 0, inside = false
      function resize() {
        var b = canvas.getBoundingClientRect()
        if (!b.width || !b.height) return
        DPR = Math.min(window.devicePixelRatio || 1, 2)
        W = b.width; H = b.height
        canvas.width = W * DPR; canvas.height = H * DPR
        R = Math.min(W, H) * 0.36
        pts = []
        var GA = Math.PI * (3 - Math.sqrt(5))
        for (var i = 0; i < N; i++) {
          var y = 1 - (i / (N - 1)) * 2
          var r = Math.sqrt(1 - y * y)
          var th = GA * i
          pts.push({ x: Math.cos(th) * r, y: y, z: Math.sin(th) * r })
        }
      }
      var rot = 0, raf = 0, visible = false
      function frame() {
        if (!visible) return
        rot += reduce ? 0 : 0.0022
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0)
        ctx.clearRect(0, 0, W, H)
        var cx = W / 2, cy = H / 2
        var ink = getComputedStyle(canvas).color
        ctx.fillStyle = ink
        var cosR = Math.cos(rot), sinR = Math.sin(rot)
        for (var i = 0; i < pts.length; i++) {
          var p = pts[i]
          var x = p.x * cosR - p.z * sinR
          var z = p.x * sinR + p.z * cosR
          var sx = cx + x * R, sy = cy + p.y * R
          var rad = 0.6 + (z + 1) * 0.75
          if (inside) {
            var dx = sx - mx, dy = sy - my
            var d = Math.sqrt(dx * dx + dy * dy)
            if (d < 90) { var f = (1 - d / 90) * 14; sx += (dx / (d || 1)) * f; sy += (dy / (d || 1)) * f; rad += (1 - d / 90) * 0.9 }
          }
          ctx.globalAlpha = 0.25 + (z + 1) * 0.3
          ctx.beginPath(); ctx.arc(sx, sy, rad, 0, Math.PI * 2); ctx.fill()
        }
        ctx.globalAlpha = 1
        raf = requestAnimationFrame(frame)
      }
      canvas.addEventListener("pointermove", function (e) {
        var b = canvas.getBoundingClientRect(); mx = e.clientX - b.left; my = e.clientY - b.top; inside = true
      })
      canvas.addEventListener("pointerleave", function () { inside = false })
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            visible = en.isIntersecting
            if (visible) { resize(); cancelAnimationFrame(raf); raf = requestAnimationFrame(frame) }
            else cancelAnimationFrame(raf)
          })
        }, { rootMargin: "60px 0px" }).observe(canvas)
      } else { visible = true; resize(); frame() }
      window.addEventListener("resize", function () { resize() })
    })
  })()
</script>

<style>
  .protos-archive { max-width: var(--content-w); margin: calc(var(--desktop-header-clearance) + 64px) 40px 100px var(--desktop-content-x); }
  .archive-intro { margin: 0 0 96px; }
  .eyebrow { margin: 0 0 6px; font-size: var(--fs-2xs); letter-spacing: .12em; color: var(--text-4); }
  h1 { margin: 0 0 20px; font-family: var(--display); font-weight: 400; font-size: clamp(40px, 4.4vw, 60px); letter-spacing: -.01em; line-height: 1.05; }
  .intro-copy p { margin: 0; max-width: 62ch; font-size: var(--fs-sm); line-height: 1.7; color: var(--text-2); }
  .intro-copy p[lang="ko"] { line-height: 1.85; }
  .filter-bar { display: flex; flex-direction: column; gap: 8px; margin: 0 0 24px; }
  .pf { display: flex; flex-wrap: wrap; gap: 6px; }
  .pf a {
    padding: 3px 10px; border: 1px solid var(--line-2); border-radius: 999px;
    font-size: var(--fs-xs); color: var(--text-2); text-decoration: none;
  }
  .pf a:hover { border-color: var(--hover); color: var(--hover); }
  .pf a[aria-current="true"] { background: var(--text); color: var(--surface); border-color: var(--text); }
  .pf-n { margin-left: 4px; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .pf a[aria-current="true"] .pf-n { color: var(--line-2); }
  /* 레퍼런스: universaleverything.com/prototypes — 큰 타일 2열, 미디어가 먼저 말한다 */
  .proto-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .pf-empty { margin: 24px 0; font-size: var(--fs-sm); color: var(--text-3); }
  @media (max-width: 1000px) { .proto-grid { grid-template-columns: 1fr; } }
  @media (max-width: 700px) {
    .protos-archive { margin: 0; padding: calc(var(--mobile-header-h, 67px) + 16px) 16px 64px; }
    .proto-grid { grid-template-columns: 1fr; }
  }
</style>
