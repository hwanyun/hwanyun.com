---
/**
 * /prototypes — 완성작 이전의 것들. 세션 하나가 카드 하나.
 * 필터는 도구(Ableton, TouchDesigner …)와 축(울림·접촉·흔적) 두 줄 — Works의 재료/전시 형태와 같은 어휘.
 */
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import PrototypeCard from "../../components/PrototypeCard.astro"
import PrototypePlayer from "../../components/PrototypePlayer.astro"
import { AXES } from "../../data/axes"

const entries = (await getCollection("prototypes", ({ data }) => !data.draft))
  .sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)))

const toolCounts = Array.from(
  entries.flatMap((e) => e.data.tools).reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map<string, number>())
).sort((a, b) => b[1] - a[1])
const axisCounts = AXES.map((a) => ({ ...a, n: entries.filter((e) => e.data.axes.includes(a.id)).length })).filter((a) => a.n > 0)
---

<Base title="Prototypes — HWANYUN" current="prototypes" description="Sessions and tests before the work: Ableton sessions, sensor tests, light and heat experiments by HWANYUN.">
  <main class="protos-archive">
    <header class="archive-intro">
      <p class="eyebrow">PROTOTYPES</p>
      <h1>Prototypes</h1>
      <div class="intro-copy">
        <p lang="en" data-language-content="en">
          Sessions and tests that come before the work. One session, one card — including the ones that failed.
          Dates are by month; how recent a test is, is the information.
        </p>
        <p lang="ko" data-language-content="ko">
          작품 이전의 세션과 테스트. 세션 하나가 카드 하나이고, 실패한 것도 올린다.
          날짜는 월 단위 — 얼마나 최근인지가 정보다.
        </p>
      </div>
    </header>

    {entries.length > 0 && (
      <div class="filter-bar">
        <nav class="pf" aria-label="Filter by tool">
          <a href="/prototypes/" data-tool="" aria-current="true">All <span class="pf-n">{entries.length}</span></a>
          {toolCounts.map(([t, n]) => <a href={`/prototypes/?tool=${encodeURIComponent(t)}`} data-tool={t}>{t} <span class="pf-n">{n}</span></a>)}
        </nav>
        {axisCounts.length > 0 && (
          <nav class="pf pf-axis" aria-label="Filter by stage">
            {axisCounts.map((a) => (
              <a href={`/prototypes/?axis=${a.id}`} data-axis={a.id}>
                <span data-language-content="en">{a.en}</span><span data-language-content="ko" lang="ko">{a.ko}</span>
                <span class="pf-n">{a.n}</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    )}

    {entries.length > 0 ? (
      <div class="proto-grid" id="proto-grid">
        {entries.map((e) => <PrototypeCard entry={e} />)}
      </div>
    ) : (
      <p class="pf-empty">
        <span data-language-content="en">No sessions published yet.</span>
        <span data-language-content="ko" lang="ko">아직 게시된 세션이 없습니다.</span>
      </p>
    )}
    <p class="pf-empty" id="pf-empty" hidden>
      <span data-language-content="en">Nothing with this filter.</span>
      <span data-language-content="ko" lang="ko">이 조건의 세션이 없습니다.</span>
    </p>
  </main>
  <PrototypePlayer />
</Base>

<script is:inline>
  /* 정적 사이트 — 쿼리 파라미터를 브라우저에서 해석한다. Works/Sound 필터와 같은 동작. */
  ;(function () {
    var grid = document.getElementById("proto-grid")
    var empty = document.getElementById("pf-empty")
    if (!grid) return
    var cards = Array.prototype.slice.call(grid.querySelectorAll(".proto"))
    var links = Array.prototype.slice.call(document.querySelectorAll(".pf a"))
    function apply(kind, value) {
      var shown = 0
      cards.forEach(function (c) {
        var hit = !value
          || (kind === "axis" && (c.getAttribute("data-axes") || "").split(" ").indexOf(value) !== -1)
          || (kind === "tool" && (c.getAttribute("data-tools") || "").split("|").indexOf(value) !== -1)
        c.hidden = !hit
        if (hit) shown++
      })
      links.forEach(function (a) {
        var k = a.hasAttribute("data-axis") ? "axis" : "tool"
        var v = a.getAttribute(k === "axis" ? "data-axis" : "data-tool") || ""
        a.setAttribute("aria-current", value ? String(k === kind && v === value) : String(v === ""))
      })
      if (empty) empty.hidden = shown !== 0
    }
    function fromURL() {
      var q = new URLSearchParams(window.location.search)
      if (q.get("axis")) return ["axis", q.get("axis")]
      return ["tool", q.get("tool") || ""]
    }
    links.forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault()
        history.pushState(null, "", a.getAttribute("href"))
        apply.apply(null, fromURL())
      })
    })
    window.addEventListener("popstate", function () { apply.apply(null, fromURL()) })
    apply.apply(null, fromURL())
  })()
</script>

<script is:inline>
  /* 라이브 데모 타일 — data-demo="sphere": 홈 히어로 구체의 축약판(입자 격자 + 커서 반응).
     타일 밖과 공유하는 상태가 없다. 보일 때만 그린다. */
  ;(function () {
    var canvases = Array.prototype.slice.call(document.querySelectorAll('canvas.proto-demo[data-demo="sphere"]'))
    if (!canvases.length) return
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    canvases.forEach(function (canvas) {
      var ctx = canvas.getContext("2d")
      if (!ctx) return
      var W = 0, H = 0, DPR = 1, pts = []
      var N = 900, R = 0
      var mx = 0, my = 0, inside = false
      function resize() {
        var b = canvas.getBoundingClientRect()
        if (!b.width || !b.height) return
        DPR = Math.min(window.devicePixelRatio || 1, 2)
        W = b.width; H = b.height
        canvas.width = W * DPR; canvas.height = H * DPR
        R = Math.min(W, H) * 0.36
        pts = []
        var GA = Math.PI * (3 - Math.sqrt(5))
        for (var i = 0; i < N; i++) {
          var y = 1 - (i / (N - 1)) * 2
          var r = Math.sqrt(1 - y * y)
          var th = GA * i
          pts.push({ x: Math.cos(th) * r, y: y, z: Math.sin(th) * r })
        }
      }
      var rot = 0, raf = 0, visible = false
      function frame() {
        if (!visible) return
        rot += reduce ? 0 : 0.0022
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0)
        ctx.clearRect(0, 0, W, H)
        var cx = W / 2, cy = H / 2
        var ink = getComputedStyle(canvas).color
        ctx.fillStyle = ink
        var cosR = Math.cos(rot), sinR = Math.sin(rot)
        for (var i = 0; i < pts.length; i++) {
          var p = pts[i]
          var x = p.x * cosR - p.z * sinR
          var z = p.x * sinR + p.z * cosR
          var sx = cx + x * R, sy = cy + p.y * R
          var rad = 0.6 + (z + 1) * 0.75
          if (inside) {
            var dx = sx - mx, dy = sy - my
            var d = Math.sqrt(dx * dx + dy * dy)
            if (d < 90) { var f = (1 - d / 90) * 14; sx += (dx / (d || 1)) * f; sy += (dy / (d || 1)) * f; rad += (1 - d / 90) * 0.9 }
          }
          ctx.globalAlpha = 0.25 + (z + 1) * 0.3
          ctx.beginPath(); ctx.arc(sx, sy, rad, 0, Math.PI * 2); ctx.fill()
        }
        ctx.globalAlpha = 1
        raf = requestAnimationFrame(frame)
      }
      canvas.addEventListener("pointermove", function (e) {
        var b = canvas.getBoundingClientRect(); mx = e.clientX - b.left; my = e.clientY - b.top; inside = true
      })
      canvas.addEventListener("pointerleave", function () { inside = false })
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            visible = en.isIntersecting
            if (visible) { resize(); cancelAnimationFrame(raf); raf = requestAnimationFrame(frame) }
            else cancelAnimationFrame(raf)
          })
        }, { rootMargin: "60px 0px" }).observe(canvas)
      } else { visible = true; resize(); frame() }
      window.addEventListener("resize", function () { resize() })
    })
  })()
</script>

<script>
  /* 라이브 데모 타일 — data-demo="mascot": 콘택트 페이지 캐릭터의 축약판.
     같은 GLB(/mascot/character.glb)를 작은 씬에서 돌린다: 대기 애니메이션 + 커서를 따라 도는 몸. */
  import * as THREE from "three"
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js"
  document.querySelectorAll<HTMLCanvasElement>('canvas.proto-demo[data-demo="mascot"]').forEach((canvas) => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true })
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
    const scene = new THREE.Scene()
    const cam = new THREE.PerspectiveCamera(34, 1, 0.1, 500)
    scene.add(new THREE.AmbientLight(0xffffff, 1.15))
    const key = new THREE.DirectionalLight(0xffffff, 1.5); key.position.set(2, 4, 5); scene.add(key)
    let mixer: THREE.AnimationMixer | null = null
    let avatar: THREE.Group | null = null
    let targetRot = 0
    new GLTFLoader().load("/mascot/character.glb", (gltf) => {
      const model = gltf.scene
      const box = new THREE.Box3().setFromObject(model)
      const size = new THREE.Vector3(); box.getSize(size)
      const center = new THREE.Vector3(); box.getCenter(center)
      model.position.set(-center.x, -center.y, -center.z)
      avatar = new THREE.Group(); avatar.add(model); scene.add(avatar)
      const d = size.y / (2 * Math.tan((cam.fov * Math.PI) / 360))
      cam.position.set(0, size.y * 0.04, d * 1.35)
      mixer = new THREE.AnimationMixer(model)
      if (gltf.animations.length) mixer.clipAction(gltf.animations[0]).play()
    })
    canvas.addEventListener("pointermove", (e) => {
      const b = canvas.getBoundingClientRect()
      targetRot = ((e.clientX - b.left) / b.width - 0.5) * 1.1
    })
    canvas.addEventListener("pointerleave", () => { targetRot = 0 })
    const clock = new THREE.Clock()
    let visible = false, raf = 0
    function resize() {
      const b = canvas.getBoundingClientRect()
      if (!b.width) return
      renderer.setSize(b.width, b.height, false)
      cam.aspect = b.width / b.height; cam.updateProjectionMatrix()
    }
    function frame() {
      if (!visible) return
      const dt = clock.getDelta()
      if (mixer && !reduce) mixer.update(dt)
      if (avatar) avatar.rotation.y += (targetRot - avatar.rotation.y) * 0.08
      renderer.render(scene, cam)
      raf = requestAnimationFrame(frame)
    }
    new IntersectionObserver((es) => {
      es.forEach((en) => {
        visible = en.isIntersecting
        cancelAnimationFrame(raf)
        if (visible) { resize(); clock.getDelta(); raf = requestAnimationFrame(frame) }
      })
    }, { rootMargin: "60px 0px" }).observe(canvas)
    window.addEventListener("resize", resize)
  })
</script>

<script>
  /* 라이브 데모 타일 — data-demo="afterglow": 4학기 프로젝트(아직 따뜻한)의 규칙 스케치.
     화이트 큐브 + 미니멀 벤치. 회색 더미가 앉았다 떠나면 접촉면에만 빛이 고인다.
     새 자국은 밝고, 오래된 자국부터 가라앉고, 겹치면 가산 혼합으로 더 따뜻해진다.
     몸의 윤곽·그림자는 그리지 않는다(설계 규칙). 누르면 그 자리에 앉는다. */
  import * as THREE from "three"
  document.querySelectorAll<HTMLCanvasElement>('canvas.proto-demo[data-demo="afterglow"]').forEach((canvas) => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true })
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
    const scene = new THREE.Scene()
    scene.background = new THREE.Color(0xf4f3f0)
    const cam = new THREE.PerspectiveCamera(36, 1, 0.1, 100)
    cam.position.set(0, 3.1, 6.4); cam.lookAt(0, 0.55, 0)
    scene.add(new THREE.AmbientLight(0xffffff, 1.05))
    const sun = new THREE.DirectionalLight(0xffffff, 0.9); sun.position.set(3, 6, 4); scene.add(sun)

    // 방 — 바닥과 뒷벽 두 장이면 화이트 큐브로 읽힌다
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(20, 12), new THREE.MeshLambertMaterial({ color: 0xd9d7d2 }))
    floor.rotation.x = -Math.PI / 2; scene.add(floor)
    const wall = new THREE.Mesh(new THREE.PlaneGeometry(20, 8), new THREE.MeshLambertMaterial({ color: 0xf6f5f2 }))
    wall.position.set(0, 4, -3.4); scene.add(wall)

    // 벤치 — 상판 + 두 다리
    const wood = new THREE.MeshLambertMaterial({ color: 0xb08b5e })
    const top = new THREE.Mesh(new THREE.BoxGeometry(3.2, 0.12, 0.72), wood)
    top.position.y = 0.66; scene.add(top)
    ;[-1.45, 1.45].forEach((x) => {
      const leg = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.6, 0.72), wood)
      leg.position.set(x, 0.3, 0); scene.add(leg)
    })

    // 자국 층 — 상판 바로 위 캔버스 텍스처. 가산 혼합이라 겹치면 진해진다
    const tex = document.createElement("canvas"); tex.width = 512; tex.height = 128
    const tctx = tex.getContext("2d")!
    const traceTex = new THREE.CanvasTexture(tex)
    const traceMat = new THREE.MeshBasicMaterial({ map: traceTex, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false })
    const trace = new THREE.Mesh(new THREE.PlaneGeometry(3.2, 0.72), traceMat)
    trace.rotation.x = -Math.PI / 2; trace.position.y = 0.727; scene.add(trace)

    type Pool = { x: number; birth: number; dwell: number; hue: number }
    const pools: Pool[] = []
    const BLOOM = 1.6, LIFE = 42 // 초 — 실제 열보다 훨씬 길게(연출 원칙: 흔적이 열보다 오래 머문다)
    function drawPools(now: number) {
      tctx.clearRect(0, 0, 512, 128)
      for (let i = pools.length - 1; i >= 0; i--) {
        const p = pools[i]
        const age = now - p.birth
        if (age > LIFE) { pools.splice(i, 1); continue }
        const bloom = Math.min(1, age / BLOOM)
        const decay = Math.pow(1 - age / LIFE, 1.6)
        const a = bloom * decay * (0.55 + p.dwell * 0.45)
        const cx = (p.x / 3.2 + 0.5) * 512, cy = 64
        const r = 46 + p.dwell * 26
        /* 프리즘 혼색(작가, 2026-09) — 방문자마다 다른 색. 가산 혼합이라 겹치는 자리에서 색이 섞여 화려해진다.
           나이가 들수록 채도가 죽으며 온기(주황)로 가라앉는다. */
        const hue = p.hue + Math.min(age / LIFE, 1) * (30 - p.hue % 60) * 0.2
        const g = tctx.createRadialGradient(cx, cy, 0, cx, cy, r)
        g.addColorStop(0, `hsla(${hue}, 95%, 62%, ${a})`)
        g.addColorStop(0.55, `hsla(${(hue + 40) % 360}, 90%, 55%, ${a * 0.5})`)
        g.addColorStop(1, `hsla(${(hue + 80) % 360}, 85%, 50%, 0)`)
        tctx.fillStyle = g
        tctx.beginPath(); tctx.arc(cx, cy, r, 0, Math.PI * 2); tctx.fill()
      }
      traceTex.needsUpdate = true
    }

    // 더미 — 얼굴 없는 무광 회색 인체. 앉은 자세 고정, 나타났다 사라진다
    function makeDummy() {
      const m = new THREE.MeshLambertMaterial({ color: 0x9a9a9a, transparent: true, opacity: 0 })
      const g = new THREE.Group()
      const torso = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.62, 0.24), m); torso.position.y = 1.05
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.13, 16, 12), m); head.position.y = 1.5
      const thigh = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.16, 0.5), m); thigh.position.set(0, 0.78, 0.2)
      const shin = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.55, 0.14), m); shin.position.set(0, 0.42, 0.42)
      g.add(torso, head, thigh, shin)
      g.visible = false
      scene.add(g)
      return { g, m }
    }
    const dummy = makeDummy()
    let phase = "idle", phaseT = 0, seatX = 0, dwellDur = 0, nextAt = 1.5
    function sit(x: number, now: number) {
      if (phase !== "idle") return
      seatX = Math.max(-1.3, Math.min(1.3, x))
      dwellDur = 2.5 + Math.random() * 3.5
      dummy.g.position.set(seatX, 0, 0)
      dummy.g.visible = true
      phase = "in"; phaseT = now
    }

    let visible = false, raf = 0
    const clock = new THREE.Clock()
    let simT = 0
    function frame() {
      if (!visible) return
      const dt = Math.min(clock.getDelta(), 0.1)
      simT += dt
      const now = simT
      // 방문 주기 — 스스로도 계속 산다
      if (phase === "idle" && now > nextAt && !reduce) sit((Math.random() * 2 - 1) * 1.3, now)
      if (phase === "in") { dummy.m.opacity = Math.min(1, (now - phaseT) / 0.8); if (dummy.m.opacity >= 1) { phase = "dwell"; phaseT = now } }
      else if (phase === "dwell" && now - phaseT > dwellDur) { phase = "out"; phaseT = now }
      else if (phase === "out") {
        dummy.m.opacity = Math.max(0, 1 - (now - phaseT) / 0.8)
        if (dummy.m.opacity <= 0) {
          dummy.g.visible = false
          pools.push({ x: seatX, birth: now, dwell: Math.min(1, dwellDur / 6), hue: Math.random() * 360 })
          phase = "idle"; nextAt = now + 2 + Math.random() * 5
        }
      }
      drawPools(now)
      renderer.render(scene, cam)
      raf = requestAnimationFrame(frame)
    }
    canvas.addEventListener("pointerdown", (e) => {
      const b = canvas.getBoundingClientRect()
      sit(((e.clientX - b.left) / b.width - 0.5) * 3.2, simT)
    })
    function resize() {
      const b = canvas.getBoundingClientRect()
      if (!b.width) return
      renderer.setSize(b.width, b.height, false)
      cam.aspect = b.width / b.height; cam.updateProjectionMatrix()
    }
    new IntersectionObserver((es) => {
      es.forEach((en) => {
        visible = en.isIntersecting
        cancelAnimationFrame(raf)
        if (visible) { resize(); clock.getDelta(); raf = requestAnimationFrame(frame) }
      })
    }, { rootMargin: "60px 0px" }).observe(canvas)
    window.addEventListener("resize", resize)
  })
</script>

<style>
  .protos-archive { margin: calc(var(--desktop-header-clearance) + 64px) 12px 100px 12px; }
  /* 머리글·필터는 본문 들여쓰기 라인, 그리드만 화면 전체(레퍼런스: UE prototypes) */
  .archive-intro { margin: 0 28px 96px calc(var(--desktop-content-x) - 12px); }
  .eyebrow { margin: 0 0 6px; font-size: var(--fs-2xs); letter-spacing: .12em; color: var(--text-4); }
  h1 { margin: 0 0 20px; font-family: var(--display); font-weight: 400; font-size: clamp(40px, 4.4vw, 60px); letter-spacing: -.01em; line-height: 1.05; }
  .intro-copy p { margin: 0; max-width: 62ch; font-size: var(--fs-sm); line-height: 1.7; color: var(--text-2); }
  .intro-copy p[lang="ko"] { line-height: 1.85; }
  .filter-bar { display: flex; flex-direction: column; gap: 8px; margin: 0 28px 24px calc(var(--desktop-content-x) - 12px); }
  .pf { display: flex; flex-wrap: wrap; gap: 6px; }
  .pf a {
    padding: 3px 10px; border: 1px solid var(--line-2); border-radius: 999px;
    font-size: var(--fs-xs); color: var(--text-2); text-decoration: none;
  }
  .pf a:hover { border-color: var(--hover); color: var(--hover); }
  .pf a[aria-current="true"] { background: var(--text); color: var(--surface); border-color: var(--text); }
  .pf-n { margin-left: 4px; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .pf a[aria-current="true"] .pf-n { color: var(--line-2); }
  /* 레퍼런스: universaleverything.com/prototypes — 큰 타일 2열, 미디어가 먼저 말한다 */
  /* 박스 자체를 줄인다(작가, 2026-09) — 전폭 대신 본문 라인에 맞춘 2열, 타일 약 460px */
  .proto-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; max-width: 960px; margin-left: calc(var(--desktop-content-x) - 12px); }
  .pf-empty { margin: 24px 0; font-size: var(--fs-sm); color: var(--text-3); }
  /* 좁은 화면에서도 한 줄 두 박스(작가, 2026-09) */
  @media (max-width: 700px) {
    .protos-archive { margin: 0; padding: calc(var(--mobile-header-h, 67px) + 16px) 12px 64px; }
    .archive-intro, .filter-bar { margin-left: 4px; margin-right: 4px; }
    .proto-grid { max-width: none; margin-left: 0; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
