---
/**
 * /prototypes — 완성작 이전의 것들. 세션 하나가 카드 하나.
 * 필터는 도구(Ableton, TouchDesigner …)와 축(울림·접촉·흔적) 두 줄 — Works의 재료/전시 형태와 같은 어휘.
 */
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import PrototypeCard from "../../components/PrototypeCard.astro"
import PrototypePlayer from "../../components/PrototypePlayer.astro"
import { AXES } from "../../data/axes"

const entries = (await getCollection("prototypes", ({ data }) => !data.draft))
  .sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)))

const toolCounts = Array.from(
  entries.flatMap((e) => e.data.tools).reduce((m, t) => m.set(t, (m.get(t) ?? 0) + 1), new Map<string, number>())
).sort((a, b) => b[1] - a[1])
const axisCounts = AXES.map((a) => ({ ...a, n: entries.filter((e) => e.data.axes.includes(a.id)).length })).filter((a) => a.n > 0)
---

<Base title="Prototypes — HWANYUN" current="prototypes" description="Sessions and tests before the work: Ableton sessions, sensor tests, light and heat experiments by HWANYUN.">
  <main class="protos-archive">
    <header class="archive-intro">
      <p class="eyebrow">PROTOTYPES</p>
      <h1>Prototypes</h1>
      <div class="intro-copy">
        <p lang="en" data-language-content="en">
          Sessions and tests that come before the work. One session, one card — including the ones that failed.
          Dates are by month; how recent a test is, is the information.
        </p>
        <p lang="ko" data-language-content="ko">
          작품 이전의 세션과 테스트. 세션 하나가 카드 하나이고, 실패한 것도 올린다.
          날짜는 월 단위 — 얼마나 최근인지가 정보다.
        </p>
      </div>
    </header>

    {entries.length > 0 && (
      <div class="filter-bar">
        <nav class="pf" aria-label="Filter by tool">
          <a href="/prototypes/" data-tool="" aria-current="true">All <span class="pf-n">{entries.length}</span></a>
          {toolCounts.map(([t, n]) => <a href={`/prototypes/?tool=${encodeURIComponent(t)}`} data-tool={t}>{t} <span class="pf-n">{n}</span></a>)}
        </nav>
        {axisCounts.length > 0 && (
          <nav class="pf pf-axis" aria-label="Filter by stage">
            {axisCounts.map((a) => (
              <a href={`/prototypes/?axis=${a.id}`} data-axis={a.id}>
                <span data-language-content="en">{a.en}</span><span data-language-content="ko" lang="ko">{a.ko}</span>
                <span class="pf-n">{a.n}</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    )}

    {entries.length > 0 ? (
      <div class="proto-grid" id="proto-grid">
        {entries.map((e) => <PrototypeCard entry={e} />)}
      </div>
    ) : (
      <p class="pf-empty">
        <span data-language-content="en">No sessions published yet.</span>
        <span data-language-content="ko" lang="ko">아직 게시된 세션이 없습니다.</span>
      </p>
    )}
    <p class="pf-empty" id="pf-empty" hidden>
      <span data-language-content="en">Nothing with this filter.</span>
      <span data-language-content="ko" lang="ko">이 조건의 세션이 없습니다.</span>
    </p>
  </main>
  <PrototypePlayer />
</Base>

<script is:inline>
  /* 정적 사이트 — 쿼리 파라미터를 브라우저에서 해석한다. Works/Sound 필터와 같은 동작. */
  ;(function () {
    var grid = document.getElementById("proto-grid")
    var empty = document.getElementById("pf-empty")
    if (!grid) return
    var cards = Array.prototype.slice.call(grid.querySelectorAll(".proto"))
    var links = Array.prototype.slice.call(document.querySelectorAll(".pf a"))
    function apply(kind, value) {
      var shown = 0
      cards.forEach(function (c) {
        var hit = !value
          || (kind === "axis" && (c.getAttribute("data-axes") || "").split(" ").indexOf(value) !== -1)
          || (kind === "tool" && (c.getAttribute("data-tools") || "").split("|").indexOf(value) !== -1)
        c.hidden = !hit
        if (hit) shown++
      })
      links.forEach(function (a) {
        var k = a.hasAttribute("data-axis") ? "axis" : "tool"
        var v = a.getAttribute(k === "axis" ? "data-axis" : "data-tool") || ""
        a.setAttribute("aria-current", value ? String(k === kind && v === value) : String(v === ""))
      })
      if (empty) empty.hidden = shown !== 0
    }
    function fromURL() {
      var q = new URLSearchParams(window.location.search)
      if (q.get("axis")) return ["axis", q.get("axis")]
      return ["tool", q.get("tool") || ""]
    }
    links.forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault()
        history.pushState(null, "", a.getAttribute("href"))
        apply.apply(null, fromURL())
      })
    })
    window.addEventListener("popstate", function () { apply.apply(null, fromURL()) })
    apply.apply(null, fromURL())
  })()
</script>

<script is:inline>
  /* 라이브 데모 타일 — data-demo="sphere": 홈 히어로 구체의 축약판(입자 격자 + 커서 반응).
     타일 밖과 공유하는 상태가 없다. 보일 때만 그린다. */
  ;(function () {
    var canvases = Array.prototype.slice.call(document.querySelectorAll('canvas.proto-demo[data-demo="sphere"]'))
    if (!canvases.length) return
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    canvases.forEach(function (canvas) {
      var ctx = canvas.getContext("2d")
      if (!ctx) return
      var W = 0, H = 0, DPR = 1, pts = []
      var N = 900, R = 0
      var mx = 0, my = 0, inside = false
      function resize() {
        var b = canvas.getBoundingClientRect()
        if (!b.width || !b.height) return
        DPR = Math.min(window.devicePixelRatio || 1, 2)
        W = b.width; H = b.height
        canvas.width = W * DPR; canvas.height = H * DPR
        R = Math.min(W, H) * 0.36
        pts = []
        var GA = Math.PI * (3 - Math.sqrt(5))
        for (var i = 0; i < N; i++) {
          var y = 1 - (i / (N - 1)) * 2
          var r = Math.sqrt(1 - y * y)
          var th = GA * i
          pts.push({ x: Math.cos(th) * r, y: y, z: Math.sin(th) * r })
        }
      }
      var rot = 0, raf = 0, visible = false
      function frame() {
        if (!visible) return
        rot += reduce ? 0 : 0.0022
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0)
        ctx.clearRect(0, 0, W, H)
        var cx = W / 2, cy = H / 2
        var ink = getComputedStyle(canvas).color
        ctx.fillStyle = ink
        var cosR = Math.cos(rot), sinR = Math.sin(rot)
        for (var i = 0; i < pts.length; i++) {
          var p = pts[i]
          var x = p.x * cosR - p.z * sinR
          var z = p.x * sinR + p.z * cosR
          var sx = cx + x * R, sy = cy + p.y * R
          var rad = 0.6 + (z + 1) * 0.75
          if (inside) {
            var dx = sx - mx, dy = sy - my
            var d = Math.sqrt(dx * dx + dy * dy)
            if (d < 90) { var f = (1 - d / 90) * 14; sx += (dx / (d || 1)) * f; sy += (dy / (d || 1)) * f; rad += (1 - d / 90) * 0.9 }
          }
          ctx.globalAlpha = 0.25 + (z + 1) * 0.3
          ctx.beginPath(); ctx.arc(sx, sy, rad, 0, Math.PI * 2); ctx.fill()
        }
        ctx.globalAlpha = 1
        raf = requestAnimationFrame(frame)
      }
      canvas.addEventListener("pointermove", function (e) {
        var b = canvas.getBoundingClientRect(); mx = e.clientX - b.left; my = e.clientY - b.top; inside = true
      })
      canvas.addEventListener("pointerleave", function () { inside = false })
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            visible = en.isIntersecting
            if (visible) { resize(); cancelAnimationFrame(raf); raf = requestAnimationFrame(frame) }
            else cancelAnimationFrame(raf)
          })
        }, { rootMargin: "60px 0px" }).observe(canvas)
      } else { visible = true; resize(); frame() }
      window.addEventListener("resize", function () { resize() })
    })
  })()
</script>

<script is:inline>
  /* 카드 영상 — 보일 때만 src를 붙이고 재생한다(WorkGrid와 같은 규칙) */
  ;(function () {
    var vids = Array.prototype.slice.call(document.querySelectorAll(".proto-video[data-src]"))
    if (!vids.length || !("IntersectionObserver" in window)) return
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        var v = e.target
        if (e.isIntersecting) { if (!v.src) v.src = v.getAttribute("data-src"); var p = v.play(); if (p && p.catch) p.catch(function () {}) }
        else if (v.src) v.pause()
      })
    }, { rootMargin: "80px 0px" })
    vids.forEach(function (v) { io.observe(v) })
  })()
</script>

<script>
  /* 라이브 데모 타일 — data-demo="mascot": 콘택트 페이지 캐릭터의 축약판.
     같은 GLB(/mascot/character.glb)를 작은 씬에서 돌린다: 대기 애니메이션 + 커서를 따라 도는 몸. */
  import * as THREE from "three"
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js"
  document.querySelectorAll<HTMLCanvasElement>('canvas.proto-demo[data-demo="mascot"]').forEach((canvas) => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true })
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
    const scene = new THREE.Scene()
    const cam = new THREE.PerspectiveCamera(34, 1, 0.1, 500)
    scene.add(new THREE.AmbientLight(0xffffff, 1.15))
    const key = new THREE.DirectionalLight(0xffffff, 1.5); key.position.set(2, 4, 5); scene.add(key)
    let mixer: THREE.AnimationMixer | null = null
    let avatar: THREE.Group | null = null
    let targetRot = 0
    new GLTFLoader().load("/mascot/character.glb", (gltf) => {
      const model = gltf.scene
      const box = new THREE.Box3().setFromObject(model)
      const size = new THREE.Vector3(); box.getSize(size)
      const center = new THREE.Vector3(); box.getCenter(center)
      model.position.set(-center.x, -center.y, -center.z)
      avatar = new THREE.Group(); avatar.add(model); scene.add(avatar)
      const d = size.y / (2 * Math.tan((cam.fov * Math.PI) / 360))
      cam.position.set(0, size.y * 0.04, d * 1.35)
      mixer = new THREE.AnimationMixer(model)
      if (gltf.animations.length) mixer.clipAction(gltf.animations[0]).play()
    })
    canvas.addEventListener("pointermove", (e) => {
      const b = canvas.getBoundingClientRect()
      targetRot = ((e.clientX - b.left) / b.width - 0.5) * 1.1
    })
    canvas.addEventListener("pointerleave", () => { targetRot = 0 })
    const clock = new THREE.Clock()
    let visible = false, raf = 0
    function resize() {
      const b = canvas.getBoundingClientRect()
      if (!b.width) return
      renderer.setSize(b.width, b.height, false)
      cam.aspect = b.width / b.height; cam.updateProjectionMatrix()
    }
    function frame() {
      if (!visible) return
      const dt = clock.getDelta()
      if (mixer && !reduce) mixer.update(dt)
      if (avatar) avatar.rotation.y += (targetRot - avatar.rotation.y) * 0.08
      renderer.render(scene, cam)
      raf = requestAnimationFrame(frame)
    }
    new IntersectionObserver((es) => {
      es.forEach((en) => {
        visible = en.isIntersecting
        cancelAnimationFrame(raf)
        if (visible) { resize(); clock.getDelta(); raf = requestAnimationFrame(frame) }
      })
    }, { rootMargin: "60px 0px" }).observe(canvas)
    window.addEventListener("resize", resize)
  })
</script>
<script>
  /* 라이브 데모 타일 — data-demo="afterglow": 4학기 프로젝트(아직 따뜻한)의 규칙 스케치.
     화이트 큐브 + 미니멀 벤치. 관절 있는 회색 더미가 옆에서 걸어 들어와 앉는다(그냥 생겨나지 않는다 — 작가 지적).
     앉는 순간부터 접촉면(엉덩이 + 두 발바닥)이 서서히 물들고, 떠난 뒤 여운이 흐른다.
     방문자마다 색이 달라 겹치는 자리는 프리즘처럼 섞인다. 동시에 둘까지 앉는다.
     몸의 윤곽·그림자는 그리지 않는다(설계 규칙). 누르면 그 자리에 앉는다. */
  import * as THREE from "three"
  document.querySelectorAll<HTMLCanvasElement>('canvas.proto-demo[data-demo="afterglow"]').forEach((canvas) => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true })
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
    const scene = new THREE.Scene()
    scene.background = new THREE.Color(0xf4f3f0)
    const cam = new THREE.PerspectiveCamera(36, 1, 0.1, 100)
    cam.position.set(0, 4.6, 11.5); cam.lookAt(0, 0.5, 0) /* 벤치가 작아 보이는 큰 공간의 시점 */
    scene.add(new THREE.AmbientLight(0xffffff, 1.05))
    const sun = new THREE.DirectionalLight(0xffffff, 0.9); sun.position.set(3, 6, 4); scene.add(sun)

    const floor = new THREE.Mesh(new THREE.PlaneGeometry(20, 12), new THREE.MeshLambertMaterial({ color: 0xe9e8e4 }))
    floor.rotation.x = -Math.PI / 2; scene.add(floor)
    const wall = new THREE.Mesh(new THREE.PlaneGeometry(40, 16), new THREE.MeshLambertMaterial({ color: 0xf6f5f2 }))
    wall.position.set(0, 4, -3.4); scene.add(wall)

    const wood = new THREE.MeshLambertMaterial({ color: 0xb08b5e })
    const top = new THREE.Mesh(new THREE.BoxGeometry(3.2, 0.12, 0.72), wood)
    top.position.y = 0.66; scene.add(top)
    ;[-1.45, 1.45].forEach((x) => {
      const leg = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.6, 0.72), wood)
      leg.position.set(x, 0.3, 0); scene.add(leg)
    })

    // 자국 층 — 벤치 상판과 바닥. 가산 혼합이라 겹치면 색이 섞인다
    function layer(w: number, h: number, geoW: number, geoH: number, y: number, z: number) {
      const c = document.createElement("canvas"); c.width = w; c.height = h
      const ctx = c.getContext("2d")!
      const t = new THREE.CanvasTexture(c)
      const mesh = new THREE.Mesh(new THREE.PlaneGeometry(geoW, geoH),
        new THREE.MeshBasicMaterial({ map: t, transparent: true, depthWrite: false }))
      mesh.rotation.x = -Math.PI / 2; mesh.position.set(0, y, z); scene.add(mesh)
      return { c, ctx, t, geoW, geoH, z }
    }
    const seatL = layer(512, 128, 3.2, 0.72, 0.727, 0)
    const floorL = layer(512, 256, 4.2, 2.1, 0.006, 0.7)

    /* 앉는 동안 물들고(SOAK), 떠난 뒤 여운(LIFE). 흔적이 열보다 오래 머문다(연출 원칙). */
    type Pool = { x: number; z: number; layer: "seat" | "floor"; birth: number; leave: number; dwell: number; hue: number }
    const pools: Pool[] = []
    const SOAK = 9, LIFE = 55 /* 더 느리게 물들고 더 오래 머문다 */
    function drawPools(now: number) {
      seatL.ctx.clearRect(0, 0, 512, 128)
      floorL.ctx.clearRect(0, 0, 512, 256)
      /* 프리즘 혼색 — 겹침은 텍스처 안에서 lighter로 섞는다(3D 가산은 흰 바닥에서 씻겨 나감) */
      seatL.ctx.globalCompositeOperation = "lighter"
      floorL.ctx.globalCompositeOperation = "lighter"
      for (let i = pools.length - 1; i >= 0; i--) {
        const p = pools[i]
        if (p.leave > 0 && now - p.leave > LIFE) { pools.splice(i, 1); continue }
        const bloom = Math.min(1, Math.max(0, now - p.birth) / SOAK)
        if (bloom <= 0) continue
        const decay = p.leave > 0 ? Math.pow(1 - (now - p.leave) / LIFE, 1.6) : 1
        const alpha = bloom * decay * (0.5 + p.dwell * 0.5)
        const L = p.layer === "seat" ? seatL : floorL
        const cx = (p.x / L.geoW + 0.5) * L.c.width
        const cy = ((p.z - L.z) / L.geoH + 0.5) * L.c.height
        const r = (p.layer === "seat" ? 46 + p.dwell * 26 : 20 + p.dwell * 8) * (0.4 + bloom * 0.6)
        const fade = p.leave > 0 ? Math.min((now - p.leave) / LIFE, 1) : 0
        const hue = p.hue + fade * 20
        const g = L.ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(r, 1))
        g.addColorStop(0, `hsla(${hue}, 100%, 52%, ${alpha})`)
        g.addColorStop(0.55, `hsla(${(hue + 55) % 360}, 100%, 50%, ${alpha * 0.55})`)
        g.addColorStop(1, `hsla(${(hue + 110) % 360}, 100%, 48%, 0)`)
        L.ctx.fillStyle = g
        L.ctx.beginPath(); L.ctx.arc(cx, cy, Math.max(r, 1), 0, Math.PI * 2); L.ctx.fill()
      }
      seatL.t.needsUpdate = true
      floorL.t.needsUpdate = true
    }

    /* 더미 — 관절 있는 무광 회색 인체(머리·몸통·팔·허벅지·정강이·발).
       옆에서 걸어 들어와(다리 흔들림) 앉고, 일어나 걸어 나간다. */
    function makeDummy() {
      const m = new THREE.MeshLambertMaterial({ color: 0x9a9a9a })
      const root = new THREE.Group()
      const torso = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.52, 0.19), m); torso.position.y = 1.22
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.115, 16, 12), m); head.position.y = 1.63
      root.add(torso, head)
      function limb(px: number) {
        const hip = new THREE.Group(); hip.position.set(px, 0.94, 0)
        const thigh = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.4, 0.15), m); thigh.position.y = -0.2; hip.add(thigh)
        const knee = new THREE.Group(); knee.position.y = -0.4; hip.add(knee)
        const shin = new THREE.Mesh(new THREE.BoxGeometry(0.115, 0.4, 0.13), m); shin.position.y = -0.2; knee.add(shin)
        const foot = new THREE.Mesh(new THREE.BoxGeometry(0.115, 0.07, 0.24), m); foot.position.set(0, -0.42, 0.05); knee.add(foot)
        root.add(hip)
        return { hip, knee }
      }
      const legs = [limb(-0.09), limb(0.09)]
      function arm(px: number) {
        const sh = new THREE.Group(); sh.position.set(px, 1.42, 0)
        const a = new THREE.Mesh(new THREE.BoxGeometry(0.085, 0.44, 0.1), m); a.position.y = -0.22; sh.add(a)
        root.add(sh)
        return sh
      }
      const arms = [arm(-0.2), arm(0.2)]
      root.visible = false
      scene.add(root)
      return { root, legs, arms, phase: "idle", t: 0, seatX: 0, fromX: 0, dwellDur: 0, walkDur: 0, pools: [] as Pool[], hue: 0 }
    }
    type Dummy = ReturnType<typeof makeDummy>
    const dummies: Dummy[] = [makeDummy(), makeDummy()]

    function pose(d: Dummy, sitK: number, swing: number) {
      // sitK: 0=서기 1=앉기. swing: 걷기 다리 흔들림(라디안)
      d.root.position.y = -0.155 * sitK
      d.legs[0].hip.rotation.x = -1.35 * sitK + swing * (1 - sitK)
      d.legs[1].hip.rotation.x = -1.35 * sitK - swing * (1 - sitK)
      d.legs.forEach((l) => { l.knee.rotation.x = 1.3 * sitK })
      d.arms[0].rotation.x = 0.25 * sitK - swing * 0.6 * (1 - sitK)
      d.arms[1].rotation.x = 0.25 * sitK + swing * 0.6 * (1 - sitK)
    }

    let nextAt = 1.2
    function occupied(x: number) { return dummies.some((d) => d.phase !== "idle" && Math.abs(d.seatX - x) < 0.55) }
    function sit(x: number, now: number) {
      const d = dummies.find((k) => k.phase === "idle")
      if (!d) return
      const sx = Math.max(-1.3, Math.min(1.3, x))
      if (occupied(sx)) return
      d.seatX = sx
      d.fromX = sx < 0 ? -6.5 : 6.5
      d.walkDur = Math.abs(d.fromX - sx) / 0.65 /* 느린 걸음(작가, 2026-09) */
      d.dwellDur = 6 + Math.random() * 6
      d.hue = Math.random() * 360
      d.root.position.set(d.fromX, 0, 0.45)
      d.root.visible = true
      d.phase = "walkin"; d.t = now
    }
    function step(d: Dummy, now: number) {
      /* 몸은 늘 진행 방향을 본다(작가 지적: 옆으로 미끄러지듯 보였다) — 앉을 때만 정면으로 돌아앉는다 */
      const inDir = d.seatX >= d.fromX ? 1 : -1
      if (d.phase === "walkin") {
        const k = Math.min(1, (now - d.t) / d.walkDur)
        d.root.position.x = d.fromX + (d.seatX - d.fromX) * k
        d.root.position.z = 0.45
        d.root.rotation.y = inDir * Math.PI / 2
        pose(d, 0, Math.sin(now * 5) * 0.42)
        if (k >= 1) {
          d.phase = "sitdown"; d.t = now
          d.pools = [
            { x: d.seatX, z: 0, layer: "seat", birth: now + 0.5, leave: 0, dwell: 0.6, hue: d.hue },
            { x: d.seatX - 0.1, z: 0.62, layer: "floor", birth: now + 0.8, leave: 0, dwell: 0.6, hue: (d.hue + 25) % 360 },
            { x: d.seatX + 0.1, z: 0.62, layer: "floor", birth: now + 1, leave: 0, dwell: 0.6, hue: (d.hue + 335) % 360 },
          ]
          d.pools.forEach((p) => pools.push(p))
        }
      } else if (d.phase === "sitdown") {
        const k = Math.min(1, (now - d.t) / 1.3)
        d.root.position.z = 0.45 * (1 - k)
        d.root.rotation.y = inDir * Math.PI / 2 * (1 - k)
        pose(d, k, 0)
        if (k >= 1) { d.phase = "dwell"; d.t = now }
      } else if (d.phase === "dwell") {
        pose(d, 1, 0)
        if (now - d.t > d.dwellDur) {
          d.phase = "standup"; d.t = now
          const dw = Math.min(1, d.dwellDur / 6)
          d.pools.forEach((p) => { p.leave = now + 0.6; p.dwell = 0.4 + dw * 0.6 })
          d.pools = []
        }
      } else if (d.phase === "standup") {
        const k = Math.min(1, (now - d.t) / 1.3)
        d.root.position.z = 0.45 * k
        d.root.rotation.y = -inDir * Math.PI / 2 * k
        pose(d, 1 - k, 0)
        if (k >= 1) { d.phase = "walkout"; d.t = now }
      } else if (d.phase === "walkout") {
        const k = Math.min(1, (now - d.t) / d.walkDur)
        d.root.position.x = d.seatX + (d.fromX - d.seatX) * k
        d.root.rotation.y = -inDir * Math.PI / 2
        pose(d, 0, Math.sin(now * 5) * 0.42)
        if (k >= 1) { d.root.visible = false; d.phase = "idle" }
      }
    }

    let visible = false, raf = 0
    const clock = new THREE.Clock()
    let simT = 0
    function frame() {
      if (!visible) return
      const dt = Math.min(clock.getDelta(), 0.1)
      simT += dt
      const now = simT
      if (now > nextAt && !reduce) { sit((Math.random() * 2 - 1) * 1.3, now); nextAt = now + 5 + Math.random() * 6 }
      dummies.forEach((d) => step(d, now))
      drawPools(now)
      renderer.render(scene, cam)
      raf = requestAnimationFrame(frame)
    }
    canvas.addEventListener("pointerdown", (e) => {
      const b = canvas.getBoundingClientRect()
      sit(((e.clientX - b.left) / b.width - 0.5) * 3.2, simT)
    })
    function resize() {
      const b = canvas.getBoundingClientRect()
      if (!b.width) return
      renderer.setSize(b.width, b.height, false)
      cam.aspect = b.width / b.height; cam.updateProjectionMatrix()
    }
    new IntersectionObserver((es) => {
      es.forEach((en) => {
        visible = en.isIntersecting
        cancelAnimationFrame(raf)
        if (visible) { resize(); clock.getDelta(); raf = requestAnimationFrame(frame) }
      })
    }, { rootMargin: "60px 0px" }).observe(canvas)
    window.addEventListener("resize", resize)
  })
</script>





