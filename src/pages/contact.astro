---
// hwanyun.com — Contact 페이지 (인터랙티브 3D 마스코트)
// 배포 전제: `npm install three` 완료, public/mascot/character.glb 존재
import Base from "../layouts/Base.astro"
---

<Base title="HWANYUN — Contact" current="contact">
  <article class="page">
    <p class="eyebrow">CONTACT</p>
    <h1>Contact</h1>
    <p class="lead">
      <span lang="en" data-language-content="en">For exhibitions, commissions, and collaborations.</span>
      <span lang="ko" data-language-content="ko">전시, 커미션, 협업 문의.</span>
    </p>
    <ul class="links">
      <li>
        <span>Email</span>
        <a href="mailto:hwanyun.lab@gmail.com" class="primary">hwanyun.lab@gmail.com</a>
        <button type="button" class="copy" data-copy="hwanyun.lab@gmail.com" aria-label="Copy email address">Copy</button>
      </li>
      <li>
        <span>Instagram</span>
        <a href="https://instagram.com/hwanyun.lab" target="_blank" rel="noopener">@hwanyun.lab</a>
      </li>
    </ul>
  </article>
  {/* 마스코트가 사는 공간 — 지면과 공기는 캐릭터 뒤에, 캐릭터가 만드는 신호는 앞에 */}
  <canvas id="habitat" aria-hidden="true"></canvas>
  <canvas id="habitat-fx" aria-hidden="true"></canvas>
  <div id="mascot-bg"></div>
  <canvas id="mascot-canvas"></canvas>
  <div id="mascot-bubble" aria-hidden="true"></div>

  <style>
    .page {
      position: relative; z-index: 5;
      margin: var(--desktop-header-clearance) 40px 100px var(--desktop-content-x);
      max-width: 460px; padding: 0; font-size: var(--fs-body); font-weight: 400; line-height: 1.7;
      pointer-events: none;
    }
    .page * { pointer-events: auto; }
    .page h1, .page li, .page a, .page .eyebrow { text-shadow: 0 0 6px var(--surface), 0 0 6px var(--surface), 0 0 10px var(--surface); }
    .page .eyebrow { margin: 0; font-size: var(--fs-2xs); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
    .page h1 { margin: 8px 0 24px; font-size: var(--fs-display); font-weight: 300; line-height: 1.15; }
    /* 이 페이지의 목적을 첫 줄에서 밝힌다 — 방문자는 연락처를 찾으러 왔다 */
    .page .lead { margin: -12px 0 26px; font-size: var(--fs-sm); line-height: 1.6; color: var(--text-2); }
    .page .lead span { display: block; }
    

    .links { list-style: none; padding: 0; margin: 0; }
    .links li { display: flex; align-items: baseline; gap: 16px; padding: 7px 0; border-top: 1px solid var(--line); }
    .links li:last-child { border-bottom: 1px solid var(--line); }
    .links span { width: 90px; flex: none; color: var(--text-3); font-size: var(--fs-sm); }
    /* 이메일은 이 페이지의 핵심 정보이므로 한 단계 크게 */
    .links a.primary { font-size: var(--fs-lead); }
    .copy {
      margin-left: auto;
      padding: 4px 10px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      background: transparent;
      color: var(--text-3);
      font: 400 var(--fs-2xs)/1 var(--sans);
      letter-spacing: .06em;
      transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
    }
    .copy:hover { border-color: var(--text); color: var(--text); }
    .copy.done { border-color: var(--text); color: var(--text); }
    .links a { color: var(--text); text-decoration: none; position: relative; padding: 2px 2px; border-radius: 4px; transition: color var(--dur-base), background var(--dur-base), transform var(--dur-base); }
    .links a::after { content:""; position:absolute; left:2px; right:2px; bottom:-1px; height:2px; background:var(--text); transform:scaleX(0); transform-origin:left; transition:transform var(--dur-base); }
    .links a:hover::after, .links a.active::after { transform: scaleX(1); }
    /* 활성 표시는 색이 아니라 명도로 — 이 페이지에서 색을 갖는 것은 마스코트뿐이다 */
    .links a.active { color:var(--text); background:var(--surface-2); transform: translateX(2px); }
    /* 마스코트의 서식지 — 지면과 공기는 캐릭터 뒤(1), 캐릭터가 만드는 신호는 앞(3) */
    #habitat { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 1; pointer-events: none; }
    #habitat-fx { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 3; pointer-events: none; }
    #mascot-canvas { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 2; pointer-events: none; }
    #mascot-canvas.grab { cursor: grab; } #mascot-canvas.grabbing { cursor: grabbing; }
    /* 커서를 따라 은은한 빛이 움직이는 배경.
       크림색 웜톤이던 것을 중립 명도로 바꿨다 — 사이트 나머지가 흑백이라
       이 페이지만 다른 사이트처럼 보이던 원인이었다. 인터랙션(커서 추적)은 유지하고
       색만 뺀다. 이제 이 화면에서 색을 갖는 것은 마스코트뿐이고, 그 대비가
       사고가 아니라 의도로 읽힌다. */
    #mascot-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(circle 42vmax at var(--mx, 55%) var(--my, 42%), var(--surface-2) 0%, var(--surface) 62%); }
    /* 캐릭터 머리 위 말풍선 */
    #mascot-bubble { position: fixed; z-index: 6; pointer-events: none; left: -9999px; top: -9999px;
      background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 18px; padding: 13px 20px;
      font-size: var(--fs-body); font-weight: 600; line-height: 1.25; text-align: left; max-width: 300px;
      box-shadow: 0 12px 32px rgba(0,0,0,.14); opacity: 0; transition: opacity var(--dur-base) ease; }
    #mascot-bubble.show { opacity: 1; }
    #mascot-bubble.right { transform: translateY(-50%); }
    #mascot-bubble.left  { transform: translate(-100%, -50%); }
    #mascot-bubble :global(.en) { display: block; margin-top: 5px; font-size: var(--fs-xs); font-weight: 400; color: var(--text-4); letter-spacing: .02em; }
    #mascot-bubble.right::after { content: ""; position: absolute; left: -8px; top: 50%; transform: translateY(-50%);
      border: 8px solid transparent; border-right-color: var(--surface); }
    #mascot-bubble.left::after { content: ""; position: absolute; right: -8px; top: 50%; transform: translateY(-50%);
      border: 8px solid transparent; border-left-color: var(--surface); }
    /* 모바일: 발 밑 가운데, 꼬리는 위로 */
    #mascot-bubble.below { transform: translateX(-50%); max-width: 78vw; text-align: center; }
    #mascot-bubble.below::after { content: ""; position: absolute; left: 50%; top: -8px; right: auto; bottom: auto;
      transform: translateX(-50%); border: 8px solid transparent; border-bottom-color: var(--surface); }
    :global(body > footer) {
      position: fixed;
      z-index: 3;
      left: 10px;
      bottom: 30px;
      padding: 0;
    }
    @media (max-width: 700px) {
      .page {
        margin: 0;
        max-width: none;
        padding: 0 16px 64px;
        font-size: var(--fs-sm);
        line-height: 1.65;
      }
      .page h1 {
        margin: 6px 0 16px;
        font-size: clamp(25px, 7vw, 32px);
        line-height: 1.22;
      }
      .links li {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2px;
        padding: 8px 0 10px;
      }
      .links span { width: auto; font-size: var(--fs-sm); line-height: 1.4; color: var(--text-3); }
      .links a { font-size: var(--fs-sm); line-height: 1.65; }
      :global(body > footer) { left: 16px; bottom: 18px; }
      #mascot-bubble { font-size: var(--fs-sm); padding: 8px 13px; border-radius: 14px; max-width: 70vw; }
      #mascot-bubble :global(.en) { font-size: var(--fs-2xs); margin-top: 3px; }
    }
  </style>

  <script is:inline>
    /* 마스코트가 사는 공간.
       홈 히어로와 같은 "입자의 결"을 쓰되 형태는 구체가 아니다. 히어로가 허공에 뜬
       구(球)라면 여기는 발 딛고 사는 장소여야 하므로, 원근이 있는 입자 지면과
       지평선을 만들고 공중에 먼지가 떠다니게 한다.
       three.js와 무관한 2D 캔버스라 마스코트가 로드되지 않아도 공간은 남는다. */
    ;(function () {
      var canvas = document.getElementById("habitat")
      var fx = document.getElementById("habitat-fx")
      if (!canvas || !fx) return
      var ctx = canvas.getContext("2d")
      var fxc = fx.getContext("2d")
      if (!ctx || !fxc) return
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      var W = 0, H = 0, dpr = 1, raf = 0
      var ground = [], motes = []
      // 캐릭터의 행동이 공간에 남기는 것들
      var sparks = []   // 타자를 칠 때 손끝에서 튀는 신호
      var rings = []    // 점프·박수 같은 한 번의 동작이 만드는 파문
      var lastSpark = 0
      var lastFootX = 0 // 발의 이동 속도 — 지면 입자가 끌리는 방향

      window.addEventListener("mascot:burst", function (e) {
        if (reduce) return
        rings.push({ x: e.detail.x, y: e.detail.y, r: 6, a: 0.5 })
      })

      // 지면 입자 — 바닥 평면 위에 흩뿌리고 원근 투영한다
      var NEAR = 1.1, FAR = 26

      function build() {
        var rect = canvas.getBoundingClientRect()
        W = Math.round(rect.width); H = Math.round(rect.height)
        dpr = Math.min(window.devicePixelRatio || 1, 2)
        canvas.width = W * dpr; canvas.height = H * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
        fx.width = W * dpr; fx.height = H * dpr
        fxc.setTransform(dpr, 0, 0, dpr, 0, 0)

        var gN = W < 700 ? 900 : 1700
        ground = []
        for (var i = 0; i < gN; i++) {
          // 가까울수록 촘촘하게 — 시선이 닿는 바닥이 실제로 있는 느낌
          var t = Math.pow(i / gN, 1.7)
          var z = NEAR + t * (FAR - NEAR)
          var spread = 9 + z * 1.5
          ground.push({
            x: (Math.random() - 0.5) * 2 * spread,
            z: z,
            j: Math.random() * 6.28, // 미세한 흔들림 위상
          })
        }

        /* 공중의 입자는 캐릭터를 감싸야 한다. 화면 전체에 균일하게 뿌리면
           캐릭터와 아무 관계가 없는 벽지가 되고, 왼쪽 연락처 위까지 덮어
           읽는 데 방해가 된다. 캐릭터 위치를 중심으로 한 정규분포로 두고
           좌표는 화면이 아니라 "캐릭터로부터의 거리"로 들고 있는다 —
           캐릭터가 움직이면 무리도 같이 간다. */
        var mN = W < 700 ? 190 : 330
        motes = []
        for (var k = 0; k < mN; k++) {
          motes.push({
            gx: gauss(),          // 캐릭터 기준 좌우 (σ=1)
            gy: gauss(),          // 캐릭터 기준 상하 (σ=1)
            // 깊이 — 음수면 캐릭터 앞, 양수면 뒤. 앞뒤 비율은 명시적으로 정한다.
            // 분포 하나로 섞어 두면 앞쪽이 10%밖에 안 나와 묻힌 느낌이 안 산다.
            dz: Math.random() < 0.3
              ? -0.72 * Math.random()
              : Math.pow(Math.random(), 0.75) * 3.1,
            r: 0.5 + Math.random() * 0.9,
            sp: 0.12 + Math.random() * 0.35,
            ph: Math.random() * 6.28,
          })
        }
      }

      // Box-Muller — 가운데가 촘촘하고 바깥으로 성글어지는 분포
      function gauss() {
        var u = 1 - Math.random()
        var v = Math.random()
        return Math.sqrt(-2 * Math.log(u)) * Math.cos(6.28318 * v)
      }

      function draw(time) {
        ctx.clearRect(0, 0, W, H)
        fxc.clearRect(0, 0, W, H)
        var t = reduce ? 0 : time * 0.001
        var cx = W / 2
        // 지평선 아래가 바닥. z=NEAR이 화면 맨 아래, z가 커질수록 지평선에 수렴한다.
        // 화면 기준으로 정규화해 뷰포트 비율이 바뀌어도 바닥이 항상 보이게 한다.
        var horizon = H * 0.60
        var depthPx = H - horizon

        /* 캐릭터의 발이 지면에 영향을 준다 — 배경 위에 얹힌 게 아니라 이 공간에 서 있는 것.
           발 주변 입자는 바깥으로 밀려나고 진해지며, 캐릭터가 움직이면 그 방향으로 끌린다. */
        var ms0 = window.__mascot
        var fX = ms0 ? ms0.footX : -9999
        var fY = ms0 ? ms0.footY : -9999
        var vel = 0
        if (ms0) {
          vel = Math.max(-30, Math.min(30, fX - lastFootX))
          lastFootX = fX
        }
        var PUSH_R = Math.max(150, W * 0.16) // 영향 반경

        for (var i = 0; i < ground.length; i++) {
          var p = ground[i]
          var zz = p.z / NEAR // 1부터 시작
          var sy = horizon + depthPx / zz
          if (sy > H + 4 || sy < horizon) continue
          var sx = cx + (p.x / zz) * (W * 0.055)
          if (sx < -4 || sx > W + 4) continue
          var wob = reduce ? 0 : Math.sin(t * 0.6 + p.j) * 0.35
          var fade = 1 / zz
          var r = 0.4 + fade * 1.3
          var alpha = 0.04 + fade * 0.2

          // 발의 영향 — 화면 좌표에서 계산한다
          var dxf = sx - fX, dyf = (sy - fY) * 1.9 // 세로는 원근 때문에 더 좁게 본다
          var df = Math.sqrt(dxf * dxf + dyf * dyf)
          if (df < PUSH_R) {
            var push = 1 - df / PUSH_R
            var inv = df > 0.001 ? 1 / df : 0
            // 바깥으로 밀려나고, 이동 방향으로 끌린다
            sx += dxf * inv * push * push * 26 + vel * push * 1.4
            sy += dyf * inv * push * push * 9
            r += push * 1.1
            alpha += push * 0.3
          }

          ctx.beginPath()
          ctx.arc(sx, sy + wob, r, 0, Math.PI * 2)
          ctx.fillStyle = "rgba(17,17,17," + alpha + ")"
          ctx.fill()
        }

        /* 공중의 먼지 — 캐릭터를 감싸는 층. 히어로와 같은 입자의 결을 유지하되
           위치는 캐릭터에 매여 있다. 마스코트가 아직 안 떴으면 화면 중앙을 쓴다. */
        /* 손과 발 사이는 몸 전체가 아니다 — 손은 머리끝에서 대략 7할 되는 지점이라
           그 중점을 쓰면 무리의 중심이 몸 중심보다 아래로 처지고 머리·어깨가 빈다. */
        var bodyH = ms0 ? Math.max(110, (fY - ms0.handY) * 1.45) : H * 0.4
        var mcx = ms0 ? fX : W / 2
        var mcy = ms0 ? fY - bodyH * 0.5 : H * 0.42
        /* 평면이 아니라 부피여야 캐릭터가 그 안에 묻힌다. 입자마다 깊이를 주고
           원근으로 투영한다 — 가까운 것은 크고 흐릿하게(초점 밖), 먼 것은 작고
           옅게. 깊이가 음수인 입자는 캐릭터 위 레이어에 그려 앞을 지나간다. */
        var SX = bodyH * 0.82   // 좌우 퍼짐
        var SY = bodyH * 0.72   // 상하 퍼짐 — 머리끝부터 발밑까지 덮는다
        var SPAN = bodyH * 2.2  // 위로 흐르다 되돌아오는 띠의 높이
        var FOCAL = bodyH * 1.7
        for (var k = 0; k < motes.length; k++) {
          var m = motes[k]
          var az = m.dz * FOCAL
          var s = FOCAL / (FOCAL + az)          // 원근 배율
          if (s <= 0.04) continue
          var ox = m.gx * SX + (reduce ? 0 : Math.sin(t * 0.5 + m.ph) * 7)
          var oy = m.gy * SY
          if (!reduce) {
            // 띠 안에서 위로 흐르고 넘치면 아래로 되돌아온다
            oy = ((oy - t * 12 * m.sp + SPAN * 1.5) % SPAN) - SPAN / 2
          }
          var px = mcx + ox * s
          var py = mcy + oy * s
          if (px < -8 || px > W + 8 || py < -8 || py > H + 8) continue

          var front = az < 0
          // 앞의 것은 가까울수록 크고 옅어진다 — 렌즈에서 초점이 나간 알갱이.
          // 짙게 두면 얼굴을 덮어 캐릭터가 더러워진다.
          var a = front ? 0.13 / s : 0.19 * Math.min(1, s)
          // 흐름 때문에 세로가 균일해지면 몸 주변이 헐거워진다. 몸 높이에서
          // 멀어질수록 옅게 해 무리의 중심을 캐릭터에 되돌린다.
          a *= Math.max(0.22, 1 - Math.abs(oy) / (SY * 2.4))
          var rr = Math.min(4.5, m.r * s)
          if (a <= 0.004 || rr < 0.15) continue
          var g2 = front ? fxc : ctx
          g2.beginPath()
          g2.arc(px, py, rr, 0, Math.PI * 2)
          g2.fillStyle = "rgba(17,17,17," + a.toFixed(3) + ")"
          g2.fill()
        }

        /* ── 캐릭터의 행동에 대한 반응 ──
           작업의 문법 그대로다: 신호가 발생하고, 전도되고, 감쇠한다. */
        var ms = window.__mascot
        if (ms && !reduce) {
          // 타자를 치는 동안 손끝에서 신호가 튄다
          if (ms.mode === "busy" && !ms.gesturing && time - lastSpark > 90) {
            lastSpark = time
            sparks.push({
              x: ms.handX + (Math.random() - 0.5) * 26,
              y: ms.handY + (Math.random() - 0.5) * 14,
              vx: (Math.random() - 0.5) * 0.5,
              vy: -0.35 - Math.random() * 0.5,
              a: 0.85,
            })
            if (sparks.length > 60) sparks.shift()
          }

          for (var s = sparks.length - 1; s >= 0; s--) {
            var sp = sparks[s]
            sp.x += sp.vx; sp.y += sp.vy; sp.a -= 0.007
            if (sp.a <= 0) { sparks.splice(s, 1); continue }
            fxc.beginPath()
            fxc.arc(sp.x, sp.y, 1.5, 0, Math.PI * 2)
            fxc.fillStyle = "rgba(17,17,17," + sp.a * 0.75 + ")"
            fxc.fill()
          }
          // 가까운 신호끼리 이어진다 — 전도(conduction)
          for (var a1 = 0; a1 < sparks.length; a1++) {
            for (var b1 = a1 + 1; b1 < sparks.length; b1++) {
              var p1 = sparks[a1], p2 = sparks[b1]
              var dx = p1.x - p2.x, dy = p1.y - p2.y
              var d2 = dx * dx + dy * dy
              if (d2 > 5184) continue // 72px 이내만
              var op = (1 - Math.sqrt(d2) / 72) * Math.min(p1.a, p2.a) * 0.4
              fxc.beginPath()
              fxc.moveTo(p1.x, p1.y)
              fxc.lineTo(p2.x, p2.y)
              fxc.strokeStyle = "rgba(17,17,17," + op + ")"
              fxc.lineWidth = 0.6
              fxc.stroke()
            }
          }
        }

        // 파문 — 한 번의 동작이 공간 전체로 퍼진다
        for (var r1 = rings.length - 1; r1 >= 0; r1--) {
          var rg = rings[r1]
