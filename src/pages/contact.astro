---
// hwanyun.com — Contact 페이지 (인터랙티브 3D 마스코트)
// 배포 전제: `npm install three` 완료, public/mascot/character.glb 존재
import Base from "../layouts/Base.astro"
---

<Base title="HWANYUN — Contact" current="contact">
  <article class="page">
    <p class="eyebrow">HWANYUN / CONTACT</p>
    <h1>Contact</h1>
    <ul class="links">
      <li><span>Email</span> <a href="mailto:hwanyun.lab@gmail.com">hwanyun.lab@gmail.com</a></li>
      <li><span>Instagram</span> <a href="https://instagram.com/hwanyun.lab" target="_blank" rel="noopener">@hwanyun.lab</a></li>
    </ul>
  </article>
  <div id="mascot-bg"></div>
  <canvas id="mascot-canvas"></canvas>
  <div id="mascot-bubble" aria-hidden="true"></div>

  <style>
    .page {
      position: relative; z-index: 3;
      margin: var(--desktop-header-clearance) 40px 100px var(--desktop-content-x);
      max-width: 460px; padding: 0; font-size: 16px; font-weight: 400; line-height: 1.7;
      pointer-events: none;
    }
    .page * { pointer-events: auto; }
    .page h1, .page li, .page a, .page .eyebrow { text-shadow: 0 0 6px #fff, 0 0 6px #fff, 0 0 10px #fff; }
    .page .eyebrow { margin: 0; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #888; }
    .page h1 { margin: 8px 0 24px; font-size: 38px; font-weight: 300; line-height: 1.15; }
    .links { list-style: none; padding: 0; margin: 0; }
    .links li { display: flex; gap: 16px; padding: 4px 0; }
    .links span { width: 90px; color: #555; }
    .links a { color: #111; text-decoration: none; position: relative; padding: 2px 2px; border-radius: 4px; transition: color .25s, background .25s, transform .25s; }
    .links a::after { content:""; position:absolute; left:2px; right:2px; bottom:-1px; height:2px; background:#111; transform:scaleX(0); transform-origin:left; transition:transform .3s; }
    .links a:hover::after, .links a.active::after { transform: scaleX(1); }
    .links a.active { color:#000; background:#fff59d55; transform: translateX(2px); }
    #mascot-canvas { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 2; pointer-events: none; }
    #mascot-canvas.grab { cursor: grab; } #mascot-canvas.grabbing { cursor: grabbing; }
    /* 커서를 따라 은은한 빛이 움직이는 배경 */
    #mascot-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(circle 42vmax at var(--mx, 55%) var(--my, 42%), #f3efe6 0%, #faf9f6 45%, #ffffff 75%); }
    /* 캐릭터 머리 위 말풍선 */
    #mascot-bubble { position: fixed; z-index: 4; pointer-events: none; left: -9999px; top: -9999px;
      background: #fff; color: #141414; border: 1px solid #e7e7e7; border-radius: 18px; padding: 13px 20px;
      font-size: 18px; font-weight: 600; line-height: 1.25; text-align: left; max-width: 300px;
      box-shadow: 0 12px 32px rgba(0,0,0,.14); opacity: 0; transition: opacity .22s ease; }
    #mascot-bubble.show { opacity: 1; }
    #mascot-bubble.right { transform: translateY(-50%); }
    #mascot-bubble.left  { transform: translate(-100%, -50%); }
    #mascot-bubble :global(.en) { display: block; margin-top: 5px; font-size: 12.5px; font-weight: 400; color: #a6a6a6; letter-spacing: .02em; }
    #mascot-bubble.right::after { content: ""; position: absolute; left: -8px; top: 50%; transform: translateY(-50%);
      border: 8px solid transparent; border-right-color: #fff; }
    #mascot-bubble.left::after { content: ""; position: absolute; right: -8px; top: 50%; transform: translateY(-50%);
      border: 8px solid transparent; border-left-color: #fff; }
    /* 모바일: 발 밑 가운데, 꼬리는 위로 */
    #mascot-bubble.below { transform: translateX(-50%); max-width: 78vw; text-align: center; }
    #mascot-bubble.below::after { content: ""; position: absolute; left: 50%; top: -8px; right: auto; bottom: auto;
      transform: translateX(-50%); border: 8px solid transparent; border-bottom-color: #fff; }
    :global(body > footer) {
      position: fixed;
      z-index: 3;
      left: 10px;
      bottom: 30px;
      padding: 0;
    }
    @media (max-width: 700px) {
      .page {
        margin: 0;
        max-width: none;
        padding: 0 16px 64px;
        font-size: 15px;
        line-height: 1.65;
      }
      .page h1 {
        margin: 6px 0 16px;
        font-size: clamp(25px, 7vw, 32px);
        line-height: 1.22;
      }
      .links li {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2px;
        padding: 8px 0 10px;
      }
      .links span { width: auto; font-size: 14px; line-height: 1.4; color: #777; }
      .links a { font-size: 15px; line-height: 1.65; }
      :global(body > footer) { left: 16px; bottom: 18px; }
      #mascot-bubble { font-size: 14px; padding: 8px 13px; border-radius: 14px; max-width: 70vw; }
      #mascot-bubble :global(.en) { font-size: 10.5px; margin-top: 3px; }
    }
  </style>

  <script>
    import * as THREE from "three";
    import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canvas = document.getElementById("mascot-canvas");
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 5000);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x8899aa, 2.4));
    const dl = new THREE.DirectionalLight(0xffffff, 2.2); dl.position.set(3, 10, 6); scene.add(dl);
    const shTex = (() => { const c = document.createElement("canvas"); c.width = c.height = 128; const g = c.getContext("2d"); const r = g.createRadialGradient(64,64,4,64,64,60); r.addColorStop(0,"rgba(0,0,0,.25)"); r.addColorStop(1,"rgba(0,0,0,0)"); g.fillStyle=r; g.fillRect(0,0,128,128); return new THREE.CanvasTexture(c); })();
    const shadow = new THREE.Mesh(new THREE.PlaneGeometry(1,1), new THREE.MeshBasicMaterial({ map: shTex, transparent: true, depthWrite: false }));
    shadow.rotation.x = -Math.PI/2; scene.add(shadow);
    const raycaster = new THREE.Raycaster(); const ptr = new THREE.Vector2(-2,-2);
    let model, avatar, mixer, actions = {}, current = null, modelMeshes = [];
    let STAGEX = 60;
    let avatarSize = null;
    const target = new THREE.Vector3(); const home = new THREE.Vector3();
    let dragging = false, noticed = false, waving = false, gesturing = false, presenting = null, homing = false, lastMove = 0, downX = 0, moved = false, clicks = 0;
    const IDLE_MS = 3000;   // 이 시간 동안 마우스 정지/이탈 시 자리로 돌아가 '일하기'

    // 말풍선(소통) + 인터랙티브 배경
    const bubble = document.getElementById("mascot-bubble");
    const bg = document.getElementById("mascot-bg");
    let bubbleUntil = 0;
    // en=메인(제목), ko=서브타이틀
    function say(ko, en, ms = 2400) { if (!bubble) return; const main = en || ko, sub = en ? ko : ""; bubble.innerHTML = main + (sub ? '<span class="en">' + sub + "</span>" : ""); bubble.classList.add("show"); bubbleUntil = performance.now() + ms; }

    // ▼ 튜닝: FILL 낮추면 캐릭터가 작아짐(전신 여유). STAGEX 비율은 좌우 이동 범위.
    const FILL = matchMedia("(max-width: 700px)").matches ? 0.66 : 0.55;

    new GLTFLoader().load("/mascot/character.glb", (gltf) => {
      model = gltf.scene;
      model.traverse(o => { if (o.isMesh) {
        o.frustumCulled = false;
        if (Array.isArray(o.material)) o.material.forEach(m => m.side = THREE.DoubleSide);
        else o.material.side = THREE.DoubleSide;
        modelMeshes.push(o);
      } });
      const box = new THREE.Box3().setFromObject(model); const size = new THREE.Vector3(); box.getSize(size);
      const center = new THREE.Vector3(); box.getCenter(center);
      avatar = new THREE.Group();
      model.position.set(-center.x, -center.y, -center.z);
      avatar.add(model); scene.add(avatar);
      avatarSize = size;
      frameAvatar();
      avatar.position.set(0, 0, 0);
      shadow.scale.setScalar(size.y*0.55); shadow.position.y = -size.y * 0.5 + 0.5;
      mixer = new THREE.AnimationMixer(model);
      for (const clip of gltf.animations) actions[clip.name] = mixer.clipAction(clip);
      setBusy();
      if (reduce) noticed = true;   // 모션 최소화: 인사/따라오기 없이 대기
    });

    function fadeTo(name, once = false) {
      const next = actions[name]; if (!next) return; if (current === next && !once) return;
      if (current) current.fadeOut(0.3); next.reset().fadeIn(0.3).play();
      next.setLoop(once ? THREE.LoopOnce : THREE.LoopRepeat, once ? 1 : Infinity);
      next.clampWhenFinished = once; current = next;
    }
    let mode = "busy";
    const setBusy = () => { mode = "busy"; fadeTo(actions.typing ? "typing" : "idle"); };
    const setAttentive = () => { mode = "attentive"; fadeTo("idle"); };
    const setWalking = () => { if (mode !== "walking") { mode = "walking"; fadeTo(actions.walk ? "walk" : "idle"); } };
    const setRunning = () => { if (mode !== "running") { mode = "running"; fadeTo(actions.running ? "running" : (actions.walk ? "walk" : "idle")); } };
    // 클릭(탭) 반응: 한 번 재생 후 대기로 복귀
    function reactOnce(name) { if (!actions[name]) { setAttentive(); return; } gesturing = true; fadeTo(name, true); const d = actions[name].getClip().duration*1000; setTimeout(() => { gesturing = false; setAttentive(); }, d + 400); }
    const updateTarget = () => { target.set(Math.max(-STAGEX, Math.min(STAGEX, ptr.x*STAGEX)), 0, 0); };
    const presentEl = (el) => {
      if (dragging || !avatar) return;
      noticed = true; waving = false; gesturing = false;
      setAttentive();
      const msg = (el.href || "").includes("mailto") ? { ko: "메일은 여기예요", en: "Do drop me a line ✉️" } : { ko: "인스타 구경 오세요", en: "Come have a nosey on Instagram 📸" };
      presenting = {
        el, msg,
        target: home.clone(),
        face: new THREE.Vector3(-STAGEX, 0, 0),
        arrived: false,
      };
    };
    document.querySelectorAll(".links a").forEach(a => a.addEventListener("pointerenter", () => presentEl(a)));
    // 메뉴(nav) 항목 설명 — 경로로 매칭, contact의 이메일/인스타 링크는 제외
    const MENU = {
      "/works":   { ko: "작업들을 둘러보세요", en: "Do peruse the works", gest: "jumping" },
      "/sound":   { ko: "사운드 작업이에요", en: "Sound pieces, have a listen", gest: "clapping" },
      "/cv":      { ko: "소개 페이지예요", en: "A little about me, the chap", gest: "wave" },
      "/contact": { ko: "지금 이 페이지예요", en: "You're already here! 🎩", gest: "thumbsup" },
      "/":        { ko: "처음으로", en: "Back to the top, then", gest: "running" },
    };
    let lastMenu = "";
    document.querySelectorAll("a[href]").forEach(a => {
      let path; try { path = new URL(a.href, location.href).pathname.replace(/\/$/, "") || "/"; } catch (e) { return; }
      if (!MENU[path] || a.closest(".links")) return;
      a.addEventListener("pointerenter", () => { if (dragging) return; noticed = true; homing = false; presenting = null;
        const m = MENU[path]; say(m.ko, m.en, 2600);
        if (path !== lastMenu) { lastMenu = path; if (m.gest) reactOnce(m.gest); }  // 메뉴마다 다른 액션 (연속 재진입 시 반복 방지)
      });
      a.addEventListener("pointerleave", () => { lastMenu = ""; });
    });

    // 모바일: hover가 없으니 캐릭터가 스스로 인사하고 이메일/인스타를 순회 소개
    if (matchMedia("(max-width: 700px)").matches) {
      const pois = Array.prototype.slice.call(document.querySelectorAll(".links a"));
      let step = 0;
      setInterval(() => {
        if (!model || dragging || gesturing || waving || presenting || document.hidden) return;
        if (step === 0) { step++; noticed = true;
          if (actions.wave) { waving = true; fadeTo("wave", true); const d = actions.wave.getClip().duration*1000; setTimeout(() => { waving = false; setAttentive(); }, d); }
          say("저를 탭해보세요!", "Tap me! 👆", 3200); return; }
        const el = pois[(step - 1) % pois.length]; step++; if (el) presentEl(el);
      }, 4800);
    }
    const HELLOS = [["안녕하세요!", "Oh, hello there! 👋"], ["어, 오셨네요!", "Ah, there you are"], ["반가워요 :)", "Fancy seeing you here"]];
    function firstNotice() { if (noticed) return; noticed = true;
      const h = HELLOS[Math.floor(clicks + performance.now()) % HELLOS.length] || HELLOS[0]; say(h[0], h[1]);
      if (actions.wave) { waving = true; fadeTo("wave", true); const d = actions.wave.getClip().duration*1000; setTimeout(() => { waving = false; setAttentive(); }, d); } else setAttentive(); }
    addEventListener("pointermove", e => { ptr.x = (e.clientX/innerWidth)*2-1; ptr.y = -(e.clientY/innerHeight)*2+1;
      if (bg) { bg.style.setProperty("--mx", e.clientX + "px"); bg.style.setProperty("--my", e.clientY + "px"); }
      updateTarget();
      lastMove = performance.now(); if (homing) homing = false;
      if (dragging && Math.abs(e.clientX - downX) > 6) moved = true;
      if (model && !noticed && !reduce) firstNotice();
      if (model && !dragging) { raycaster.setFromCamera(ptr, camera); const over = raycaster.intersectObjects(modelMeshes, true).length > 0; canvas.style.pointerEvents = over ? "auto" : "none"; canvas.classList.toggle("grab", over); } }, { passive: true });
    addEventListener("pointerdown", e => { if (!model) return;
      ptr.x = (e.clientX/innerWidth)*2-1; ptr.y = -(e.clientY/innerHeight)*2+1;   // 터치도 정확히 히트 판정
      raycaster.setFromCamera(ptr, camera);
      if (raycaster.intersectObjects(modelMeshes, true).length > 0) { dragging = true; moved = false; downX = e.clientX; mode = "dragging"; canvas.classList.add("grabbing"); presenting = null; noticed = true; homing = false; fadeTo(actions.hanging ? "hanging" : "idle"); }
    });
    addEventListener("pointerup", () => { if (dragging) { dragging = false; canvas.classList.remove("grabbing");
      if (!moved) { const seq = ["jumping", "clapping", "thumbsup"]; let name = seq[clicks % seq.length]; clicks++; if (!actions[name]) name = "jumping"; reactOnce(name);
        const m = { jumping: ["와!", "Splendid! 🎉"], clapping: ["짝짝짝!", "Bravo, jolly good! 👏"], thumbsup: ["좋아요!", "Top-notch! 👍"] }[name] || ["와!", "Splendid! 🎉"]; say(m[0], m[1], 1800); }  // 탭 = 점프→박수→엄지척 순환
      else { reactOnce(actions.falling ? "falling" : "idle"); say("으앗—!", "Steady on! 😵", 1500); } } });  // 드래그 후 놓기 = 툭 떨어지기
    function frameAvatar() {
      if (!avatarSize) return;
      const vFov = camera.fov * Math.PI / 180;
      const hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);
      const distanceForHeight = (avatarSize.y / (2 * FILL)) / Math.tan(vFov / 2);
      const distanceForWidth = (avatarSize.x / (2 * FILL)) / Math.tan(hFov / 2);
      // 모바일(세로)은 높이 기준으로 크게, 데스크탑은 가로/세로 중 더 먼 쪽으로 안전하게
      const distance = matchMedia("(max-width: 700px)").matches ? distanceForHeight : Math.max(distanceForHeight, distanceForWidth);
      // 시선을 살짝 위로 → 캐릭터가 화면 아래쪽에 앉아 상단 텍스트/말풍선 공간 확보
      const voff = avatarSize.y * (matchMedia("(max-width: 700px)").matches ? -0.02 : 0.15);
      camera.position.set(0, voff, distance); camera.lookAt(0, voff, 0);
      camera.far = distance * 6; camera.updateProjectionMatrix();
      const halfW = distance * Math.tan(hFov / 2);
      STAGEX = Math.max(0, halfW - avatarSize.x * 0.7);
    }
    function resize() { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth/innerHeight; frameAvatar(); }
    addEventListener("resize", resize); resize();
    const clock = new THREE.Clock(), tmpDir = new THREE.Vector3();
    function faceTowards(t) { const a = Math.atan2(t.x-avatar.position.x, t.z-avatar.position.z); let d = a-avatar.rotation.y; while (d > Math.PI) d -= 2*Math.PI; while (d < -Math.PI) d += 2*Math.PI; avatar.rotation.y += d*0.15; }
    function animate() { requestAnimationFrame(animate); const dt = clock.getDelta(); if (mixer) mixer.update(dt);
      if (model && avatar) { const pos = avatar.position;
        // 일정 시간 마우스 정지/이탈 → 자리로 복귀해 '일하기'. 다시 움직이면 인사부터 재시작.
        if (noticed && !dragging && !presenting && !waving && !gesturing && (performance.now() - lastMove) > IDLE_MS) { noticed = false; homing = true; }
        if (dragging) { updateTarget(); pos.x += (target.x-pos.x)*0.35; faceTowards(target); }
        else if (homing && !reduce) {
          const dist = Math.abs(pos.x - home.x);
          if (dist > 0.05*STAGEX) { setWalking(); tmpDir.set(home.x-pos.x,0,0).normalize(); pos.x += tmpDir.x*Math.max(dist,0.25*STAGEX)*dt*2.4; faceTowards(home); }
          else { homing = false; setBusy(); say("다시 작업할게요…", "Right, back to it ⌨️", 1800); }
        }
        else if (!noticed && !dragging && !reduce) { faceTowards({ x: pos.x, z: pos.z + 10 }); }  // 일하는 중엔 정면
        else if (!waving && !gesturing && noticed && !reduce) {
          const goal = presenting ? presenting.target : target; const dist = Math.abs(goal.x-pos.x); const stopAt = (presenting ? 0.14 : 0.22)*STAGEX;
          if (dist > stopAt) { const far = dist > 0.5*STAGEX; if (far) setRunning(); else setWalking(); tmpDir.set(goal.x-pos.x,0,0).normalize(); pos.x += tmpDir.x*dist*dt*(far ? 3.6 : 2.4); faceTowards(goal); }
          else if (presenting && !presenting.arrived) { presenting.arrived = true; presenting.el.classList.add("active"); say(presenting.msg.ko, presenting.msg.en, 2800);
            const gest = actions.pointing ? "pointing" : (actions.thumbsup ? "thumbsup" : (actions.wave ? "wave" : null));
            if (gest) { gesturing = true; fadeTo(gest, true); const g = presenting, d = actions[gest].getClip().duration*1000; setTimeout(() => { gesturing = false; if (g.el) g.el.classList.remove("active"); if (presenting === g) presenting = null; setAttentive(); }, d+900); }
            faceTowards(presenting.face); }
          else { if (mode === "walking" || mode === "running") setAttentive();
            // 멈추면 정면(관객)을 바라보되, 커서 쪽으로만 살짝 틀어 시선을 준다
            const look = presenting ? presenting.face : { x: pos.x + (target.x - pos.x) * 0.3, z: pos.z + 10 };
            if (mode === "attentive") faceTowards(look); }
        }
        shadow.position.x = pos.x; shadow.position.z = pos.z;
      }
      // 말풍선을 캐릭터 머리 옆(오른쪽 빈 공간, 없으면 왼쪽)에 고정 + 시간 지나면 숨김
      if (bubble && avatar && avatarSize) {
        if (matchMedia("(max-width: 700px)").matches) {
          // 모바일: 발 밑 가운데
          const fp = new THREE.Vector3(avatar.position.x, avatar.position.y - avatarSize.y * 0.5, avatar.position.z).project(camera);
          bubble.classList.remove("right", "left"); bubble.classList.add("below");
          bubble.style.left = ((fp.x * 0.5 + 0.5) * innerWidth) + "px";
          bubble.style.top = ((-fp.y * 0.5 + 0.5) * innerHeight + 16) + "px";
        } else {
          // 데스크탑: 머리 옆(오른쪽 우선, 공간 없으면 왼쪽)
          const hp = new THREE.Vector3(avatar.position.x, avatar.position.y + avatarSize.y * 0.34, avatar.position.z).project(camera);
          const sx = (hp.x * 0.5 + 0.5) * innerWidth, sy = (-hp.y * 0.5 + 0.5) * innerHeight;
          const gap = Math.max(120, innerWidth * 0.09);
          const right = sx < innerWidth * 0.6;
          bubble.classList.remove("below"); bubble.classList.toggle("right", right); bubble.classList.toggle("left", !right);
          bubble.style.left = (right ? sx + gap : sx - gap) + "px";
          bubble.style.top = sy + "px";
        }
      }
      if (bubble && bubble.classList.contains("show") && performance.now() > bubbleUntil) bubble.classList.remove("show");
      renderer.render(scene, camera);
    }
    animate();
  </script>
</Base>
