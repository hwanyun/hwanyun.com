    let STAGEX = 60;
    let avatarSize = null;
    const target = new THREE.Vector3(); const home = new THREE.Vector3();
    let dragging = false, noticed = false, waving = false, gesturing = false, presenting = null, homing = false, lastMove = 0, downX = 0, moved = false, clicks = 0;
    const IDLE_MS = 3000;   // 이 시간 동안 마우스 정지/이탈 시 자리로 돌아가 '일하기'

    // 말풍선(소통) + 인터랙티브 배경
    const bubble = document.getElementById("mascot-bubble");
    const bg = document.getElementById("mascot-bg");
    let bubbleUntil = 0;
    // en=메인(제목), ko=서브타이틀
    function say(ko, en, ms = 2400) { if (!bubble) return; const main = en || ko, sub = en ? ko : ""; bubble.innerHTML = main + (sub ? '<span class="en">' + sub + "</span>" : ""); bubble.classList.add("show"); bubbleUntil = performance.now() + ms; }

    // ▼ 튜닝: FILL 낮추면 캐릭터가 작아짐(전신 여유). STAGEX 비율은 좌우 이동 범위.
    // 모바일에서는 캐릭터를 작게 — 크면 좌측 상단의 연락처 정보를 덮는다.
