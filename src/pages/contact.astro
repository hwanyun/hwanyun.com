    /* 이메일 주소 복사 — 연락이 목적인 페이지이므로 마찰을 줄인다.
       클립보드 API가 막힌 환경(권한 거부·비보안 컨텍스트)에서도 동작해야 하므로
       execCommand 폴백을 둔다. 실패하면 버튼을 숨겨 링크만 남긴다. */
    ;(function () {
      var btn = document.querySelector(".copy")
      if (!btn) return
      var text = btn.getAttribute("data-copy")

      function feedback(ok) {
        if (!ok) { btn.hidden = true; return }
        btn.textContent = "Copied"
        btn.classList.add("done")
        setTimeout(function () { btn.textContent = "Copy"; btn.classList.remove("done") }, 1600)
      }
      function legacy() {
        try {
          var ta = document.createElement("textarea")
          ta.value = text
          ta.setAttribute("readonly", "")
          ta.style.cssText = "position:fixed;top:-9999px;opacity:0"
          document.body.appendChild(ta)
          ta.select()
          var ok = document.execCommand("copy")
          document.body.removeChild(ta)
          return ok
        } catch (e) { return false }
      }

      btn.addEventListener("click", function () {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(
            function () { feedback(true) },
            function () { feedback(legacy()) }
          )
        } else {
          feedback(legacy())
        }
      })
    })()
  </script>

  <script>
    import * as THREE from "three";
    import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canvas = document.getElementById("mascot-canvas");
