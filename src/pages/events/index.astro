---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"

const events = (await getCollection("events", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.dateStart.localeCompare(b.data.dateStart) || (a.data.order ?? 0) - (b.data.order ?? 0)
)

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
function fmtOne(date: string) {
  const d = date.split("-").map(Number)
  if (!d[0]) return date
  return `${d[2]} ${MONTHS[d[1] - 1]} ${d[0]}`
}
function fmt(start: string, end: string) {
  const s = start.split("-").map(Number)
  if (!s[0]) return start
  const sd = `${s[2]} ${MONTHS[s[1] - 1]}`
  if (end) {
    const e = end.split("-").map(Number)
    if (e[1] === s[1] && e[0] === s[0]) return `${s[2]}–${e[2]} ${MONTHS[s[1] - 1]} ${s[0]}`
    return `${sd} – ${e[2]} ${MONTHS[e[1] - 1]} ${e[0]}`
  }
  return `${sd} ${s[0]}`
}
---

<Base title="HWANYUN — Events" current="events">
  <main class="events">
    <header class="events-head">
      <p class="eyebrow">HWANYUN / EVENTS</p>
      <h1>Events</h1>
      <p class="intro">Exhibitions, performances, and screenings.</p>
    </header>

    {/* 모든 일정을 한 곳에 렌더링해 두고, 아래 스크립트가 오늘 날짜 기준으로
        다가오는 일정 / 지난 일정으로 나눈다. 정적 사이트라 빌드 시점에 고정하면
        전시가 끝나도 그대로 남기 때문에, 분류는 브라우저에서 한다. */}
    <ul class="ev-pool" id="ev-pool" hidden>
      {
        events.map((e) => (
          <li
            class="ev"
            data-start={e.data.dateStart}
            data-end={e.data.dateEnd || e.data.dateStart}
            data-until={e.data.dateEnd ? `Until ${fmtOne(e.data.dateEnd)}` : ""}
          >
            <a class="ev-link" href={`/events/${e.slug}/`}>
              <span class="ev-date">{fmt(e.data.dateStart, e.data.dateEnd)}</span>
              <span class="ev-main">
                <span class="ev-title">{e.data.title}</span>
                {(e.data.venue || e.data.city) && (
                  <span class="ev-where">
                    {[e.data.venue, e.data.city].filter(Boolean).join(", ")}
                  </span>
                )}
              </span>
              <span class="ev-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    {/* 진행 중 + 예정을 한 리스트에. 진행 중인 항목은 날짜가 "Until …"로 바뀐다. */}
    <section id="ev-next" aria-label="Exhibitions and events" hidden>
      <ul class="ev-list" id="ev-next-list"></ul>
    </section>

    <section id="ev-past" aria-label="Past" hidden>
      <h2 class="ev-secth">Past</h2>
      <div id="ev-past-groups"></div>
    </section>

    <p class="ev-empty" id="ev-empty" hidden>예정된 일정이 아직 없습니다 · No upcoming events yet.</p>
  </main>

  <script is:inline>
    ;(function () {
      var today = new Date()
      today.setHours(0, 0, 0, 0)
      var pool = document.getElementById("ev-pool")
      if (!pool) return

      var next = [] // 진행 중 + 예정
      var past = []

      Array.prototype.slice.call(pool.querySelectorAll(".ev")).forEach(function (li) {
        var start = new Date((li.getAttribute("data-start") || "") + "T00:00:00")
        var end = new Date((li.getAttribute("data-end") || "") + "T23:59:59")
        if (isNaN(start) || isNaN(end)) return
        if (end < today) { past.push(li); return }
        // 진행 중이면 날짜를 "Until …"로 바꿔 지금 볼 수 있다는 걸 드러낸다.
        if (start <= today) {
          li.classList.add("ev-on")
          var until = li.getAttribute("data-until")
          var dateEl = li.querySelector(".ev-date")
          if (until && dateEl) dateEl.textContent = until
        }
        next.push(li)
      })

      function byStart(dir) {
        return function (a, b) {
          var x = a.getAttribute("data-start") || ""
          var y = b.getAttribute("data-start") || ""
          return dir * x.localeCompare(y)
        }
      }
      next.sort(byStart(1)) // 시작일 오름차순 — 진행 중이 자연히 위로 온다
      past.sort(byStart(-1))

      if (next.length) {
        var nextList = document.getElementById("ev-next-list")
        next.forEach(function (li) { nextList.appendChild(li) })
        document.getElementById("ev-next").hidden = false
      } else {
        document.getElementById("ev-empty").hidden = false
      }

      // 지난 일정은 연도별로 묶어 역순 — 이력이 쌓여도 읽힌다.
      if (past.length) {
        var groups = document.getElementById("ev-past-groups")
        var byYear = {}
        past.forEach(function (li) {
          var y = (li.getAttribute("data-start") || "").slice(0, 4)
          ;(byYear[y] = byYear[y] || []).push(li)
        })
        Object.keys(byYear).sort().reverse().forEach(function (y) {
          var h = document.createElement("h3")
          h.className = "ev-year"
          h.textContent = y
          var ul = document.createElement("ul")
          ul.className = "ev-list ev-list-past"
          byYear[y].forEach(function (li) { ul.appendChild(li) })
          groups.appendChild(h)
          groups.appendChild(ul)
        })
        document.getElementById("ev-past").hidden = false
      }
    })()
  </script>

  <style>
    .events {
      margin: var(--desktop-header-clearance) 40px 120px var(--desktop-content-x);
      max-width: 720px;
    }
    .events-head { margin-bottom: 40px; }
    .eyebrow { margin: 0; font-size: var(--fs-2xs); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
    .events h1 { margin: 8px 0 16px; font-size: var(--fs-display); font-weight: 300; line-height: 1.15; }
    .intro { font-size: var(--fs-sm); color: var(--text-3); margin: 0; max-width: 460px; line-height: 1.6; }

    .ev-list { list-style: none; margin: 0; padding: 0; }
    .ev { border-top: 1px solid var(--line); }
    .ev:last-child { border-bottom: 1px solid var(--line); }
    .ev-link {
      display: grid;
      grid-template-columns: 150px 1fr auto;
      gap: 18px;
      align-items: baseline;
      padding: 18px 4px;
      color: var(--text);
      text-decoration: none;
      transition: background 0.15s ease, padding-left 0.2s ease;
    }
    .ev-link:hover { background: var(--surface-2); padding-left: 10px; }
    .ev-date { font-size: var(--fs-sm); color: var(--text-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ev-main { display: flex; flex-direction: column; gap: 4px; }
    .ev-title { font-size: var(--fs-body); line-height: 1.3; }
    .ev-where { font-size: var(--fs-sm); color: var(--text-3); }
    .ev-arrow { color: var(--text-4); font-size: var(--fs-body); transition: transform 0.2s ease, color 0.2s ease; }
    .ev-link:hover .ev-arrow { color: var(--text); transform: translateX(3px); }

    .ev-empty { color: var(--text-4); font-size: var(--fs-sm); padding: 26px 4px; }
    .ev-pool { display: none; }
    .ev-secth { font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-4); margin: 46px 0 8px; font-weight: 500; }
    #ev-upcoming .ev-secth { margin-top: 0; }
    .ev-list-past .ev-title { color: var(--text-2); }
    .ev-list-past .ev-date { color: var(--text-4); }
    /* 연도 헤더와 그 아래 ul은 스크립트가 만들기 때문에 Astro 스코프 속성이 붙지 않는다.
       :global 로 빼지 않으면 스타일이 적용되지 않는다. */
    :global(.ev-year) {
      font-size: var(--fs-xs); color: var(--text); font-weight: 400;
      margin: 30px 0 6px; font-variant-numeric: tabular-nums;
    }
    :global(#ev-past-groups > .ev-year:first-child) { margin-top: 10px; }
    :global(#ev-past-groups .ev-list) { list-style: none; margin: 0; padding: 0; }

    /* 진행 중 — 섹션을 나누는 대신 날짜를 "Until …"로 바꾸고 살짝만 강조한다 */
    .ev-on .ev-date { color: var(--text); }
    .ev-on .ev-title { font-weight: 400; }
    .ev-on .ev-date::before {
      content: ""; display: inline-block; vertical-align: 2px;
      width: 5px; height: 5px; margin-right: 7px; border-radius: 50%; background: var(--text);
    }

    @media (max-width: 700px) {
      .events { margin: 0 16px 80px; padding-top: 8px; max-width: none; }
      .events h1 { font-size: clamp(25px, 7vw, 32px); line-height: 1.22; }
      .ev-link { grid-template-columns: 1fr auto; gap: 6px 12px; padding: 16px 2px; }
      .ev-date { grid-column: 1 / -1; order: -1; font-size: var(--fs-xs); }
      .ev-title { font-size: var(--fs-body); }
    }
  </style>
</Base>
