---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"

const events = (await getCollection("events", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.dateStart.localeCompare(b.data.dateStart) || (a.data.order ?? 0) - (b.data.order ?? 0)
)

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
function fmt(start: string, end: string) {
  const s = start.split("-").map(Number)
  if (!s[0]) return start
  const sd = `${s[2]} ${MONTHS[s[1] - 1]}`
  if (end) {
    const e = end.split("-").map(Number)
    if (e[1] === s[1] && e[0] === s[0]) return `${s[2]}–${e[2]} ${MONTHS[s[1] - 1]} ${s[0]}`
    return `${sd} – ${e[2]} ${MONTHS[e[1] - 1]} ${e[0]}`
  }
  return `${sd} ${s[0]}`
}
---

<Base title="HWANYUN — Events" current="events">
  <main class="events">
    <header class="events-head">
      <p class="eyebrow">HWANYUN / EVENTS</p>
      <h1>Events</h1>
      <p class="intro">Exhibitions, performances, and screenings — upcoming and past.</p>
    </header>

    <section id="ev-upcoming" aria-label="Upcoming">
      <ul class="ev-list">
        {
          events.map((e) => (
            <li class="ev" data-start={e.data.dateStart} data-end={e.data.dateEnd || e.data.dateStart}>
              <a class="ev-link" href={`/events/${e.slug}/`}>
                <span class="ev-date">{fmt(e.data.dateStart, e.data.dateEnd)}</span>
                <span class="ev-main">
                  <span class="ev-title">{e.data.title}</span>
                  {(e.data.venue || e.data.city) && (
                    <span class="ev-where">
                      {[e.data.venue, e.data.city].filter(Boolean).join(", ")}
                    </span>
                  )}
                </span>
                <span class="ev-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="ev-empty" id="ev-empty-up" hidden>다가오는 일정이 아직 없습니다 · No upcoming events yet.</p>
    </section>

    <section id="ev-past" aria-label="Past" hidden>
      <h2 class="ev-pasth">Past</h2>
      <ul class="ev-list ev-list-past" id="ev-past-list"></ul>
    </section>
  </main>

  <script is:inline>
    ;(function () {
      var today = new Date()
      today.setHours(0, 0, 0, 0)
      var upList = document.querySelector("#ev-upcoming .ev-list")
      var pastSec = document.getElementById("ev-past")
      var pastList = document.getElementById("ev-past-list")
      var emptyUp = document.getElementById("ev-empty-up")
      if (!upList) return
      var all = Array.prototype.slice.call(upList.querySelectorAll(".ev"))
      var past = []
      all.forEach(function (li) {
        var end = new Date((li.getAttribute("data-end") || "") + "T23:59:59")
        if (!isNaN(end) && end < today) past.push(li)
      })
      // 지난 일정: 최신순으로 Past 섹션에 이동
      past.sort(function (a, b) {
        return (b.getAttribute("data-start") || "").localeCompare(a.getAttribute("data-start") || "")
      })
      past.forEach(function (li) { pastList.appendChild(li) })
      if (past.length) pastSec.hidden = false
      // 남은 다가오는 일정이 없으면 안내
      if (!upList.querySelector(".ev")) emptyUp.hidden = false
    })()
  </script>

  <style>
    .events {
      margin: var(--desktop-header-clearance) 40px 120px var(--desktop-content-x);
      max-width: 720px;
    }
    .events-head { margin-bottom: 40px; }
    .eyebrow { font-size: 11px; letter-spacing: 0.14em; color: #999; margin: 0 0 10px; text-transform: uppercase; }
    .events h1 { font-size: 30px; font-weight: 400; margin: 0 0 10px; }
    .intro { font-size: 15px; color: #666; margin: 0; max-width: 460px; line-height: 1.6; }

    .ev-list { list-style: none; margin: 0; padding: 0; }
    .ev { border-top: 1px solid #e6e6e6; }
    .ev:last-child { border-bottom: 1px solid #e6e6e6; }
    .ev-link {
      display: grid;
      grid-template-columns: 150px 1fr auto;
      gap: 18px;
      align-items: baseline;
      padding: 18px 4px;
      color: #111;
      text-decoration: none;
      transition: background 0.15s ease, padding-left 0.2s ease;
    }
    .ev-link:hover { background: #fafafa; padding-left: 10px; }
    .ev-date { font-size: 14px; color: #666; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ev-main { display: flex; flex-direction: column; gap: 4px; }
    .ev-title { font-size: 18px; line-height: 1.3; }
    .ev-where { font-size: 14px; color: #888; }
    .ev-arrow { color: #bbb; font-size: 16px; transition: transform 0.2s ease, color 0.2s ease; }
    .ev-link:hover .ev-arrow { color: #111; transform: translateX(3px); }

    .ev-empty { color: #999; font-size: 15px; padding: 26px 4px; }
    .ev-pasth { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin: 46px 0 8px; font-weight: 500; }
    .ev-list-past .ev-title { color: #555; }
    .ev-list-past .ev-date { color: #999; }

    @media (max-width: 700px) {
      .events { margin: 0 16px 80px; padding-top: 8px; max-width: none; }
      .events h1 { font-size: 24px; }
      .ev-link { grid-template-columns: 1fr auto; gap: 6px 12px; padding: 16px 2px; }
      .ev-date { grid-column: 1 / -1; order: -1; font-size: 13px; }
      .ev-title { font-size: 16px; }
    }
  </style>
</Base>
