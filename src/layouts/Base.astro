---
import SiteMenu from "../components/SiteMenu.astro"

// chrome: 첫 화면이 어두운 페이지만 "dark"를 명시한다. 잊으면 밝은 배경 기준으로
// 안전하게 폴백하므로, 페이지가 자기 이름을 알릴 필요가 없다.
const {
  title = "HWANYUN",
  current = "",
  chrome = "light",
  // 공유 카드 — 페이지가 자기 얼굴을 가질 수 있게 열어 둔다.
  // 전시 링크를 메신저에 붙일 때 사이트 기본 카드보다 포스터가 훨씬 많은 걸 말한다.
  image = "",
  /* 작가 노트의 첫 문장에서 가져온다. "sound, installation, and interactive
     media"는 수천 명이 똑같이 쓰는 분류표이고, 검색 결과와 메신저 카드에
     실려 나가는 한 줄이 그 분류표면 이 사람이 누구인지 아무도 알 수 없다.
     이미 쓰여 있는 문장이 있는데 쓰지 않고 있었다. */
  description = "Sound, light, material, and the body alter one another — installations and interactive systems by HWANYUN.",
  imageAlt = "HWANYUN particle sphere forming the wordmark",
} = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, "https://www.hwanyun.com").href
const shareImage = new URL(
  image || "/images/social/hwanyun-share-preview.png",
  "https://www.hwanyun.com"
).href
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /* 페인트 전에 저장된 언어를 적용한다. 늦으면 영문이 번쩍 보였다가 바뀐다. */
      ;(function () {
        try {
          var l = localStorage.getItem("hy:lang")
          if (l === "ko" || l === "en") {
            document.documentElement.dataset.lang = l
            document.documentElement.lang = l
          }
        } catch (e) {}
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HWANYUN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Pretendard Variable 셀프호스트 — 동적 서브셋(unicode-range)이라
        브라우저가 필요한 글리프 블록만 받는다. 외부 폰트 요청 0. */}
    <link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.css" />
    <slot name="head" />
  </head>
  <body data-chrome={chrome}>
    {/* 모바일 메뉴 뒤를 덮는 스크림. 패널은 내용만큼만 열리고 나머지는 이 층이
        어둡게 받는다 — 페이지 맥락이 남아 어디에 있었는지 알 수 있고, 여기를
        탭하면 닫힌다는 것도 관습으로 읽힌다. 메뉴 안에 두면(가상 요소로 두면)
        탭이 메뉴를 향한 것으로 잡혀 바깥 클릭 닫기가 걸리지 않는다. */}
    <div class="menu-scrim" hidden></div>
    <slot name="menu">
      <SiteMenu variant="page" current={current} />
    </slot>
    {/* 언어는 내비게이션이 아니라 설정이다 — 링크 목록에 끼우지 않고
        우상단 코너에 텍스트로만 둔다 (데스크톱). 모바일은 햄버거 패널 안. */}
    <nav class="lang-corner" aria-label="Language">
      <button type="button" data-lang-choice="en" aria-pressed="true">EN</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-lang-choice="ko" aria-pressed="false">KO</button>
    </nav>
    <slot />
    <div class="cursor-dot" aria-hidden="true"></div>

    {/* 위로 — 긴 페이지(작품 상세는 도판이 일곱 겹이다)에서 상단으로 돌아갈
        방법이 없었다. 스크롤이 한 화면을 넘어가면 나타난다. */}
    <button type="button" class="to-top" id="to-top" hidden aria-label="Back to top">
      <span aria-hidden="true">↑</span>
    </button>
    <footer>
      © 2014–<span id="footer-year">{new Date().getFullYear()}</span> HWANYUN
    </footer>

    <script is:inline>
      /* 위로 — 한 화면 넘게 내려가면 나타난다. 홈은 히어로가 fixed라
         스크롤 위치가 곧 그리드의 덮임 정도이므로 같은 기준이 그대로 통한다. */
      ;(function () {
        var btn = document.getElementById("to-top")
        if (!btn) return
        var shown = false
        function upd() {
          var want = window.scrollY > window.innerHeight * .9
          if (want === shown) return
          shown = want
          btn.hidden = !want
        }
        window.addEventListener("scroll", upd, { passive: true })
        window.addEventListener("resize", upd)
        btn.addEventListener("click", function () {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" })
        })
        upd()
      })()
    </script>

    <script is:inline>
      /* 빌드 시점 연도가 박히면 재배포 없이 해가 바뀔 때 낡는다. 브라우저에서 보정한다. */
      ;(function () {
        var el = document.getElementById("footer-year")
        if (el) el.textContent = String(new Date().getFullYear())
      })()
    </script>

    <script is:inline>
      ;(function () {
        if (!window.matchMedia("(pointer: fine)").matches) return
        var dot = document.querySelector(".cursor-dot")
        if (!dot) return
        window.addEventListener("pointermove", function (event) {
          dot.style.transform = "translate3d(" + event.clientX + "px," + event.clientY + "px,0) translate(-50%,-50%)"
          dot.classList.add("is-visible")
        })
        document.addEventListener("mouseleave", function () { dot.classList.remove("is-visible") })
      })()
    </script>

    <script is:inline>
      /* 언어 전환 — 전역. 저장하고 문서 속성만 바꾼다.
         CV·About은 별도 라우트(/cv ↔ /cv/ko)라 이동으로 처리한다. */
      ;(function () {
        var ROUTED = { "/cv": "/cv/ko", "/about": "/about/ko" }
        var ROUTED_BACK = { "/cv/ko": "/cv", "/about/ko": "/about" }
        function norm(p) { return p.replace(/\/$/, "") || "/" }

        function paint(lang) {
          document.documentElement.dataset.lang = lang
          document.documentElement.lang = lang
          document.querySelectorAll("[data-lang-choice]").forEach(function (b) {
            b.setAttribute("aria-pressed", String(b.getAttribute("data-lang-choice") === lang))
          })
          /* 스크립트가 만든 UI에는 위의 언어 전환 CSS가 닿지 않는다.
             그런 곳들이 스스로 다시 그릴 수 있게 알린다. */
          document.dispatchEvent(new CustomEvent("hy:lang", { detail: lang }))
        }
        paint(document.documentElement.dataset.lang || "en")

        document.querySelectorAll("[data-lang-choice]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var lang = btn.getAttribute("data-lang-choice")
            try { localStorage.setItem("hy:lang", lang) } catch (e) {}
            var here = norm(location.pathname)
            var to = lang === "ko" ? ROUTED[here] : ROUTED_BACK[here]
            if (to) { location.pathname = to; return }
            paint(lang)
          })
        })

        /* 라우팅형 페이지에 직접 들어온 경우, 그 URL이 곧 선택이다 */
        var here = norm(location.pathname)
        if (ROUTED_BACK[here]) { try { localStorage.setItem("hy:lang", "ko") } catch (e) {} ; paint("ko") }
        else if (ROUTED[here]) { try { localStorage.setItem("hy:lang", "en") } catch (e) {} ; paint("en") }
      })()
    </script>

    <script is:inline>
      /* 메뉴 동작 단일 소스 — 페이지에 있는 모든 .site-menu(page/hero/grid)에 같은 규칙을 건다. */
      ;(function () {
        var menus = document.querySelectorAll(".site-menu")
        if (!menus.length) return

        /* 시트가 열려 있는 동안 뒤 페이지는 움직이지 않아야 한다. 잠그지 않으면
           시트 안에서 손가락을 움직였을 때 뒤 목록이 따라 스크롤되고, 닫았을 때
           보던 자리를 잃는다. 위치를 기억했다가 닫을 때 그대로 돌려놓는다. */
        var scrollLock = 0
        /* 위치는 반드시 is-open을 붙이기 전에 읽어 넘겨야 한다. 열린 메뉴는
           position: fixed라 헤더가 흐름에서 빠지고, 그만큼(69px) 문서가 짧아지면
           브라우저가 스크롤을 최댓값으로 잘라낸다 — 그 뒤에 읽으면 이미 밀린
           값이라 닫을 때 보던 자리보다 그만큼 위로 돌아간다. */
        function lockScroll(at) {
          if (document.body.dataset.menuLocked) return
          scrollLock = typeof at === "number" ? at : window.scrollY
          document.body.dataset.menuLocked = "1"
          document.body.style.position = "fixed"
          document.body.style.top = -scrollLock + "px"
          document.body.style.width = "100%"
        }
        function unlockScroll() {
          if (!document.body.dataset.menuLocked) return
          delete document.body.dataset.menuLocked
          document.body.style.position = ""
          document.body.style.top = ""
          document.body.style.width = ""
          window.scrollTo(0, scrollLock)
        }
        var isMobileMenu = function () { return window.matchMedia("(max-width: 700px)").matches }

        var scrim = document.querySelector(".menu-scrim")
        function showScrim() {
          if (!scrim) return
          scrim.hidden = false
          // hidden을 떼자마자 같은 프레임에 클래스를 붙이면 전환이 생략된다
          requestAnimationFrame(function () { scrim.classList.add("is-visible") })
        }
        function hideScrim() {
          if (!scrim) return
          scrim.classList.remove("is-visible")
          scrim.hidden = true
        }

        Array.prototype.forEach.call(menus, function (menu) {
          var toggle = menu.querySelector(".menu-hamburger")
          var workLink = menu.querySelector(".works-toggle")

          if (toggle) {
            toggle.addEventListener("click", function () {
              var at = window.scrollY   // 클래스를 붙이기 전의 위치 (lockScroll 주석 참조)
              var isOpen = menu.classList.toggle("is-open")
              toggle.setAttribute("aria-expanded", String(isOpen))
              toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation")
              if (isMobileMenu()) {
                if (isOpen) { lockScroll(at); showScrim() }
                else { unlockScroll(); hideScrim() }
              }
            })
          }

          if (workLink) {
            workLink.addEventListener("click", function (event) {
              // Works 아카이브에 이미 있으면 이동 대신 아코디언만 편다.
              var path = window.location.pathname
              if (path !== "/works" && path !== "/works/") return
              event.preventDefault()
              var isWorksOpen = menu.classList.toggle("works-open")
              workLink.setAttribute("aria-expanded", String(isWorksOpen))
            })
          }

          document.addEventListener("pointerdown", function (event) {
            if (!menu.classList.contains("is-open") || menu.contains(event.target)) return
            menu.classList.remove("is-open", "works-open")
            if (toggle) toggle.setAttribute("aria-expanded", "false")
            if (workLink) workLink.setAttribute("aria-expanded", "false")
            unlockScroll()
            hideScrim()
          })

          /* 링크를 눌러 페이지를 떠나면 잠금이 남는다 — bfcache로 돌아왔을 때
             스크롤이 묶인 채로 열린다. 떠나기 전에 반드시 푼다. */
          menu.addEventListener("click", function (event) {
            var link = event.target.closest ? event.target.closest("a[href]") : null
            if (link && !link.classList.contains("works-toggle")) { unlockScroll(); hideScrim() }
          })
          window.addEventListener("pagehide", function () { unlockScroll(); hideScrim() })

          // 다른 페이지에서 "Works"로 넘어온 경우 메뉴를 펼친 상태로 연다.
          if (window.location.hash === "#menu-works") {
            menu.classList.add("is-open", "works-open")
            if (toggle) toggle.setAttribute("aria-expanded", "true")
            if (workLink) workLink.setAttribute("aria-expanded", "true")
          }
        })
      })()
    </script>

    <style is:global>
      /* ────────────────────────────────────────────────────────────
         디자인 토큰 — 새 hex 값과 새 font-size를 페이지에 직접 쓰지 않는다.
         필요한 값이 없으면 여기에 단계를 추가하고 그 변수를 쓴다.
         (근거·규칙: REDESIGN_ROADMAP.md Phase 1)
         ──────────────────────────────────────────────────────────── */
      :root {
        /* 밝은 배경 위 텍스트 — 4단계 */
        --text: #111;        /* 본문·제목 */
        --text-2: #555;      /* 부제·캡션 */
        --text-3: #888;      /* 메타·보조 정보 */
        --text-4: #767676;   /* 라벨·eyebrow — 흰 배경 4.5:1 (이전 #aaa는 2.3:1로 읽기 어려웠다) */

        /* 면과 선 */
        --surface: #fff;
        --surface-2: #f7f7f3; /* 옅은 강조 배경 */
        --line: #e6e6e6;      /* 기본 헤어라인 */
        --line-2: #c8c8c8;    /* 강한 구분선 */

        /* 어두운 면(히어로) 위 텍스트 */
        --void: #0a0b0d;
        --void-text: #ececea;
        --void-text-2: #9a9a9a;
        --void-label: #b7c4d6;
        --void-line: #556;

        --hover: #00f;

        /* 모션 — 3단계와 이징 1종. 이 밖의 값을 새로 쓰지 않는다.
           fast: 색·불투명도 / base: 형태·위치 / slow: 등장·레이아웃 */
        --mobile-header-h: 67px;  /* 고정 모바일 헤더 실측 높이 — 그리드가 이만큼 비켜 앉는다 */
        --dur-fast: 150ms;
        --dur-base: 250ms;
        --dur-slow: 450ms;
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1);

        /* 스페이싱 — 컨트롤의 내부 여백과 요소 간격 */
        --space-1: 6px;
        --space-2: 12px;
        --space-3: 24px;
        --space-4: 48px;

        /* 타입 스케일 — 7단계 */
        --fs-display: 38px;  /* 페이지 h1 */
        --fs-title: 30px;    /* 작품 제목 */
        --fs-lead: 22px;     /* 로고·리드 */
        --fs-body: 18px;     /* 본문 */
        --fs-sm: 15px;       /* 부가 정보 */
        --fs-xs: 13px;       /* 메타·푸터 */
        --fs-2xs: 11px;      /* eyebrow·태그 */

        --w-1col: 380px;
        --w-2col: 460px;
        --w-3col: 540px;
        --gap: 10px;
        /* 카테고리 간 본문 폭 통일 (Works/Sound/Bio) */
        --content-w: 900px;
        /* 모든 데스크톱 본문·구분선의 공통 시작 열: 좌측 Works 메뉴의 오른쪽 여백과 맞춘다. */
        --desktop-content-x: 170px;
        /* 데스크톱에서는 작가명과 본문을 분리하는 공통 헤더 여백 */
        --desktop-header-clearance: 82px;
        --sans: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont,
          system-ui, "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
      }
      * { box-sizing: border-box; }
      /* hidden 대신 clip — hidden은 스크롤 컨테이너를 만들어 홈 히어로의
         position: sticky를 깨뜨린다. clip은 잘라내기만 하고 컨테이너를 안 만든다. */
      html, body { overflow-x: clip; }
      body {
        font-family: var(--sans);
        /* 300은 18px 이상에서만 성립한다 — 본문·메타는 400, 라이트는 h1 전용 */
        font-weight: 400;
        font-size: var(--fs-body);
        line-height: 1.35;
        letter-spacing: -0.01em;
        color: var(--text);
        background: var(--surface);
        margin: 0;
        padding: 0;
        word-break: keep-all;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      h1 { letter-spacing: -0.02em; }

      /* ── 언어 시스템 ──────────────────────────────────────────
         크롬(메뉴·라벨·버튼·날짜)은 영문 고정. 서술 콘텐츠만 전환한다.
         병기 대신 전환 — 읽는 사람에게 한 벌만 보여 준다. */
      html[data-lang="en"] [data-language-content="ko"],
      html[data-lang="ko"] [data-language-content="en"] { display: none !important; }
      /* 전환되는 문단은 단(column)을 나누지 않는다 — 한 번에 한 언어만 보이므로
         제 폭을 쓴다. 이것이 병기를 걷어내는 실질적 이득이다. */
      html [data-language-content] { max-width: 62ch; }

      /* ── 컨트롤 형태 규칙 ───────────────────────────────────
         이동(메뉴·링크)      = 텍스트 + 밑줄
         필터·태그(회로 노드)  = 필 + 점
         모드 전환            = 사각 세그먼트
         외부 링크 버튼        = 사각 + ↗
         새 컨트롤은 이 넷 중 하나를 따른다. */
      /* 언어 토글 공통 — 박스가 아니라 텍스트. 설정은 조용해야 한다. */
      /* 토글은 자기 팔레트를 갖지 않는다 — 얹힌 면의 색을 상속받는다.
         그래서 페이지가 밝은지 어두운지 이 규칙이 알 필요가 없다. */
      .lang-corner,
      .lang-switch { color: var(--chrome-fg, var(--text)); }
      .lang-corner button,
      .lang-switch button {
        padding: 2px 1px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: color-mix(in srgb, currentColor 55%, transparent);
        font: 400 var(--fs-2xs)/1 var(--sans);
        letter-spacing: .08em;
        transition: color var(--dur-fast) var(--ease);
      }
      .lang-corner button:hover,
      .lang-switch button:hover { color: var(--hover); }
      .lang-corner button[aria-pressed="true"],
      .lang-switch button[aria-pressed="true"] {
        color: currentColor;
        /* 밑줄은 border가 아니라 text-decoration — 터치 타깃용 패딩을 키워도
           밑줄이 글자에서 떨어지지 않는다 */
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
      }

      /* 데스크톱: 우상단 코너 */
      .lang-corner {
        position: absolute;
        top: 26px;
        right: 24px;
        z-index: 40;
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        font-size: var(--fs-2xs);
      }
      /* 구분자 '/'는 두 라벨보다 더 물러나 있어야 한다 */
      .lang-corner > span[aria-hidden] { color: color-mix(in srgb, currentColor 32%, transparent); }
      /* 어두운 첫 화면을 가진 페이지만 문맥색을 바꾼다 (지금은 홈 히어로) */
      body[data-chrome="dark"] { --chrome-fg: var(--void-text); }
      /* 메뉴 안의 토글은 데스크톱에서 숨긴다 — 코너가 대신한다 */
      .site-menu .lang-switch { display: none; }
      a { color: var(--text); text-decoration: none; }
      a:hover { color: var(--hover); }

      /* 위로 — 우하단. 사이트의 조용한 어휘를 따른다: 얇은 선, 색 하나로만 반응.
         푸터가 하단에 있으므로 그보다 위에 뜨고, 홈에서는 검은 히어로 위에
         올 수 있으니 문맥색(--chrome-fg)을 쓴다. */
      .to-top {
        position: fixed;
        right: 22px;
        bottom: 26px;
        z-index: 40;
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--chrome-fg, var(--text)) 26%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--surface) 82%, transparent);
        color: var(--chrome-fg, var(--text));
        font-size: var(--fs-sm);
        line-height: 1;
        cursor: pointer;
        transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
      }
      .to-top[hidden] { display: none; }
      .to-top:hover { border-color: var(--hover); color: var(--hover); }
      /* 홈의 검은 히어로 위에서는 배경도 어둡게 — 흰 원이 뜨면 구체를 가린다 */
      body[data-chrome="dark"] .to-top { background: color-mix(in srgb, var(--void) 72%, transparent); }
      @media (max-width: 700px) {
        .to-top { right: 16px; bottom: 18px; width: 38px; height: 38px; }
      }

      .cursor-dot { display: none; }
      @media (pointer: fine) {
        html, body, a, button, input, textarea, select, video, iframe { cursor: none !important; }
        .cursor-dot {
          position: fixed;
          top: 0;
          left: 0;
          z-index: 100;
          display: block;
          width: 14px;
          height: 14px;
          border-radius: 50%;
          background: var(--surface);
          mix-blend-mode: difference;
          pointer-events: none;
          opacity: 0;
          transition: opacity var(--dur-fast) ease;
        }
        .cursor-dot.is-visible { opacity: 1; }
      }

      /* ── 메뉴 ─────────────────────────────────────────────────
         마크업은 components/SiteMenu.astro 하나, 스타일은 여기 한 곳,
         동작은 위 스크립트 하나. variant(page/hero/grid)로만 갈라진다.
         ──────────────────────────────────────────────────────── */
      .site-menu { margin: 0; line-height: 1.5; }
      .site-menu .name { font-size: var(--fs-lead); font-weight: 500; margin-bottom: 12px; }
      .site-menu a { display: block; color: var(--text); }
      .site-menu a:hover { border-bottom: 1px solid var(--hover); width: fit-content; }
      .site-menu a.current { border-bottom: 1px solid var(--text); width: fit-content; }
      /* 아래 셋은 모바일 아코디언 전용 — 데스크톱에서는 항상 숨김 */
      .site-menu .menu-hamburger { display: none; }
      .site-menu .works-toggle { display: none; }
      .site-menu .work-links { display: none; }

      .menu-search { margin: 14px 0 0; }
      .site-menu--grid #search { margin-top: 14px; }
      /* 검색은 '이동' 계열이다 — 박스가 아니라 밑줄.
         사이트에서 유일하게 무거운 테두리였다. */
      .site-menu input[type="search"] {
        display: block;
        width: 110px;
        padding: 3px 0;
        border: 0;
        border-bottom: 1px solid var(--line-2);
        border-radius: 0;
        color: var(--text);
        background: transparent;
        outline: 0;
        font: inherit;
        font-size: var(--fs-sm);
        transition: border-color var(--dur-fast) var(--ease);
        -webkit-appearance: none;
      }
      .site-menu input[type="search"]::placeholder { color: var(--text-3); opacity: 1; }
      .site-menu input[type="search"]:focus { border-bottom-color: var(--hover); }

      /* variant: page — 일반 페이지 좌상단 */
      .site-menu--page {
        position: absolute;
        z-index: 20;
        top: 10px;
        left: 10px;
        width: 140px;
      }
      /* variant: hero — 데스크톱에서는 메뉴를 숨겨 구체를 가리지 않는다.
         다만 워드마크 하나는 남긴다. 처음 온 사람이 여기가 누구 사이트인지
         알 수 없는 채로 스크롤을 도박해야 하는 상태였다. */
      .site-menu--hero {
        position: absolute;
        z-index: 20;
        top: 24px;
        left: 24px;
        width: auto;
      }
      .site-menu--hero > *:not(.name) { display: none; }
      .site-menu--hero .name { margin: 0; }
      .site-menu--hero .name a {
        color: var(--void-text-2);
        transition: color var(--dur-fast) var(--ease);
      }
      .site-menu--hero .name a:hover { color: var(--void-text); border-bottom: 0; }
      /* variant: grid — 홈 작품 그리드 위 오버레이 (데스크톱 전용) */
      .site-menu--grid {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 3;
        width: 210px;
        padding: 15px 18px 18px;
        background: var(--surface);
        font-size: var(--fs-body);
      }

      footer {
        clear: both;
        padding: 60px 10px 30px;
        font-size: var(--fs-xs);
        color: var(--text-3);
      }

      @media (max-width: 700px) {
        /* grid variant는 모바일에서 hero가 대신한다 */
        .site-menu--grid { display: none; }

        .site-menu--page,
        .site-menu--hero {
          z-index: 30;
          display: grid;
          grid-template-columns: 1fr auto auto;
          width: 100%;
          min-height: 58px;
          margin: 0;
          padding: 18px;
          color: var(--text);
        }
        /* hero는 검은 히어로 위에 뜬다 — 어두운 글자면 보이지 않는다.
           열리면 흰 반투명 패널이 깔리므로 그때는 다시 어두운 글자로 돌아간다. */
        .site-menu--hero:not(.is-open) {
          color: var(--void-text);
          background: transparent;
          line-height: 1.4;
        }
        /* page는 문서 흐름 안에서 시작해 열릴 때만 고정, hero는 항상 히어로 위에 떠 있다 */
        .site-menu--page { position: relative; top: auto; left: auto; width: 100%; }
        .site-menu--hero { position: fixed; inset: 0 0 auto; transition: color var(--dur-base) ease; }
        /* 히어로를 벗어나면 숨기는 대신 잉크를 뒤집는다. 그리드는 이제 독립된 한 페이지라
           숨기면 그 페이지에 내비게이션이 하나도 남지 않는다 — 모바일에서 grid variant는
           표시되지 않으므로 이 메뉴가 유일하다.
           색은 --chrome-fg 하나만 바꾼다: 토글은 얹힌 면의 색을 상속받게 되어 있다(위 참조).
           워드마크도 그대로 둔다 — 접으면 좌측이 비어 컨트롤만 우측에 몰려 어색하고,
           남겨두면 다른 페이지의 모바일 헤더와 같은 구성이 된다. 그리드 상단 흰 여백
           안에 앉으므로 타일을 가리지도 않는다. */
        .site-menu--hero.is-past-hero:not(.is-open) {
          --chrome-fg: var(--text);
          color: var(--text);
        }

        /* 아이콘은 28×24지만 누르는 영역은 44×44여야 한다. 패딩으로 넓히고
           같은 만큼 마진으로 당겨, 헤더 높이는 그대로 두고 타깃만 키운다. */
        .site-menu .menu-hamburger {
          display: block;
          grid-column: 3;
          grid-row: 1;
          justify-self: end;
          /* 타깃을 키우려 넣은 패딩 때문에 44px 상자가 되면서 아이콘 중심이
             이름·언어보다 4.5px 위로 올라갔다 — 행 가운데에 맞춘다. */
          align-self: center;
          width: 28px;
          height: 24px;
          padding: 10px 8px;
          margin: -10px -8px;
          box-sizing: content-box;
          border: 0;
          border-radius: 0;
          color: inherit;
          background: transparent;
        }
        .site-menu .menu-hamburger span { display: none; }
        .site-menu .menu-hamburger::after {
          content: "☰";
          display: block;
          color: currentColor;
          font-size: var(--fs-lead);
          font-weight: 500;
          line-height: 24px;
        }
        .site-menu .name {
          grid-column: 1;
          grid-row: 1;
          margin: 0;
          align-self: center;
          font-size: var(--fs-lead);
        }
        /* 이름·언어·닫기(정체성과 조작)와 그 아래 목적지 목록은 다른 묶음인데
           간격이 0이라 한 덩어리로 붙어 읽혔다. 헤더 행에 아래 여백을 준다.
           셋 다 같은 값을 받아야 한다 — 하나에만 주면 그 항목의 바깥 상자만
           커지고, align-self: center가 그 상자를 기준으로 삼아 혼자 위로 뜬다.
           값은 12px으로는 부족했다 — 글자 기준 간격이 27px가 되어 항목 사이
           간격(25px)과 같아지고, 워드마크가 헤더가 아니라 목록의 첫 항목처럼
           읽혔다. 묶음을 가르는 간격은 묶음 안의 간격보다 뚜렷이 넓어야 한다. */
        .site-menu.is-open .name,
        .site-menu.is-open .lang-switch { margin-bottom: var(--space-3); }
        .site-menu.is-open .menu-hamburger { margin-bottom: calc(var(--space-3) - 10px); }
        /* 손가락으로 누르는 항목은 44px 이상이어야 한다(iOS HIG 44pt / Material 48dp).
           마진으로 벌리면 줄 간격만 늘고 누를 수 있는 영역은 그대로다 —
           패딩으로 키워 글자 주변까지 실제 타깃이 되게 한다. */
        .site-menu > a {
          display: none;
          grid-column: 1 / -1;
          width: fit-content;
          margin-top: 0;
          padding: 10px 0;
          min-height: 44px;
          align-content: center;
          font-size: var(--fs-body);
        }
        .site-menu .name a { display: block; }

        /* 열린 메뉴는 내용만큼 내려오는 불투명 패널이고, 나머지는 스크림이 받는다.
           원래 문제는 높이가 아니라 배경이 50% 투명이라 뒤의 필터 칩과 작품
           목록이 글자 사이로 비친 것이었다. 화면을 통째로 덮어 해결할 수도 있지만
           항목이 다섯 개뿐이라 빈 흰 화면만 300px 넘게 남는다 — 페이지를 가리는
           대가로 얻는 게 없다. 맥락을 스크림 너머로 남긴다.
           작품 아코디언이 펼쳐져 길어지면 패널 자신이 스크롤한다. */
        .site-menu.is-open {
          position: fixed;
          inset: 0 0 auto;
          padding-bottom: max(22px, env(safe-area-inset-bottom));
          background: var(--surface);
          max-height: 88dvh;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
          overscroll-behavior: contain;
          align-content: start;
        }
        .site-menu.is-open > a { display: block; }
        /* 열려 있음을 아이콘으로도 알린다 — aria-label만 바뀌고 ☰ 그대로였다 */
        .site-menu.is-open .menu-hamburger::after { content: "✕"; }
        /* 아코디언이 열리면 평범한 Works 링크는 감추고 토글이 그 자리를 대신한다 */
        .site-menu.is-open .menu-works-link { display: none; }
        .site-menu.is-open .works-toggle {
          display: grid;
          grid-column: 1 / -1;
          width: fit-content;
          margin-top: 0;
          padding: 10px 0;
          min-height: 44px;
          align-content: center;
          border: 0;
          color: inherit;
          background: transparent;
          font: inherit;
          font-size: var(--fs-body);
          line-height: 1.4;
        }
        .site-menu.is-open .work-links {
          display: grid;
          grid-column: 1 / -1;
          /* 항목 자체가 패딩으로 40px를 확보하므로 간격을 더 두면 늘어지기만 한다 */
          gap: 0;
          max-height: 0;
          margin: 0;
          padding: 0 0 0 13px;
          overflow: hidden;
          border-left: 1px solid rgba(0, 0, 0, .35);
          opacity: 0;
          pointer-events: none;
          transition: max-height var(--dur-slow) ease, margin var(--dur-base) ease, padding var(--dur-base) ease, opacity var(--dur-base) ease;
        }
        .site-menu.is-open.works-open .work-links {
          max-height: min(46svh, 350px);
          margin: 4px 0 8px;
          padding: 5px 0 5px 13px;
          overflow-y: auto;
          opacity: 1;
          pointer-events: auto;
        }
        /* 작품 목록은 한 화면에 여러 개가 보여야 하므로 44px까지는 못 키운다.
           대신 40px로 올려 손가락이 옆 항목을 건드리지 않을 만큼은 확보한다. */
        .site-menu.is-open .work-links a {
          display: grid;
          margin: 0;
          padding: 6px 0;
          min-height: 40px;
          align-content: center;
          color: var(--text-2);
          font-size: var(--fs-xs);
          line-height: 1.35;
        }
        .site-menu.is-open .work-links .all-works { font-weight: 500; }

        /* 코너 토글은 데스크톱 전용 — 모바일에서는 헤더 안의 lang-switch가 그 역할을 한다 */
        .lang-corner { display: none; }

        /* 패널 바로 아래 층. 페이지를 지우지 않고 뒤로 물린다. */
        .menu-scrim {
          position: fixed;
          inset: 0;
          z-index: 29;
          background: rgba(0, 0, 0, .45);
          opacity: 0;
          transition: opacity var(--dur-base) ease;
        }
        .menu-scrim.is-visible { opacity: 1; }
        /* 언어는 햄버거를 열지 않아도 보여야 한다. 크롬이 영문 고정이라,
           패널 안에만 두면 한국어가 있다는 사실 자체가 드러나지 않는다.
           같은 그리드 안(이름 | EN/KO | ☰)이라 정렬에 매직 넘버가 필요 없다. */
        .site-menu .lang-switch {
          display: inline-flex;
          gap: 8px;
          grid-column: 2;
          grid-row: 1;
          align-self: center;
          justify-self: end;
          margin: 0 14px 0 0;
        }
        /* 터치 타깃 44px — 헤더 높이는 그대로 두고 눌리는 영역만 넓힌다 */
        .site-menu .lang-switch button { padding: 13px 4px; margin: -13px 0; }
        .site-menu--hero:not(.is-open) .name a { color: var(--void-text); }
        /* 그리드로 넘어가면 흰 면 위다 — 워드마크도 어두운 잉크로 */
        .site-menu--hero.is-past-hero:not(.is-open) .name a { color: var(--text); }
        .menu-search { display: none; grid-column: 1 / -1; margin: 16px 0 0; }
        /* 헤더에 접혀 있을 때는 110px이 맞지만, 시트가 열리면 화면 폭을 다 쓴다 —
           좁은 입력란은 타이핑도 어렵고 시트 안에서 미완성처럼 보인다. */
        .site-menu input[type="search"] { width: min(110px, 100%); }
        /* 검색은 목적지가 아니라 다른 기능이다. 목록 사이 간격(47px)보다 좁은
           16px으로 붙어 있어 마지막 메뉴 항목처럼 보였다 — 묶음을 떼어 놓는다. */
        .site-menu.is-open .menu-search { display: block; margin-top: var(--space-3); }
        .site-menu.is-open input[type="search"] { width: 100%; padding: 10px 0; }
      }
    </style>
  </body>
</html>
