---
import { getCollection } from "astro:content"

const { title = "HWANYUN", current = "" } = Astro.props
const nav = [
  { label: "Works", href: "/works", key: "works" },
  { label: "Sound", href: "/sound", key: "sound" },
  { label: "Bio", href: "/cv", key: "bio" },
  { label: "Contact", href: "/contact", key: "contact" },
]
const workMenu = await getCollection("works", ({ data }) => !data.draft)
workMenu.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0d" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot name="menu">
      <nav class="menu" id="site-menu">
        <div class="name"><a href="/">HWANYUN</a></div>
        <button class="menu-hamburger" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-menu">
          <span></span><span></span><span></span>
        </button>
        {
          nav.map((n) => (
            <>
              {n.key === "works" ? (
                <>
                  <a href={n.href} class={`menu-works-link ${current === n.key ? "current" : ""}`}>{n.label}</a>
                  <a class="works-toggle" href="/works/#menu-works" aria-expanded="false" aria-controls="menu-work-links">Works</a>
                </>
              ) : (
                <a href={n.href} class={current === n.key ? "current" : ""}>{n.label}</a>
              )}
              {n.key === "works" && (
                <div class="work-links" id="menu-work-links" aria-label="Works">
                  <a href="/works/" class="all-works">All Works</a>
                  {workMenu.map((work) => <a href={`/works/${work.slug}/`}>{work.data.title}</a>)}
                </div>
              )}
            </>
          ))
        }
      </nav>
    </slot>
    <slot />
    <div class="cursor-dot" aria-hidden="true"></div>
    <footer>COPYRIGHT © 2014 HWANYUN. All rights reserved.</footer>

    <script is:inline>
      ;(function () {
        if (!window.matchMedia("(pointer: fine)").matches) return
        var dot = document.querySelector(".cursor-dot")
        if (!dot) return
        window.addEventListener("pointermove", function (event) {
          dot.style.transform = "translate3d(" + event.clientX + "px," + event.clientY + "px,0) translate(-50%,-50%)"
          dot.classList.add("is-visible")
        })
        document.addEventListener("mouseleave", function () { dot.classList.remove("is-visible") })
      })()
    </script>

    <script is:inline>
      ;(function () {
        var menu = document.getElementById("site-menu")
        var toggle = menu && menu.querySelector(".menu-hamburger")
        if (!menu || !toggle) return
        toggle.addEventListener("click", function () {
          var isOpen = menu.classList.toggle("is-open")
          toggle.setAttribute("aria-expanded", String(isOpen))
          toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation")
        })
        document.addEventListener("pointerdown", function (event) {
          if (!menu.classList.contains("is-open") || menu.contains(event.target)) return
          menu.classList.remove("is-open", "works-open")
          toggle.setAttribute("aria-expanded", "false")
          var workLink = menu.querySelector(".works-toggle")
          if (workLink) workLink.setAttribute("aria-expanded", "false")
        })
        if (window.location.hash === "#menu-works") {
          menu.classList.add("is-open", "works-open")
          toggle.setAttribute("aria-expanded", "true")
          var workLink = menu.querySelector(".works-toggle")
          if (workLink) workLink.setAttribute("aria-expanded", "true")
        }
      })()
    </script>

    <style is:global>
      :root {
        --w-1col: 380px;
        --w-2col: 460px;
        --w-3col: 540px;
        --gap: 10px;
        /* 카테고리 간 본문 폭 통일 (Works/Sound/Bio) */
        --content-w: 900px;
        --hover: #00f;
        --sans: "Noto Sans KR", sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { overflow-x: hidden; }
      body {
        font-family: var(--sans);
        font-weight: 300;
        font-size: 18px;
        line-height: 1.35;
        color: #000;
        background: #fff;
        margin: 0;
        padding: 0;
        word-break: keep-all;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a { color: #000; text-decoration: none; }
      a:hover { color: var(--hover); }

      .cursor-dot { display: none; }
      @media (pointer: fine) {
        html, body, a, button, input, textarea, select, video, iframe { cursor: none !important; }
        .cursor-dot {
          position: fixed;
          top: 0;
          left: 0;
          z-index: 100;
          display: block;
          width: 14px;
          height: 14px;
          border-radius: 50%;
          background: #fff;
          mix-blend-mode: difference;
          pointer-events: none;
          opacity: 0;
          transition: opacity 0.18s ease;
        }
        .cursor-dot.is-visible { opacity: 1; }
      }

      .menu {
        float: left;
        width: 140px;
        margin: 10px 0 0 10px;
        line-height: 1.5;
      }
      .menu-hamburger { display: none; }
      .works-toggle { display: none; }
      .work-links { display: none; }
      .menu .name { font-weight: 500; margin-bottom: 12px; }
      .menu a { display: block; }
      .menu a:hover { border-bottom: 1px solid var(--hover); width: fit-content; }
      .menu a.current { border-bottom: 1px solid #000; width: fit-content; }

      footer {
        clear: both;
        padding: 60px 10px 30px;
        font-size: 13px;
        color: #888;
      }

      @media (max-width: 700px) {
        .menu {
          position: relative;
          z-index: 30;
          display: grid;
          grid-template-columns: 1fr auto;
          width: 100%;
          margin: 0;
          min-height: 58px;
          padding: 18px 18px;
          color: #000;
          background: transparent;
          line-height: 1.4;
        }
        .menu .menu-hamburger {
          display: block !important;
          grid-column: 2;
          grid-row: 1;
          justify-self: end;
          width: 28px;
          height: 24px;
          padding: 0;
          border: 0;
          border-radius: 0;
          color: #000;
          background: transparent;
        }
        .menu .menu-hamburger span {
          display: none;
        }
        .menu .menu-hamburger::after {
          content: "☰";
          display: block;
          color: currentColor;
          font-size: 19px;
          font-weight: 500;
          line-height: 24px;
        }
        .menu .name {
          grid-column: 1;
          grid-row: 1;
          margin: 0;
          align-self: center;
          font-size: 16px;
        }
        .menu > a {
          display: none;
          grid-column: 1 / -1;
          width: fit-content;
          margin-top: 10px;
          font-size: 18px;
        }
        .menu.is-open {
          position: fixed;
          inset: 0 0 auto;
          padding-bottom: 22px;
          background: rgba(255, 255, 255, .50);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
        }
        .menu.is-open > a { display: block; }
        .menu.is-open .menu-works-link { display: none; }
        .menu.is-open .works-toggle {
          display: block;
          grid-column: 1 / -1;
          width: fit-content;
          margin-top: 10px;
          padding: 0;
          border: 0;
          color: inherit;
          background: transparent;
          font: inherit;
          font-size: 18px;
          line-height: 1.4;
        }
        .menu.is-open .work-links {
          display: grid;
          grid-column: 1 / -1;
          gap: 7px;
          max-height: 0;
          margin: 0;
          padding: 0 0 0 13px;
          overflow: hidden;
          border-left: 1px solid rgba(0, 0, 0, .35);
          opacity: 0;
          pointer-events: none;
          transition: max-height .38s ease, margin .28s ease, padding .28s ease, opacity .22s ease;
        }
        .menu.is-open.works-open .work-links {
          max-height: min(46svh, 350px);
          margin: 4px 0 8px;
          padding: 5px 0 5px 13px;
          overflow-y: auto;
          opacity: 1;
          pointer-events: auto;
        }
        .menu.is-open .work-links a {
          display: block;
          margin: 0;
          color: #333;
          font-size: 13px;
          line-height: 1.35;
        }
        .menu.is-open .work-links .all-works { font-weight: 500; }
      }
    </style>
  </body>
</html>
