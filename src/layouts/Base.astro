---
import { getCollection } from "astro:content"

const { title = "HWANYUN", current = "" } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, "https://www.hwanyun.com").href
const shareImage = "https://www.hwanyun.com/images/social/hwanyun-share-preview.png"
const nav = [
  { label: "Works", href: "/works", key: "works" },
  { label: "Sound", href: "/sound", key: "sound" },
  { label: "Events", href: "/events", key: "events" },
  { label: "Bio", href: "/cv", key: "bio" },
  { label: "Contact", href: "/contact", key: "contact" },
]
const workMenu = await getCollection("works", ({ data }) => !data.draft)
const sortYear = (year: string) => Math.max(...(year.match(/\d{4}/g) ?? ["0"]).map(Number))
workMenu.sort((a, b) => {
  const byYear = sortYear(b.data.year) - sortYear(a.data.year)
  return byYear || (a.data.order ?? 0) - (b.data.order ?? 0)
})
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0d" />
    <title>{title}</title>
    <meta name="description" content="HWANYUN — sound, installation, and interactive media." />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HWANYUN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Sound, installation, and interactive media." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="HWANYUN particle sphere" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Sound, installation, and interactive media." />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot name="menu">
      <nav class="menu" id="site-menu">
        <div class="name"><a href="/">HWANYUN</a></div>
        <button class="menu-hamburger" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-menu">
          <span></span><span></span><span></span>
        </button>
        {
          nav.map((n) => (
            <>
              {n.key === "works" ? (
                <>
                  <a href={n.href} class={`menu-works-link ${current === n.key ? "current" : ""}`}>{n.label}</a>
                  <a class="works-toggle" href="/works/#menu-works" aria-expanded="false" aria-controls="menu-work-links">Works</a>
                </>
              ) : (
                <a href={n.href} class={current === n.key ? "current" : ""}>{n.label}</a>
              )}
              {n.key === "works" && (
                <div class="work-links" id="menu-work-links" aria-label="Works">
                  <a href="/works/" class="all-works">All Works</a>
                  {workMenu.map((work) => <a href={`/works/${work.slug}/`}>{work.data.title}</a>)}
                </div>
              )}
            </>
          ))
        }
        <form class="menu-search" action="/" role="search">
          <input type="search" name="q" placeholder="Search" aria-label="Search works" autocomplete="off" />
        </form>
      </nav>
    </slot>
    <slot />
    <div class="cursor-dot" aria-hidden="true"></div>
    <footer>COPYRIGHT © 2014 HWANYUN. All rights reserved.</footer>

    <script is:inline>
      ;(function () {
        if (!window.matchMedia("(pointer: fine)").matches) return
        var dot = document.querySelector(".cursor-dot")
        if (!dot) return
        window.addEventListener("pointermove", function (event) {
          dot.style.transform = "translate3d(" + event.clientX + "px," + event.clientY + "px,0) translate(-50%,-50%)"
          dot.classList.add("is-visible")
        })
        document.addEventListener("mouseleave", function () { dot.classList.remove("is-visible") })
      })()
    </script>

    <script is:inline>
      ;(function () {
        var menu = document.getElementById("site-menu")
        var toggle = menu && menu.querySelector(".menu-hamburger")
        if (!menu || !toggle) return
        toggle.addEventListener("click", function () {
          var isOpen = menu.classList.toggle("is-open")
          toggle.setAttribute("aria-expanded", String(isOpen))
          toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation")
        })
        var workLink = menu.querySelector(".works-toggle")
        if (workLink) {
          workLink.addEventListener("click", function (event) {
            var onWorksArchive = window.location.pathname === "/works" || window.location.pathname === "/works/"
            if (!onWorksArchive) return
            event.preventDefault()
            var isWorksOpen = menu.classList.toggle("works-open")
            workLink.setAttribute("aria-expanded", String(isWorksOpen))
          })
        }
        document.addEventListener("pointerdown", function (event) {
          if (!menu.classList.contains("is-open") || menu.contains(event.target)) return
          menu.classList.remove("is-open", "works-open")
          toggle.setAttribute("aria-expanded", "false")
          if (workLink) workLink.setAttribute("aria-expanded", "false")
        })
        if (window.location.hash === "#menu-works") {
          menu.classList.add("is-open", "works-open")
          toggle.setAttribute("aria-expanded", "true")
          if (workLink) workLink.setAttribute("aria-expanded", "true")
        }
      })()
    </script>

    <style is:global>
      :root {
        --w-1col: 380px;
        --w-2col: 460px;
        --w-3col: 540px;
        --gap: 10px;
        /* 카테고리 간 본문 폭 통일 (Works/Sound/Bio) */
        --content-w: 900px;
        /* 모든 데스크톱 본문·구분선의 공통 시작 열: 좌측 Works 메뉴의 오른쪽 여백과 맞춘다. */
        --desktop-content-x: 170px;
        /* 데스크톱에서는 작가명과 본문을 분리하는 공통 헤더 여백 */
        --desktop-header-clearance: 82px;
        --hover: #00f;
        --sans: "Noto Sans KR", sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { overflow-x: hidden; }
      body {
        font-family: var(--sans);
        font-weight: 300;
        font-size: 18px;
        line-height: 1.35;
        color: #000;
        background: #fff;
        margin: 0;
        padding: 0;
        word-break: keep-all;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a { color: #000; text-decoration: none; }
      a:hover { color: var(--hover); }

      .cursor-dot { display: none; }
      @media (pointer: fine) {
        html, body, a, button, input, textarea, select, video, iframe { cursor: none !important; }
        .cursor-dot {
          position: fixed;
          top: 0;
          left: 0;
          z-index: 100;
          display: block;
          width: 14px;
          height: 14px;
          border-radius: 50%;
          background: #fff;
          mix-blend-mode: difference;
          pointer-events: none;
          opacity: 0;
          transition: opacity 0.18s ease;
        }
        .cursor-dot.is-visible { opacity: 1; }
      }

      .menu {
        position: absolute;
        z-index: 20;
        top: 10px;
        left: 10px;
        width: 140px;
        margin: 0;
        line-height: 1.5;
      }
      .menu-hamburger { display: none; }
      .menu .works-toggle { display: none; }
      .work-links { display: none; }
      .menu-search { margin: 14px 0 0; }
      .menu-search input {
        display: block;
        width: 110px;
        height: 34px;
        padding: 6px 9px;
        border: 1px solid #000;
        border-radius: 0;
        color: #000;
        background: transparent;
        outline: 0;
        font: inherit;
        font-size: 15px;
        -webkit-appearance: none;
      }
      .menu-search input::placeholder { color: #000; opacity: 1; }
      .menu-search input:focus { border-color: var(--hover); }
      .menu .name { font-size: 22px; font-weight: 500; margin-bottom: 12px; }
      .menu a { display: block; }
      .menu a:hover { border-bottom: 1px solid var(--hover); width: fit-content; }
      .menu a.current { border-bottom: 1px solid #000; width: fit-content; }

      footer {
        clear: both;
        padding: 60px 10px 30px;
        font-size: 13px;
        color: #888;
      }

      @media (max-width: 700px) {
        .menu {
          position: relative;
          z-index: 30;
          display: grid;
          grid-template-columns: 1fr auto;
          width: 100%;
          top: auto;
          left: auto;
          margin: 0;
          min-height: 58px;
          padding: 18px 18px;
          color: #000;
          background: transparent;
          line-height: 1.4;
        }
        .menu .menu-hamburger {
          display: block !important;
          grid-column: 2;
          grid-row: 1;
          justify-self: end;
          width: 28px;
          height: 24px;
          padding: 0;
          border: 0;
          border-radius: 0;
          color: #000;
          background: transparent;
        }
        .menu .menu-hamburger span {
          display: none;
        }
        .menu .menu-hamburger::after {
          content: "☰";
          display: block;
          color: currentColor;
          font-size: 20px;
          font-weight: 500;
          line-height: 24px;
        }
        .menu .name {
          grid-column: 1;
          grid-row: 1;
          margin: 0;
          align-self: center;
          font-size: 20px;
        }
        .menu > a {
          display: none;
          grid-column: 1 / -1;
          width: fit-content;
          margin-top: 10px;
          font-size: 18px;
        }
        .menu.is-open {
          position: fixed;
          inset: 0 0 auto;
          padding-bottom: 22px;
          background: rgba(255, 255, 255, .50);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
        }
        .menu.is-open > a { display: block; }
        .menu.is-open .menu-works-link { display: none; }
        .menu.is-open .works-toggle {
          display: block;
          grid-column: 1 / -1;
          width: fit-content;
          margin-top: 10px;
          padding: 0;
          border: 0;
          color: inherit;
          background: transparent;
          font: inherit;
          font-size: 18px;
          line-height: 1.4;
        }
        .menu.is-open .work-links {
          display: grid;
          grid-column: 1 / -1;
          gap: 7px;
          max-height: 0;
          margin: 0;
          padding: 0 0 0 13px;
          overflow: hidden;
          border-left: 1px solid rgba(0, 0, 0, .35);
          opacity: 0;
          pointer-events: none;
          transition: max-height .38s ease, margin .28s ease, padding .28s ease, opacity .22s ease;
        }
        .menu.is-open.works-open .work-links {
          max-height: min(46svh, 350px);
          margin: 4px 0 8px;
          padding: 5px 0 5px 13px;
          overflow-y: auto;
          opacity: 1;
          pointer-events: auto;
        }
        .menu.is-open .work-links a {
          display: block;
          margin: 0;
          color: #333;
          font-size: 13px;
          line-height: 1.35;
        }
        .menu.is-open .work-links .all-works { font-weight: 500; }
        .menu-search { display: none; grid-column: 1 / -1; margin: 16px 0 0; }
        .menu-search input { width: min(110px, 100%); }
        .menu.is-open .menu-search { display: block; }
      }
    </style>
  </body>
</html>
