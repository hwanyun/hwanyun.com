---
/**
 * 홈 소리 — 아카이브로 가는 문. 히어로·축·프로토타입에 이미 소리가 있으므로
 * 여기는 플레이어를 또 만들지 않고, 최근 릴리스 세 줄과 /sound 링크만 둔다.
 * 묶는 규칙(project = 릴리스)과 길이 표기는 sound.astro와 같다.
 */
import { getCollection } from "astro:content"
import LangText from "./LangText.astro"
import { tEn, tKo } from "../lib/titles"

const sounds = (await getCollection("sounds", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
)
const key = (s: (typeof sounds)[number]) => s.data.project || s.data.title
const releases = Array.from(new Map(sounds.map((s) => [key(s), s])).values()).map((lead) => {
  const tracks = sounds.filter((s) => key(s) === key(lead))
  const secs = tracks.map((t) => t.data.duration).filter((d) => d > 0)
  return {
    title: key(lead),
    titleEn: lead.data.projectEn || (lead.data.project ? lead.data.project : tEn(lead.data)),
    lead,
    min: secs.length ? Math.min(...secs) : 0,
    max: secs.length ? Math.max(...secs) : 0,
    n: tracks.length,
  }
})
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`
const span = (r: { min: number; max: number }) =>
  !r.max ? "" : r.min === r.max ? clock(r.max) : `${clock(r.min)} – ${clock(r.max)}`
const recent = releases.slice(0, 3)
// 카드에 얹을 녹음 — 커버가 있는 가장 최근 릴리스
const featured = releases.map((r) => r.lead).find((l) => l.data.cover) ?? releases[0]?.lead
---

<section class="hsound" id="sound" aria-labelledby="hsound-title">
  <p class="conn" id="hsound-title">
    <span data-language-content="en">And the recordings</span>
    <span data-language-content="ko" lang="ko">그리고 녹음</span>
    <span class="arrow" aria-hidden="true">→</span>
  </p>
  <div class="hsound-grid">
    {/* 큰 미디어 카드 — 커버 위 가운데 원형 재생. 누르면 최근 녹음이 실제로 울린다.
        카드 자체는 아카이브로 가는 링크, 버튼만 재생을 가로챈다. */}
    <a class="hs-card" href="/sound/">
      {featured?.data.cover ? <img src={featured.data.cover} alt="" loading="lazy" draggable="false" /> : <div class="hs-ph" aria-hidden="true" />}
      <span class="hs-scrim" aria-hidden="true"></span>
      {featured?.data.audio && (
        <button type="button" class="hs-play" data-audio={featured.data.audio} aria-pressed="false" aria-label={`Play ${tEn(featured.data)}`}>
          <span class="hs-icon" aria-hidden="true"></span>
        </button>
      )}
      <span class="hs-cap">
        <span class="hs-label">
          <span data-language-content="en">Listening archive</span>
          <span data-language-content="ko" lang="ko">듣기 아카이브</span>
          <span class="hs-n"> · {releases.length}</span>
        </span>
        {featured && <span class="hs-now"><LangText en={tEn(featured.data)} ko={tKo(featured.data)} /></span>}
      </span>
    </a>
    <ol class="hsound-list">
      {recent.map((r) => (
        <li>
          <a href={`/sound/#sound-${r.lead.slug}`}>
            <span class="t"><LangText en={r.titleEn} ko={r.title} /></span>
            {r.n > 1 && <span class="v">{r.n} versions</span>}
            <span class="len">{span(r)}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<script is:inline>
  ;(function () {
    var btn = document.querySelector(".hs-play[data-audio]")
    if (!btn) return
    var audio = null
    btn.addEventListener("click", function (e) {
      e.preventDefault(); e.stopPropagation()
      if (!audio) { audio = new Audio(btn.getAttribute("data-audio")); audio.preload = "none"; audio.addEventListener("ended", function () { btn.setAttribute("aria-pressed", "false") }) }
      if (audio.paused) { audio.play().then(function () { btn.setAttribute("aria-pressed", "true") }).catch(function () {}) }
      else { audio.pause(); btn.setAttribute("aria-pressed", "false") }
    })
    document.addEventListener("visibilitychange", function () { if (document.hidden && audio && !audio.paused) { audio.pause(); btn.setAttribute("aria-pressed", "false") } })
  })()
</script>

<style>
  .hsound { max-width: var(--content-w); margin: 0 40px 0 var(--desktop-content-x); padding: 120px 0 0; }
  .conn { margin: 0 0 18px; font-size: var(--fs-xs); letter-spacing: .02em; color: var(--text-3); }
  .conn .arrow { margin-left: 6px; color: var(--hover); }
  .hsound-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--space-3); align-items: start; }

  /* 미디어 카드 — 둥근 모서리, 커버 위 가운데 원형 재생(레퍼런스 prototypes 카드의 문법) */
  .hs-card {
    position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden;
    border-radius: 14px; background: var(--void); color: var(--void-text); text-decoration: none;
  }
  .hs-card img, .hs-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease); }
  .hs-card:hover img { transform: scale(1.03); }
  .hs-ph { background: repeating-linear-gradient(45deg, var(--void-line) 0 2px, var(--void) 2px 6px); }
  .hs-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,.05) 55%); }
  .hs-play {
    position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px;
    display: grid; place-items: center; border: 0; border-radius: 50%; padding: 0;
    background: var(--surface); color: var(--text); cursor: pointer;
    box-shadow: 0 6px 24px rgba(0,0,0,.25); transition: transform var(--dur-fast) var(--ease);
  }
  .hs-play:hover { transform: scale(1.06); }
  .hs-icon { width: 0; height: 0; border-style: solid; border-width: 9px 0 9px 15px; border-color: transparent transparent transparent currentColor; margin-left: 4px; }
  .hs-play[aria-pressed="true"] .hs-icon { width: 14px; height: 16px; border: 0; margin: 0; background: linear-gradient(to right, currentColor 0 5px, transparent 5px 9px, currentColor 9px); }
  .hs-cap { position: absolute; left: 18px; right: 18px; bottom: 16px; display: flex; flex-direction: column; gap: 2px; }
  .hs-label { font-size: var(--fs-2xs); letter-spacing: .14em; text-transform: uppercase; color: var(--void-text-2); }
  .hs-n { letter-spacing: 0; }
  .hs-now { font-size: var(--fs-sm); color: var(--void-text); }

  .hsound-list { list-style: none; margin: 0; padding: 0; font-size: var(--fs-sm); }
  .hsound-list li { border-bottom: 1px solid var(--line); }
  .hsound-list a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 14px; align-items: baseline;
    padding: 12px 0; color: var(--text); text-decoration: none;
  }
  .hsound-list a:hover .t { color: var(--hover); }
  .hsound-list .v { font-size: var(--fs-2xs); color: var(--text-3); letter-spacing: .04em; }
  .hsound-list .len { font-size: var(--fs-xs); color: var(--text-3); font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) {
    .hsound { margin: 0; padding: 80px 16px 0; }
    .hsound-grid { grid-template-columns: 1fr; }
  }
</style>
