---
/**
 * 홈 소리 — 아카이브로 가는 문. 히어로·축·프로토타입에 이미 소리가 있으므로
 * 여기는 플레이어를 또 만들지 않고, 최근 릴리스 세 줄과 /sound 링크만 둔다.
 * 묶는 규칙(project = 릴리스)과 길이 표기는 sound.astro와 같다.
 */
import { getCollection } from "astro:content"
import LangText from "./LangText.astro"
import { tEn, tKo } from "../lib/titles"

const sounds = (await getCollection("sounds", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
)
const key = (s: (typeof sounds)[number]) => s.data.project || s.data.title
const releases = Array.from(new Map(sounds.map((s) => [key(s), s])).values()).map((lead) => {
  const tracks = sounds.filter((s) => key(s) === key(lead))
  const secs = tracks.map((t) => t.data.duration).filter((d) => d > 0)
  return {
    title: key(lead),
    titleEn: lead.data.projectEn || (lead.data.project ? lead.data.project : tEn(lead.data)),
    lead,
    min: secs.length ? Math.min(...secs) : 0,
    max: secs.length ? Math.max(...secs) : 0,
    n: tracks.length,
  }
})
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`
const span = (r: { min: number; max: number }) =>
  !r.max ? "" : r.min === r.max ? clock(r.max) : `${clock(r.min)} – ${clock(r.max)}`
const recent = releases.slice(0, 3)
// 카드에서 재생할 녹음 — 가장 최근 릴리스
---

<section class="hsound" id="sound" aria-labelledby="hsound-title">
  <p class="conn" id="hsound-title">
    <span data-language-content="en">And the recordings</span>
    <span data-language-content="ko" lang="ko">그리고 녹음</span>
    <span class="arrow" aria-hidden="true">→</span>
  </p>
  <div class="hsound-grid">
    {/* 큰 카드 — 아카이브로 가는 문. 재생 버튼은 두지 않는다: 어차피 눌러서 넘어가는
        자리라 대기 상태가 의미가 없다(작가 지적). 대신 상자 자체가 늘 살아 있다. */}
    <a class="hs-card" href="/sound/" aria-label="Listening archive">
      {/* 작품 이미지는 쓰지 않는다 — 홈에 작품이 이미 충분히 노출된다(작가 지적).
          대신 소리의 입자: 파형을 따라 점들이 끊임없이 흐르고 떤다. 히어로 구체와 같은 어휘. */}
      <canvas class="hs-viz" id="hs-viz" aria-hidden="true"></canvas>
    </a>
    <ol class="hsound-list">
      {recent.map((r) => (
        <li>
          <a href={`/sound/#sound-${r.lead.slug}`}>
            <span class="t"><LangText en={r.titleEn} ko={r.title} /></span>
            {r.n > 1 && <span class="v">{r.n} versions</span>}
            <span class="len">{span(r)}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<script is:inline>
  ;(function () {
    var canvas = document.getElementById("hs-viz")
    if (!canvas) return
    var ctx = canvas.getContext("2d")
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    var W = 0, H = 0, dpr = 1
    function fit() {
      dpr = Math.min(2, window.devicePixelRatio || 1)
      W = canvas.clientWidth; H = canvas.clientHeight
      canvas.width = W * dpr; canvas.height = H * dpr
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }
    fit(); window.addEventListener("resize", fit)
    var stroke = getComputedStyle(canvas).color
    var raf = 0, visible = true, t0 = performance.now()

    /* 입자 — 히어로 구체와 같은 어휘. 점들이 가로로 펼쳐져 있고, 합성 파형(서로 나눠지지 않는
       주기의 사인 셋)을 따라 들리며, 파형이 클수록 떤다. 멈춰 있는 순간이 없다. */
    var COLS = 40, ROWS = 6
    var dots = []
    for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) dots.push({ c: c, r: r, y: H / 2, vy: 0, seed: Math.random() * 6.28 })
    function level(k, t) {
      return Math.sin(k * .21 + t * 1.9) * Math.sin(k * .045 - t * .53) * .55
           + Math.sin(k * .62 + t * 4.7) * .13 * (.5 + .5 * Math.sin(t * .37))
    }
    function draw(now) {
      ctx.clearRect(0, 0, W, H)
      var t = (now - t0) / 1000
      var loud = .05 + Math.abs(Math.sin(t * .29) * Math.sin(t * .11)) * .16
      var mid = H / 2, amp = H * .24, gapX = W / (COLS + 1), gapY = H * .07
      ctx.fillStyle = stroke
      for (var n = 0; n < dots.length; n++) {
        var p = dots[n]
        var lv = level(p.c, t)
        var off = p.r - (ROWS - 1) / 2
        var target = mid + off * gapY + lv * amp * (1 - Math.abs(off) * .18)
        var tremor = (Math.random() - .5) * loud * H * .3
        p.vy = (p.vy + (target - p.y) * .12 + tremor) * .72
        p.y += p.vy
        var x = gapX * (p.c + 1) + Math.sin(t * .4 + p.seed) * 1.2
        var size = .9 + Math.min(1.6, Math.abs(lv) * 1.8 + loud * 3)
        ctx.globalAlpha = .35 + Math.min(.65, Math.abs(lv) * .9 + loud * 1.5)
        ctx.beginPath(); ctx.arc(x, p.y, size, 0, 6.283); ctx.fill()
      }
      ctx.globalAlpha = 1
      if (!reduce && visible) raf = requestAnimationFrame(draw)
    }
    function start() { if (raf) return; raf = requestAnimationFrame(draw) }
    function stop() { if (raf) cancelAnimationFrame(raf); raf = 0 }
    draw(performance.now())
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { visible = e.isIntersecting; visible ? start() : stop() }) }).observe(canvas)
    }
    document.addEventListener("visibilitychange", function () { document.hidden ? stop() : (visible && start()) })
  })()
</script>

<style>
  .hsound { max-width: var(--content-w); margin: 0 40px 0 var(--desktop-content-x); padding: 120px 0 0; }
  .conn { margin: 0 0 18px; font-size: var(--fs-xs); letter-spacing: .02em; color: var(--text-3); }
  .conn .arrow { margin-left: 6px; color: var(--hover); }
  .hsound-grid { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--space-3); align-items: start; }

  /* 미디어 카드 — 둥근 모서리, 커버 위 가운데 원형 재생(레퍼런스 prototypes 카드의 문법) */
  /* 원래 상자 그대로(200×150, 흰 바탕, 얇은 선) — 안에 검은 입자만 산다. 글자 없음 */
  .hs-card {
    position: relative; display: block; width: 200px; height: 150px; overflow: hidden;
    border: 1px solid var(--line-2); background: var(--surface); color: var(--text); text-decoration: none;
  }
  .hs-card:hover { border-color: var(--hover); }
  .hs-viz { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--text); }

  .hsound-list { list-style: none; margin: 0; padding: 0; font-size: var(--fs-sm); }
  .hsound-list li { border-bottom: 1px solid var(--line); }
  .hsound-list a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 14px; align-items: baseline;
    padding: 12px 0; color: var(--text); text-decoration: none;
  }
  .hsound-list a:hover .t { color: var(--hover); }
  .hsound-list .v { font-size: var(--fs-2xs); color: var(--text-3); letter-spacing: .04em; }
  .hsound-list .len { font-size: var(--fs-xs); color: var(--text-3); font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) {
    .hsound { margin: 0; padding: 80px 16px 0; }
    .hsound-grid { grid-template-columns: 1fr; }
    .hs-card { width: 100%; height: 120px; }
  }
</style>
