---
/**
 * 세 축 카드 — 홈의 척추.
 *
 * 매체가 아니라 신호가 지나는 단계(울림·접촉·흔적)로 작품을 묶는다. 각 카드는
 * 대표 작품의 루프(또는 정지 이미지) + 한 줄 + 15초 소리 발췌 + 대표작 목록.
 * 축 이름을 읽기 전에 들을 수 있어야 사운드 작가의 사이트다.
 *
 * 어휘와 대표 미디어는 src/data/axes.ts 한 곳에서 관리한다.
 */
import { getCollection } from "astro:content"
import { AXES } from "../data/axes"
import LangText from "./LangText.astro"
import { tEn, tKo } from "../lib/titles"

const works = await getCollection("works", ({ data }) => !data.draft)
const sounds = await getCollection("sounds", ({ data }) => !data.draft)
const sortYear = (year: string) => Math.max(...(year.match(/\d{4}/g) ?? ["0"]).map(Number))

const cards = AXES.map((axis) => {
  const hero = works.find((w) => w.slug === axis.work)
  const sound = axis.sound ? sounds.find((s) => s.slug === axis.sound) : undefined
  const members = works
    .filter((w) => w.data.axes.includes(axis.id))
    .sort((a, b) => sortYear(b.data.year) - sortYear(a.data.year) || (a.data.order ?? 0) - (b.data.order ?? 0))
  return { axis, hero, sound, members }
})
---

<section class="axes" id="axes" aria-labelledby="axes-title">
  <p class="conn" id="axes-title">
    <span data-language-content="en">Three stages a signal passes through</span>
    <span data-language-content="ko" lang="ko">신호가 지나는 세 단계</span>
    <span class="arrow" aria-hidden="true">→</span>
    <span class="conn-short"><span data-language-content="en">Three stages</span><span data-language-content="ko" lang="ko">세 단계</span></span>
  </p>
  <div class="axis-grid">
    {cards.map(({ axis, hero, sound, members }) => (
      <article class="axis" id={`axis-${axis.id}`} data-axis={axis.id}>
        <a class="axis-media" href={`/works/?axis=${axis.id}`} aria-label={`${axis.en} — works`}>
          {hero?.data.thumb ? <img src={hero.data.thumb} alt="" loading="lazy" draggable="false" /> : <div class="ph" />}
          {hero?.data.thumbVideo && (
            <video class="axis-video" data-src={hero.data.thumbVideo} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />
          )}
        </a>
        <div class="axis-body">
          {/* 카드는 훑는 자리다: 제목 · 한 문장 · 작품 수. 문단과 목록은 축을 눌러 들어간 Works에서. */}
          <h3>
            <a href={`/works/?axis=${axis.id}`}>
              <span data-language-content="en">{axis.en}</span>
              <span data-language-content="ko" lang="ko">{axis.ko}</span>
            </a>
          </h3>
          <p class="axis-line">
            <span data-language-content="en">{axis.lineEn}</span>
            <span data-language-content="ko" lang="ko">{axis.lineKo}</span>
          </p>
          <div class="axis-foot">
            {sound?.data.audio ? (
              <button type="button" class="excerpt" data-audio={sound.data.audio} data-limit="15" aria-pressed="false" aria-label={`Play 15 seconds of ${sound.data.title}`}>
                <span class="ex-dot" aria-hidden="true"></span>
                <span class="ex-label"><span class="ex-off">0:15</span><span class="ex-on">■</span></span>
              </button>
            ) : null}
            <a class="axis-count" href={`/works/?axis=${axis.id}`}>
              <span data-language-content="en">{members.length} works →</span>
              <span data-language-content="ko" lang="ko">작품 {members.length} →</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  /* 15초 발췌 — 한 번에 하나만 울린다. 다른 카드를 누르면 앞 것이 멈춘다.
     이 섹션과 히어로 구체는 같은 오디오 원소를 쓰지 않는다: 구체는 마이크(입력)이고
     여기는 재생(출력)이다. 둘이 겹치면 구체가 이 소리에 반응한다 — 의도된 일이다. */
  ;(function () {
    var btns = Array.prototype.slice.call(document.querySelectorAll(".axes .excerpt[data-audio]"))
    if (!btns.length) return
    var audio = null, current = null, timer = 0
    function stop() {
      if (audio) { audio.pause(); audio.currentTime = 0 }
      if (timer) { clearTimeout(timer); timer = 0 }
      if (current) { current.setAttribute("aria-pressed", "false"); current = null }
    }
    btns.forEach(function (b) {
      b.addEventListener("click", function () {
        if (current === b) { stop(); return }
        stop()
        if (!audio) { audio = new Audio(); audio.preload = "none" }
        audio.src = b.getAttribute("data-audio")
        var limit = parseFloat(b.getAttribute("data-limit") || "15") * 1000
        current = b
        b.setAttribute("aria-pressed", "true")
        audio.play().then(function () {
          timer = setTimeout(stop, limit)
        }).catch(stop)
        audio.onended = stop
      })
    })
    document.addEventListener("visibilitychange", function () { if (document.hidden) stop() })

    /* 루프 썸네일 — WorkGrid와 같은 규칙: 보일 때만 src를 붙이고 재생한다. */
    var vids = Array.prototype.slice.call(document.querySelectorAll(".axes .axis-video[data-src]"))
    if (!vids.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return
    if (!("IntersectionObserver" in window)) return
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        var v = e.target
        if (e.isIntersecting) {
          if (!v.src) v.src = v.getAttribute("data-src")
          var p = v.play(); if (p && p.catch) p.catch(function () {})
          v.addEventListener("playing", function () { v.classList.add("is-playing") }, { once: true })
        } else if (v.src) v.pause()
      })
    }, { rootMargin: "80px 0px" })
    vids.forEach(function (v) { io.observe(v) })
  })()
</script>


<style>
  .axes { max-width: 1600px; margin: 0 40px 0 var(--desktop-content-x); padding: 128px 0 0; }
  .conn { margin: 0 0 22px; font-family: var(--display); font-size: var(--fs-lead); font-weight: 400; letter-spacing: 0; color: var(--text); }
  .conn .arrow { margin-left: 6px; color: var(--hover); }
  .axis-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .axis { display: flex; flex-direction: column; background: var(--surface-2); border: 1px solid var(--line); }
  .axis-media {
    position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2);
  }
  .axis-media img, .axis-media .ph, .axis-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .axis-media .ph { background: repeating-linear-gradient(45deg, var(--line) 0 2px, var(--surface-2) 2px 6px); }
  .axis-video { opacity: 0; transition: opacity var(--dur-slow) ease; }
  .axis-video.is-playing { opacity: 1; }
  .axis-body { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px 16px; }
  h3 { margin: 0; font-size: var(--fs-lead); font-weight: 500; letter-spacing: -.01em; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--hover); }
  .axis-line { margin: 0; font-size: var(--fs-sm); line-height: 1.5; color: var(--text-2); }
  .axis-line [lang="ko"] { line-height: 1.6; }
  .axis-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 6px; }
  .excerpt {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 4px 10px 4px 8px; border: 1px solid var(--line-2); border-radius: 999px;
    background: none; color: var(--text); font: inherit; font-size: var(--fs-2xs);
    letter-spacing: .06em; cursor: pointer;
  }
  .excerpt:hover { border-color: var(--hover); color: var(--hover); }
  .excerpt[aria-pressed="true"] { background: var(--text); color: var(--surface); border-color: var(--text); }
  .ex-dot { width: 7px; height: 7px; border-radius: 50%; border: 1px solid currentColor; }
  .excerpt[aria-pressed="true"] .ex-dot { background: currentColor; animation: ex-breathe 1.2s ease-in-out infinite; }
  @keyframes ex-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.5); } }
  .ex-on { display: none; }
  .excerpt[aria-pressed="true"] .ex-off { display: none; }
  .excerpt[aria-pressed="true"] .ex-on { display: inline; }
  .axis-count { margin-left: auto; font-size: var(--fs-xs); color: var(--text-3); text-decoration: none; }
  .axis-count:hover { color: var(--hover); }

  @media (max-width: 1000px) {
    .axis-grid { grid-template-columns: 1fr; }
    .axis { flex-direction: row; }
    .axis-media { flex: 0 0 42%; aspect-ratio: auto; min-height: 220px; }
  }
  @media (max-width: 700px) {
    /* 데스크톱 카드 세 장을 그대로 세로로 쌓는다 — 이미지 + 이름 + 15초.
       가로 스와이프는 셋째 카드가 잘려 배열이 이상해 보였다(작가 지적). 설명과 작품 수는 Works에서. */
    .axes { margin: 0; padding: 56px 16px 0; }
    .axis-grid { gap: 10px; }
    .axis { flex-direction: column; }
    .axis-media { flex: none; aspect-ratio: 16 / 10; min-height: 0; }
    .axis-body { flex-direction: row; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; }
    .axis-line, .axis-count { display: none; }
    .axis-foot { margin-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .excerpt[aria-pressed="true"] .ex-dot { animation: none; }
    .axis-video { display: none; }
  }
</style>
