---
/**
 * 방문의 흔적 — 시아노타입(감광지) 인용.
 *
 * Three Pieces: Untitled III는 빛이 닿은 자리에 상이 남는 작업이다.
 * 같은 원리로, 방문자가 본 작품은 목록에서 "노출된" 흔적을 남긴다.
 *
 * 세션 한정(sessionStorage)이다. 탭을 닫으면 사라진다 — 방문자를 장기 추적하지
 * 않으며 서버로도 보내지 않는다. 흔적은 이번 방문 안에서만 의미를 갖는다.
 *
 * `slug`를 주면 그 작품을 본 것으로 기록하고, 주지 않으면 기록된 것들을
 * 목록에 표시만 한다.
 */
const { slug = "" } = Astro.props
---

<script is:inline define:vars={{ slug }}>
  ;(function () {
    var KEY = "hy:seen"
    function read() {
      try {
        return JSON.parse(sessionStorage.getItem(KEY) || "[]")
      } catch (e) {
        return []
      }
    }
    function write(list) {
      try {
        sessionStorage.setItem(KEY, JSON.stringify(list))
      } catch (e) {
        /* 프라이빗 모드 등에서 저장이 막혀도 사이트는 그대로 동작해야 한다 */
      }
    }

    if (slug) {
      var seen = read()
      if (seen.indexOf(slug) === -1) {
        seen.push(slug)
        write(seen)
      }
      return
    }

    // 목록 페이지 — 이미 본 작품에 표시를 남긴다
    var seenSet = {}
    read().forEach(function (s) { seenSet[s] = true })
    var marked = 0
    Array.prototype.forEach.call(document.querySelectorAll("[data-slug]"), function (el) {
      if (seenSet[el.getAttribute("data-slug")]) {
        el.classList.add("is-seen")
        marked++
      }
    })
    if (marked) document.documentElement.classList.add("has-seen")
  })()
</script>
