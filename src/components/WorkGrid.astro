---
import { getCollection } from "astro:content"

const { filter = "", current = "home" } = Astro.props

// size → 패킹 weight (셀 비중). 클수록 넓은 면적을 차지한다.
const WEIGHT: Record<string, number> = { "1col": 1, "2col": 1.7, "3col": 2.6 }

let works = await getCollection("works", ({ data }) => !data.draft)
if (filter) works = works.filter((w) => w.data.category === filter)
works.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))

const nav = [
  { label: "Works", href: "/works", key: "works" },
  { label: "Sound", href: "/sound", key: "sound" },
  { label: "Bio", href: "/cv", key: "bio" },
  { label: "Contact", href: "/contact", key: "contact" },
]
---

<div id="packed">
  <!-- 메뉴 = 좌상단 고정 오버레이 (트리맵에서 제외, 왜곡·잘림 없음) -->
  <nav class="home-menu" id="home-menu">
    <div class="name"><a href="/">HWANYUN</a></div>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="home-menu">
      <span></span><span></span><span></span>
    </button>
    {
      nav.map((n) => (
        <a href={n.href} class={current === n.key ? "current" : ""}>
          {n.label}
        </a>
      ))
    }
    <input id="search" type="search" placeholder="Search" autocomplete="off" />
  </nav>

  <!-- 직사각형 그리드 (메뉴 컬럼 오른쪽, 좌우·상하 여백 안쪽) -->
  <div class="grid">
    {
      works.map((w) => (
        <a
          class="tile card"
          href={`/works/${w.slug}`}
          data-weight={WEIGHT[w.data.size] ?? 1.7}
          data-search={`${w.data.title} ${w.data.year} ${w.data.medium}`.toLowerCase()}
        >
          <div class="thumb">
            {w.data.thumb ? <img src={w.data.thumb} alt={w.data.title} draggable="false" /> : <div class="ph" />}
          </div>
          <span class="scrim" aria-hidden="true" />
          <div class="cap">
            <span class="t">{w.data.title}</span>
            {w.data.year ? <span class="y"> ({w.data.year})</span> : ""}
          </div>
        </a>
      ))
    }
    <div id="noresult" hidden>No results.</div>
  </div>
</div>

<script is:inline>
  ;(function () {
    var c = document.getElementById("packed")
    if (!c) return
    var grid = c.querySelector(".grid")
    var input = document.getElementById("search")
    var none = document.getElementById("noresult")
    var menu = c.querySelector(".home-menu")
    var menuToggle = menu && menu.querySelector(".menu-toggle")
    var tiles = Array.prototype.slice.call(grid.querySelectorAll(".tile"))
    var SHARE = 0.4 // hover 시 해당 셀이 차지할 목표 면적 비율

    if (menu && menuToggle) {
      menuToggle.addEventListener("click", function () {
        var isOpen = menu.classList.toggle("is-open")
        menuToggle.setAttribute("aria-expanded", String(isOpen))
        menuToggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation")
      })
    }

    // 각 셀을 leaf 객체로 (DOM 순서 = 패킹 순서)
    var leaves = tiles.map(function (el) {
      return {
        el: el,
        base: parseFloat(el.getAttribute("data-weight")) || 1,
        w: 0,
        menu: el.hasAttribute("data-menu"),
      }
    })

    function desktop() {
      return window.matchMedia("(min-width: 701px)").matches
    }
    function activeLeaves() {
      return leaves.filter(function (l) {
        return l.el.style.display !== "none"
      })
    }

    // 순서 보존 이분할 트리 구축 (base weight로 절반씩 분할)
    function build(arr) {
      if (arr.length === 1) return { leaf: arr[0] }
      var tot = 0
      arr.forEach(function (l) {
        tot += l.base
      })
      var acc = 0,
        i = 0
      for (i = 0; i < arr.length - 1; i++) {
        acc += arr[i].base
        if (acc >= tot / 2) {
          i++
          break
        }
      }
      if (i < 1) i = 1
      if (i > arr.length - 1) i = arr.length - 1
      return { a: build(arr.slice(0, i)), b: build(arr.slice(i)), dir: null }
    }

    function wsum(n) {
      return n.leaf ? n.leaf.w : wsum(n.a) + wsum(n.b)
    }

    // 현재 weight로 사각형 배치. dir은 최초 1회(base 기준)만 결정해 구조를 고정.
    function place(n, x, y, w, h) {
      if (n.leaf) {
        var s = n.leaf.el.style
        s.left = x + "%"
        s.top = y + "%"
        s.width = w + "%"
        s.height = h + "%"
        return
      }
      if (n.dir === null) n.dir = w >= h ? "h" : "v"
      var wa = wsum(n.a),
        wb = wsum(n.b),
        t = wa + wb || 1
      if (n.dir === "h") {
        var ww = (w * wa) / t
        place(n.a, x, y, ww, h)
        place(n.b, x + ww, y, w - ww, h)
      } else {
        var hh = (h * wa) / t
        place(n.a, x, y, w, hh)
        place(n.b, x, y + hh, w, h - hh)
      }
    }

    var tree = null
    function clearInline() {
      tiles.forEach(function (el) {
        el.style.left = el.style.top = el.style.width = el.style.height = ""
      })
    }
    function rebuild() {
      var a = activeLeaves()
      a.forEach(function (l) {
        l.w = l.base
      })
      tree = a.length ? build(a) : null
      if (tree) place(tree, 0, 0, 100, 100)
    }
    function relayout(hoverLeaf) {
      if (!tree || !desktop()) return
      var a = activeLeaves()
      a.forEach(function (l) {
        l.w = l.base
      })
      if (hoverLeaf && !hoverLeaf.menu) {
        var others = 0
        a.forEach(function (l) {
          if (l !== hoverLeaf) others += l.base
        })
        hoverLeaf.w = (others * SHARE) / (1 - SHARE)
      }
      place(tree, 0, 0, 100, 100)
    }

    // 검색
    function apply() {
      var q = (input && input.value.trim().toLowerCase()) || ""
      var shown = 0
      leaves.forEach(function (l) {
        if (l.menu) return
        var hit = !q || (l.el.getAttribute("data-search") || "").indexOf(q) !== -1
        l.el.style.display = hit ? "" : "none"
        if (hit) shown++
      })
      if (none) none.hidden = shown !== 0
      syncMode()
    }
    if (input) input.addEventListener("input", apply)
    var searchQuery = new URLSearchParams(window.location.search).get("q")
    if (input && searchQuery) {
      input.value = searchQuery
      apply()
      document.getElementById("works")?.scrollIntoView({ block: "start" })
    }

    // hover-expand
    leaves.forEach(function (l) {
      if (l.menu) return
      l.el.addEventListener("mouseenter", function () {
        relayout(l)
      })
    })
    grid.addEventListener("mouseleave", function () {
      relayout(null)
    })

    /* ---- 모바일: 스크롤 포커스 ----
       화면 중앙에 가까운 타일일수록 선명·확대, 벗어날수록 어두워짐.
       리플로우를 피하려고 슬롯 높이는 고정하고 transform/스크림/캡션만 조절. */
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    function clearMobileStyles() {
      tiles.forEach(function (el) {
        var img = el.querySelector("img")
        if (img) {
          img.style.transform = ""
          img.style.filter = ""
        }
        var s = el.querySelector(".scrim")
        if (s) s.style.opacity = ""
        var cap = el.querySelector(".cap")
        if (cap) cap.style.opacity = ""
      })
    }
    function mobileFrame() {
      mTicking = false
      if (desktop()) return
      // Mobile archive uses a compact mosaic rather than the former one-card feed.
      if (window.matchMedia("(max-width: 700px)").matches) return
      var vh = window.innerHeight || 1
      var cy = vh / 2
      tiles.forEach(function (el) {
        if (el.style.display === "none") return
        var r = el.getBoundingClientRect()
        if (r.height === 0) return
        var tc = r.top + r.height / 2
        var rel = (tc - cy) / vh // -0.5(위) ~ 0.5(아래)
        var t = Math.max(0, 1 - Math.abs(tc - cy) / (vh * 0.62)) // 0~1, 중앙=1
        var img = el.querySelector("img")
        if (img) {
          img.style.transform = reduce
            ? ""
            : "translateY(" + rel * -18 + "px) scale(" + (1.06 + t * 0.07) + ")"
          // 중앙일수록 밝게(최대 1.1), 벗어날수록 살짝 어둡게(0.94)
          img.style.filter = "brightness(" + (0.94 + t * 0.16) + ")"
        }
        var s = el.querySelector(".scrim")
        if (s) s.style.opacity = String((1 - t) * 0.72)
        var cap = el.querySelector(".cap")
        if (cap) cap.style.opacity = String(0.15 + t * 0.85)
      })
    }
    var mTicking = false
    function onScroll() {
      if (!mTicking) {
        mTicking = true
        requestAnimationFrame(mobileFrame)
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true })

    function syncMode() {
      rebuild()
      clearMobileStyles()
    }

    var rt
    window.addEventListener("resize", function () {
      clearTimeout(rt)
      rt = setTimeout(syncMode, 150)
    })

    // 초기화: 위치 잡고 → 페이드인 → 전환 활성화
    syncMode()
    requestAnimationFrame(function () {
      c.classList.add("ready")
      requestAnimationFrame(function () {
        c.classList.add("animate")
      })
    })
  })()
</script>

<style>
  #packed {
    position: relative;
    width: 100%;
    height: 100svh;
  }

  /* 직사각형 그리드: 좌측 메뉴 컬럼 + 우측 여백 안쪽, 상하 여백 */
  .grid {
    position: absolute;
    left: 210px; /* 좌측 메뉴 컬럼 (아래는 빈 여백) */
    right: 56px; /* 우측 여백 */
    top: 14px;
    bottom: 14px;
  }

  .tile {
    position: absolute;
    overflow: hidden;
    border: 2px solid #fff;
    background: #f2f2f2;
    opacity: 0;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  #packed.ready .tile {
    opacity: 1;
  }
  .tile {
    transition: opacity 0.45s ease;
  }
  #packed.animate .tile {
    transition:
      left 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      top 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      width 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      height 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.45s ease;
  }

  /* 작품 셀 */
  .card {
    display: block;
    color: #fff;
  }
  .card .thumb,
  .card .ph {
    position: absolute;
    inset: 0;
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* 모바일 롱프레스로 이미지가 '복사/드래그'되어 뜯겨 나오는 것 방지: 탭은 항상 링크로 */
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .card .ph {
    background: #ececec;
  }
  .card .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 26px 12px 9px;
    font-size: 14px;
    line-height: 1.25;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .card:hover .cap {
    opacity: 1;
  }
  .card .cap .t {
    font-weight: 400;
  }
  .card .cap .y {
    font-weight: 300;
    opacity: 0.85;
  }

  /* 스크롤 포커스용 스크림 — 모바일에서만 사용 */
  .scrim {
    display: none;
  }

  /* 메뉴 = 좌상단 고정 오버레이 */
  .home-menu {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: 210px;
    padding: 15px 18px 18px;
    background: #fff;
    font-size: 18px;
    line-height: 1.5;
  }
  .home-menu .menu-toggle { display: none; }
  .home-menu .name {
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .home-menu a {
    display: block;
    color: #000;
  }
  .home-menu a:hover {
    border-bottom: 1px solid var(--hover);
    width: fit-content;
  }
  .home-menu a.current {
    border-bottom: 1px solid #000;
    width: fit-content;
  }
  .home-menu #search {
    display: block;
    width: 110px;
    height: 34px;
    margin-top: 14px;
    padding: 6px 9px;
    border: 1px solid #000;
    font: inherit;
    font-size: 15px;
    background: transparent;
    outline: none;
    border-radius: 0;
    -webkit-appearance: none;
  }
  .home-menu #search::placeholder {
    color: #000;
  }
  .home-menu #search:focus { border-color: var(--hover); }

  #noresult {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 15px;
    color: #888;
  }

  /* 홈에서는 전역 footer 숨김 (그리드가 화면을 채움) — 이 컴포넌트는 홈 전용 */
  :global(footer) {
    display: none;
  }

  /* 모바일: 데스크톱과 동일한 패킹 구조를 화면 전체로 확장한다. */
  @media (max-width: 700px) {
    #packed {
      height: 100svh;
      margin: 0;
      width: 100%;
      background: #000;
    }
    .grid {
      position: absolute;
      inset: 0;
      display: block;
    }
    .tile {
      position: absolute !important;
      opacity: 1 !important;
      border: 1px solid #fff;
      margin: 0;
      overflow: hidden;
      background: #000;
    }
    .card {
      display: block;
      color: #fff;
    }
    .card .thumb,
    .card .ph {
      position: absolute;
      inset: 0;
    }
    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform-origin: center;
      will-change: transform;
    }
    .card .ph {
      padding-bottom: 0;
      background: #1a1a1a;
    }
    .scrim {
      display: block;
      position: absolute;
      inset: 0;
      background: #000;
      opacity: 0.18;
      pointer-events: none;
    }
    .card .cap {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 28px 10px 8px;
      font-size: 11px;
      color: #fff;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.66), rgba(0, 0, 0, 0));
      opacity: 1 !important;
    }
    .home-menu {
      display: none;
    }
    #noresult {
      position: static;
      padding: 40px 0;
    }
    :global(footer) {
      display: block;
    }
  }
</style>
