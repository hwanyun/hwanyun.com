---
import { getCollection } from "astro:content"
import SiteMenu from "./SiteMenu.astro"
import SeenTracker from "./SeenTracker.astro"

const { filter = "", current = "home" } = Astro.props

// size → 패킹 weight (셀 비중). 클수록 넓은 면적을 차지한다.
const WEIGHT: Record<string, number> = { "1col": 1, "2col": 1.7, "3col": 2.6 }

let works = await getCollection("works", ({ data }) => !data.draft)
if (filter) works = works.filter((w) => w.data.category === filter)
works.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))

---

<div id="packed">
  <SiteMenu variant="grid" current={current} />

  <!-- 직사각형 그리드 (메뉴 컬럼 오른쪽, 좌우·상하 여백 안쪽) -->
  <div class="grid">
    {
      works.map((w) => (
        <a
          class="tile card"
          href={`/works/${w.slug}`}
          data-weight={WEIGHT[w.data.size] ?? 1.7}
          data-search={`${w.data.title} ${w.data.year} ${w.data.medium}`.toLowerCase()}
          data-slug={w.slug}
        >
          <div class="thumb">
            {w.data.thumb ? <img src={w.data.thumb} alt={w.data.title} draggable="false" /> : <div class="ph" />}
            {/* 영상은 src 없이 심어 두고, 뷰포트에 들어올 때 스크립트가 붙인다.
                12개를 한꺼번에 받으면 첫 화면이 느려진다. */}
            {w.data.thumbVideo && (
              <video
                class="thumb-video"
                data-src={w.data.thumbVideo}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                tabindex="-1"
              />
            )}
          </div>
          <span class="scrim" aria-hidden="true" />
          <div class="cap">
            <span class="t">{w.data.title}</span>
            {w.data.year ? <span class="y"> ({w.data.year})</span> : ""}
          </div>
        </a>
      ))
    }
    <div id="noresult" hidden>No results.</div>
  </div>
</div>

<SeenTracker />

<script is:inline>
  /* 썸네일 무음 루프 — 뷰포트 안에 있을 때만 재생한다.
     작품이 대부분 시간 기반이라 정지 이미지로는 전달되지 않는 것을 보완한다. */
  ;(function () {
    var videos = Array.prototype.slice.call(document.querySelectorAll(".thumb-video"))
    if (!videos.length) return

    // 재생하지 않아야 하는 조건 — 이 경우 thumb 이미지만 남는다(폴백).
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    var conn = navigator.connection || {}
    var saveData = conn.saveData === true
    var slow = typeof conn.effectiveType === "string" && /^(slow-)?2g$/.test(conn.effectiveType)
    // 저사양·모바일에서 동시 디코딩을 줄인다.
    var isMobile = window.matchMedia("(max-width: 700px)").matches
    var MAX_CONCURRENT = isMobile ? 2 : 6

    if (reduced || saveData || slow) return

    var playing = []
    function stop(v) {
      try { v.pause() } catch (e) {}
      var i = playing.indexOf(v)
      if (i !== -1) playing.splice(i, 1)
      v.classList.remove("is-playing")
    }
    function start(v) {
      if (playing.indexOf(v) !== -1) return
      // 동시 재생 상한을 넘으면 가장 오래된 것을 내린다.
      while (playing.length >= MAX_CONCURRENT) stop(playing[0])
      if (!v.src) {
        var s = v.getAttribute("data-src")
        if (!s) return
        v.src = s
      }
      playing.push(v)
      var p = v.play()
      if (p && p.catch) p.catch(function () { stop(v) })
      v.classList.add("is-playing")
    }

    if (!("IntersectionObserver" in window)) return
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) start(e.target)
          else stop(e.target)
        })
      },
      { rootMargin: "150px" }
    )
    videos.forEach(function (v) { io.observe(v) })

    // 탭이 백그라운드로 가면 모두 멈춘다 (배터리·CPU)
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) playing.slice().forEach(stop)
    })
  })()
</script>

<script is:inline>
  ;(function () {
    var c = document.getElementById("packed")
    if (!c) return
    var grid = c.querySelector(".grid")
    var input = document.getElementById("search")
    var none = document.getElementById("noresult")
    var tiles = Array.prototype.slice.call(grid.querySelectorAll(".tile"))
    var SHARE = 0.4 // hover 시 해당 셀이 차지할 목표 면적 비율
    var proximityRemeasure = null // 근접 반응이 타일 좌표를 다시 재도록 하는 훅

    // 각 셀을 leaf 객체로 (DOM 순서 = 패킹 순서)
    var leaves = tiles.map(function (el) {
      return {
        el: el,
        base: parseFloat(el.getAttribute("data-weight")) || 1,
        w: 0,
        menu: el.hasAttribute("data-menu"),
      }
    })

    function desktop() {
      return window.matchMedia("(min-width: 701px)").matches
    }
    function activeLeaves() {
      return leaves.filter(function (l) {
        return l.el.style.display !== "none"
      })
    }

    // 순서 보존 이분할 트리 구축 (base weight로 절반씩 분할)
    function build(arr) {
      if (arr.length === 1) return { leaf: arr[0] }
      var tot = 0
      arr.forEach(function (l) {
        tot += l.base
      })
      var acc = 0,
        i = 0
      for (i = 0; i < arr.length - 1; i++) {
        acc += arr[i].base
        if (acc >= tot / 2) {
          i++
          break
        }
      }
      if (i < 1) i = 1
      if (i > arr.length - 1) i = arr.length - 1
      return { a: build(arr.slice(0, i)), b: build(arr.slice(i)), dir: null }
    }

    function wsum(n) {
      return n.leaf ? n.leaf.w : wsum(n.a) + wsum(n.b)
    }

    // 현재 weight로 사각형 배치. dir은 최초 1회(base 기준)만 결정해 구조를 고정.
    function place(n, x, y, w, h) {
      if (n.leaf) {
        var s = n.leaf.el.style
        s.left = x + "%"
        s.top = y + "%"
        s.width = w + "%"
        s.height = h + "%"
        return
      }
      if (n.dir === null) n.dir = w >= h ? "h" : "v"
      var wa = wsum(n.a),
        wb = wsum(n.b),
        t = wa + wb || 1
      if (n.dir === "h") {
        var ww = (w * wa) / t
        place(n.a, x, y, ww, h)
        place(n.b, x + ww, y, w - ww, h)
      } else {
        var hh = (h * wa) / t
        place(n.a, x, y, w, hh)
        place(n.b, x, y + hh, w, h - hh)
      }
    }

    var tree = null
    function clearInline() {
      tiles.forEach(function (el) {
        el.style.left = el.style.top = el.style.width = el.style.height = ""
      })
    }
    function rebuild() {
      var a = activeLeaves()
      a.forEach(function (l) {
        l.w = l.base
      })
      tree = a.length ? build(a) : null
      if (tree) place(tree, 0, 0, 100, 100)
    }
    function relayout(hoverLeaf) {
      if (!tree || !desktop()) return
      var a = activeLeaves()
      a.forEach(function (l) {
        l.w = l.base
      })
      if (hoverLeaf && !hoverLeaf.menu) {
        var others = 0
        a.forEach(function (l) {
          if (l !== hoverLeaf) others += l.base
        })
        hoverLeaf.w = (others * SHARE) / (1 - SHARE)
      }
      place(tree, 0, 0, 100, 100)
    }

    // 검색
    function apply() {
      var q = (input && input.value.trim().toLowerCase()) || ""
      var shown = 0
      leaves.forEach(function (l) {
        if (l.menu) return
        var hit = !q || (l.el.getAttribute("data-search") || "").indexOf(q) !== -1
        l.el.style.display = hit ? "" : "none"
        if (hit) shown++
      })
      if (none) none.hidden = shown !== 0
      syncMode()
      if (proximityRemeasure) proximityRemeasure()
    }
    if (input) input.addEventListener("input", apply)
    var searchQuery = new URLSearchParams(window.location.search).get("q")
    if (input && searchQuery) {
      input.value = searchQuery
      apply()
      document.getElementById("works")?.scrollIntoView({ block: "start" })
    }

    // hover-expand
    leaves.forEach(function (l) {
      if (l.menu) return
      l.el.addEventListener("mouseenter", function () {
        relayout(l)
      })
    })
    grid.addEventListener("mouseleave", function () {
      relayout(null)
    })

    /* ---- 데스크톱: 커서 = 센서 ----
       각 타일과 커서의 거리를 0~1로 정규화해 --p로 넣는다. 표현은 CSS가 맡는다.
       레이아웃은 건드리지 않는다(hover-expand와 충돌 방지). */
    ;(function proximity() {
      if (!window.matchMedia("(pointer: fine)").matches) return
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

      var RADIUS = 280 // px — 이 거리부터 반응이 시작된다
      var pTicking = false
      var lastX = 0
      var lastY = 0
      var rects = []

      function measure() {
        rects = tiles
          .filter(function (el) { return el.style.display !== "none" })
          .map(function (el) { return { el: el, r: el.getBoundingClientRect() } })
      }
      // transitionend는 타일·속성마다 발생하므로 프레임당 한 번으로 묶는다
      var mQueued = false
      function measureSoon() {
        if (mQueued) return
        mQueued = true
        requestAnimationFrame(function () {
          mQueued = false
          measure()
        })
      }

      function frame() {
        pTicking = false
        for (var i = 0; i < rects.length; i++) {
          var r = rects[i].r
          // 사각형까지의 최단 거리 (안에 있으면 0)
          var dx = Math.max(r.left - lastX, 0, lastX - r.right)
          var dy = Math.max(r.top - lastY, 0, lastY - r.bottom)
          var d = Math.sqrt(dx * dx + dy * dy)
          var t = Math.max(0, 1 - d / RADIUS)
          rects[i].el.style.setProperty("--p", t.toFixed(3))
        }
      }

      grid.addEventListener("pointermove", function (e) {
        lastX = e.clientX
        lastY = e.clientY
        if (!pTicking) {
          pTicking = true
          requestAnimationFrame(frame)
        }
      })
      grid.addEventListener("pointerleave", function () {
        tiles.forEach(function (el) { el.style.removeProperty("--p") })
      })

      // 타일이 재배치되면(hover-expand·검색 필터·리사이즈) 좌표를 다시 잰다
      measure()
      window.addEventListener("resize", measureSoon)
      window.addEventListener("scroll", measureSoon, { passive: true })
      grid.addEventListener("transitionend", measureSoon)
      proximityRemeasure = measureSoon
    })()

    /* ---- 모바일: 스크롤 포커스 ----
       화면 중앙에 가까운 타일일수록 선명·확대, 벗어날수록 어두워짐.
       리플로우를 피하려고 슬롯 높이는 고정하고 transform/스크림/캡션만 조절. */
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    function clearMobileStyles() {
      tiles.forEach(function (el) {
        var img = el.querySelector("img")
        if (img) {
          img.style.transform = ""
          img.style.filter = ""
        }
        var s = el.querySelector(".scrim")
        if (s) s.style.opacity = ""
        var cap = el.querySelector(".cap")
        if (cap) cap.style.opacity = ""
      })
    }
    function mobileFrame() {
      mTicking = false
      if (desktop()) return
      // Mobile archive uses a compact mosaic rather than the former one-card feed.
      if (window.matchMedia("(max-width: 700px)").matches) return
      var vh = window.innerHeight || 1
      var cy = vh / 2
      tiles.forEach(function (el) {
        if (el.style.display === "none") return
        var r = el.getBoundingClientRect()
        if (r.height === 0) return
        var tc = r.top + r.height / 2
        var rel = (tc - cy) / vh // -0.5(위) ~ 0.5(아래)
        var t = Math.max(0, 1 - Math.abs(tc - cy) / (vh * 0.62)) // 0~1, 중앙=1
        var img = el.querySelector("img")
        if (img) {
          img.style.transform = reduce
            ? ""
            : "translateY(" + rel * -18 + "px) scale(" + (1.06 + t * 0.07) + ")"
          // 중앙일수록 밝게(최대 1.1), 벗어날수록 살짝 어둡게(0.94)
          img.style.filter = "brightness(" + (0.94 + t * 0.16) + ")"
        }
        var s = el.querySelector(".scrim")
        if (s) s.style.opacity = String((1 - t) * 0.72)
        var cap = el.querySelector(".cap")
        if (cap) cap.style.opacity = String(0.15 + t * 0.85)
      })
    }
    var mTicking = false
    function onScroll() {
      if (!mTicking) {
        mTicking = true
        requestAnimationFrame(mobileFrame)
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true })

    function syncMode() {
      rebuild()
      clearMobileStyles()
    }

    var rt
    window.addEventListener("resize", function () {
      clearTimeout(rt)
      rt = setTimeout(syncMode, 150)
    })

    // 초기화: 위치 잡고 → 페이드인 → 전환 활성화
    syncMode()
    requestAnimationFrame(function () {
      c.classList.add("ready")
      requestAnimationFrame(function () {
        c.classList.add("animate")
      })
    })
  })()
</script>

<style>
  #packed {
    position: relative;
    width: 100%;
    height: 100svh;
  }

  /* 직사각형 그리드: 좌측 메뉴 컬럼 + 우측 여백 안쪽, 상하 여백 */
  /* 여백은 좌측 메뉴 컬럼(210px)에 맞추고, 나머지 세 변은 같은 값으로 리듬을 준다.
     이전에는 우 56 / 상하 14로 제각각이라 그리드가 화면에 떠 있는 인상이었다. */
  .grid {
    position: absolute;
    left: 210px;
    right: 24px;
    top: 24px;
    bottom: 24px;
  }

  .tile {
    position: absolute;
    overflow: hidden;
    /* 인접 타일의 border가 만나 실제 거터가 된다 → 4px + 4px = 8px */
    border: 4px solid var(--surface);
    background: var(--surface-2);
    opacity: 0;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  #packed.ready .tile {
    opacity: 1;
  }
  .tile {
    transition: opacity 0.45s ease;
  }
  #packed.animate .tile {
    transition:
      left 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      top 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      width 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      height 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.45s ease;
  }

  /* 작품 셀 */
  .card {
    display: block;
    color: var(--surface);
  }
  .card .thumb,
  .card .ph {
    position: absolute;
    inset: 0;
  }
  /* 무음 루프 영상 — thumb 이미지 위에 겹치고, 재생이 시작되면 페이드인.
     로드 전·실패 시에는 아래의 thumb 이미지가 그대로 보인다(폴백). */
  .card .thumb-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .card .thumb-video.is-playing { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .card .thumb-video { display: none; }
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* 롱프레스가 이미지가 아니라 링크(a)로 전달되게 → iOS 링크 미리보기 팝업 유지.
       동시에 이미지 자체의 드래그(뜯겨 나옴)만 차단. (touch-callout은 끄지 않음) */
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .card .ph {
    background: var(--line);
  }
  /* 근접 반응 — 커서가 다가올수록 --p가 0→1로 오른다 (스크립트가 주입).
     초음파 센서가 거리를 연속값으로 읽는 작업의 문법을 화면에 옮긴 것.
     모바일의 스크롤 포커스와 같은 원리이고, 입력만 커서 거리로 바뀐다. */
  .card .thumb {
    filter: brightness(calc(0.93 + var(--p, 0) * 0.13));
    transition: filter 0.25s ease;
  }
  .card .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 26px 12px 9px;
    font-size: var(--fs-sm);
    line-height: 1.25;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
    /* 가까워지면 서서히 드러나고, 올리면 완전히 나타난다 */
    opacity: calc(var(--p, 0) * 0.85);
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .card:hover .cap {
    opacity: 1;
  }
  /* 근접 반응은 장식이 아니라 정보 접근을 돕는 층이므로, 끄더라도
     호버 시 캡션은 반드시 보여야 한다. */
  @media (prefers-reduced-motion: reduce) {
    .card .thumb { filter: none; transition: none; }
    .card .cap { opacity: 0; }
    .card:hover .cap { opacity: 1; }
  }
  .card .cap .t {
    font-weight: 400;
  }
  /* 방문의 흔적 — 시아노타입(감광지) 인용. 본 작품의 제목 아래에 노출된 자국이 남는다.
     세션 한정이며 서버로 보내지 않는다. */
  .card.is-seen .cap .t {
    box-shadow: inset 0 -1px 0 0 rgba(255, 255, 255, 0.55);
  }
  .card .cap .y {
    font-weight: 300;
    opacity: 0.85;
  }

  /* 스크롤 포커스용 스크림 — 모바일에서만 사용 */
  .scrim {
    display: none;
  }

  /* 메뉴 = 좌상단 고정 오버레이 */

  #noresult {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    text-align: center;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  /* 홈에서는 전역 footer 숨김 (그리드가 화면을 채움) — 이 컴포넌트는 홈 전용 */
  :global(footer) {
    display: none;
  }

  /* 모바일: 데스크톱과 동일한 패킹 구조를 화면 전체로 확장한다. */
  @media (max-width: 700px) {
    /* 트리맵 패킹은 모바일에서도 유지한다.
       다만 화면을 통째로(100svh) 쓰면 타일이 길고 가늘어져 작품이 안 보인다.
       높이를 2/3로 줄이면 같은 폭에 더 납작한 비율이 나와 훨씬 읽힌다. */
    #packed {
      height: 67svh;
      margin: 0;
      width: 100%;
      background: var(--text);
    }
    .grid {
      position: absolute;
      inset: 0;
      display: block;
    }
    .tile {
      position: absolute !important;
      opacity: 1 !important;
      border: 1px solid var(--surface);
      margin: 0;
      overflow: hidden;
      background: var(--text);
    }
    .card {
      display: block;
      color: var(--surface);
    }
    .card .thumb,
    .card .ph {
      position: absolute;
      inset: 0;
    }
    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform-origin: center;
      will-change: transform;
    }
    .card .ph {
      padding-bottom: 0;
      background: var(--text);
    }
    .scrim {
      display: block;
      position: absolute;
      inset: 0;
      background: var(--text);
      opacity: 0.18;
      pointer-events: none;
    }
    .card .cap {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
