---
import BioNav from "./BioNav.astro"

const { data, korean = false } = Astro.props
---

<article class="page">
  <BioNav active="cv" />

  <div class="cv">
    {
      data.sections.map((sec) => (
        <section class="cv-section">
          <h2 class="cv-title">{sec.title}</h2>
          {sec.items.map((it) => (
            <div class="row">
              <div class="year">{it.year}</div>
              <div class="text">{it.text}</div>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</article>

<style>
  .page {
    margin: var(--desktop-header-clearance) 40px 100px var(--desktop-content-x);
    max-width: var(--content-w);
    padding: 0;
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 1.65;
  }
  .cv-section { margin: 0 0 34px; }
  .cv-title {
    font-size: var(--fs-body);
    font-weight: 500;
    margin: 0 0 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--text);
  }
  /* 연도 열은 가장 긴 값이 들어가고도 여백이 남아야 한다.
     110px일 때 "2026 – Present"(글자 폭 120px)가 열을 넘쳐 본문과의
     실제 간격이 6px까지 좁아졌다 — 다른 행은 24~30px였으니 이 줄만
     붙어 보인 게 아니라 실제로 붙어 있었다. nowrap이라 줄바꿈으로
     피하지도 못하고 그대로 밀고 나온다. */
  .row {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 20px;
    padding: 4px 0;
  }
  .year {
    color: var(--text-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 700px) {
    .page { margin: 0; padding: 0 16px 64px; font-size: var(--fs-sm); line-height: 1.65; }
    .cv-section { margin-bottom: 30px; }
    .cv-title { margin-bottom: 8px; padding-bottom: 7px; font-size: var(--fs-body); }
    .row { grid-template-columns: 1fr; gap: 2px; padding: 8px 0 10px; }
    .year { font-size: var(--fs-sm); line-height: 1.4; color: var(--text-3); }
    .text { font-size: var(--fs-sm); line-height: 1.65; }
  }
</style>
