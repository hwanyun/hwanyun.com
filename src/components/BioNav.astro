---
/* Bio 페이지(=/cv, /about)의 머리. Sound·Events·Contact가 쓰는 것과 같은 문법이다:
   eyebrow → 큰 제목 → 얇은 선. Bio만 이 블록이 없어 혼자 다른 페이지처럼 보였다.
   CV/About 탭이 그 선을 이어받아, 제목 아래 한 층으로 붙는다. */
const { active = "about" } = Astro.props
---

<header class="bio-head">
  <p class="eyebrow">BIO</p>
  <h1>Bio</h1>
  {/* "Curriculum vitae and artist's statement"는 이 페이지에 무엇이 들어
      있는지를 말할 뿐 이 사람이 누구인지는 말하지 않는다 — 게다가 바로 아래
      두 탭이 이미 하는 말이다. 작가 노트의 첫 문장으로 바꾼다. */}
  <p class="intro">
    <span data-language-content="en" lang="en">
      Sound, light, material, and the body alter one another. Installations and
      interactive systems built from that exchange.
    </span>
    <span data-language-content="ko" lang="ko">
      소리와 빛, 물질과 신체가 서로의 상태를 바꾼다. 그 주고받음에서 만들어지는
      설치와 인터랙티브 시스템.
    </span>
  </p>

  <nav class="bionav" aria-label="Bio sections">
    <a href="/cv" class={active === "cv" ? "on" : ""} aria-current={active === "cv" ? "page" : undefined}>CV</a>
    <a href="/about" class={active === "about" ? "on" : ""} aria-current={active === "about" ? "page" : undefined}>About</a>
  </nav>
</header>

<style>
  /* 폭은 Sound의 머리와 같게 둔다 — CV(900px)와 About(680px)은 본문 폭이 서로
     다르지만, 머리까지 따라 달라지면 두 페이지가 또 다른 페이지로 읽힌다. */
  .bio-head {
    max-width: 650px;
    margin: 0 0 84px;
  }
  .eyebrow {
    margin: 0;
    font-size: var(--fs-2xs);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  h1 {
    margin: 8px 0 16px;
    font-weight: 300;
    font-size: var(--fs-display);
    line-height: 1.15;
  }
  .intro {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--text);
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--text-2);
  }
  .bionav {
    display: flex;
    gap: 18px;
    margin: 26px 0 0;
    font-size: var(--fs-sm);
  }
  .bionav a { color: var(--text); }
  .bionav a:hover { border-bottom: 1px solid var(--hover); }
  .bionav a.on { border-bottom: 1px solid var(--text); }

  @media (max-width: 700px) {
    .bio-head { margin-bottom: 54px; }
    h1 { font-size: clamp(25px, 7vw, 32px); line-height: 1.22; }
    .intro { font-size: var(--fs-sm); line-height: 1.78; }
    .bionav { margin-top: 22px; }
  }
</style>
