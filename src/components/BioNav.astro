---
/* Bio 페이지(=/cv, /about)의 머리. Sound·Events·Contact가 쓰는 것과 같은 문법이다:
   eyebrow → 큰 제목 → 얇은 선. Bio만 이 블록이 없어 혼자 다른 페이지처럼 보였다.
   CV/About 탭이 그 선을 이어받아, 제목 아래 한 층으로 붙는다. */
const { active = "about" } = Astro.props
---

<header class="bio-head">
  <p class="eyebrow">BIO</p>
  <h1>Bio</h1>
  <p class="intro">Curriculum vitae and artist's statement.</p>

  <nav class="bionav" aria-label="Bio sections">
    <a href="/cv" class={active === "cv" ? "on" : ""} aria-current={active === "cv" ? "page" : undefined}>CV</a>
    <a href="/about" class={active === "about" ? "on" : ""} aria-current={active === "about" ? "page" : undefined}>About</a>
  </nav>
</header>

<style>
  /* 폭은 Sound의 머리와 같게 둔다 — CV(900px)와 About(680px)은 본문 폭이 서로
     다르지만, 머리까지 따라 달라지면 두 페이지가 또 다른 페이지로 읽힌다. */
  .bio-head {
    max-width: 650px;
    margin: 0 0 84px;
  }
  .eyebrow {
    margin: 0;
    font-size: var(--fs-2xs);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  h1 {
    margin: 8px 0 16px;
    font-weight: 300;
    font-size: var(--fs-display);
    line-height: 1.15;
  }
  .intro {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--text);
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--text-2);
  }
  .bionav {
    display: flex;
    gap: 18px;
    margin: 26px 0 0;
    font-size: var(--fs-sm);
  }
  .bionav a { color: var(--text); }
  .bionav a:hover { border-bottom: 1px solid var(--hover); }
  .bionav a.on { border-bottom: 1px solid var(--text); }

  @media (max-width: 700px) {
    .bio-head { margin-bottom: 54px; }
    h1 { font-size: clamp(25px, 7vw, 32px); line-height: 1.22; }
    .intro { font-size: var(--fs-sm); line-height: 1.78; }
    .bionav { margin-top: 22px; }
  }
</style>
